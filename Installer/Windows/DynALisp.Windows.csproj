<!--
  DynALisp.Windows - the windows of DynALisp (WPF), shown from Lisp with (Dyl:Window file values).

    dotnet build Installer\Windows -c Release

  Builds the same code twice, both committed and loaded by PackageContents.xml, as
  DynALisp.Startup:
    - net8.0-windows: Contents\Resources\DynALisp.Windows.dll, AutoCAD 2025 and 2026 (.NET 8),
      with the references of AutoCAD 2025;
    - net10.0-windows: Contents\Resources\Net10\DynALisp.Windows.dll, AutoCAD 2027 and later
      (.NET 10), with the references of AutoCAD 2027: AutoCAD 2027 is not binary compatible
      with 2025 and 2026.
  Close AutoCAD first: it keeps the DLLs open. Needs the .NET 10 SDK, which builds both (on Linux, add
  -p:EnableWindowsTargeting=true).

  Engine\ holds the code that shows a window (no AutoCAD in it), also compiled by the
  pictures tool of the docs (Shots\, which renders the windows without AutoCAD);
  Bridge.cs is the Lisp side (the Lisp function, AutoCAD). The windows themselves are the
  .xaml files of the Res folders of the modules, read when they are shown.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>DynALisp.Windows</AssemblyName>
    <RootNamespace>DynALisp.Windows</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Samuel Martineau</Company>
    <Product>DynALisp</Product>
    <Copyright>Copyright (C) 2026 Samuel Martineau, GNU General Public License v3</Copyright>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- The pictures tool is a project of its own: -->
  <ItemGroup>
    <Compile Remove="Shots\**" />
    <None Remove="Shots\**" />
    <Page Remove="Shots\**" />
    <!-- The styles of the windows, read at run time (not compiled XAML): -->
    <Page Remove="Engine\Theme.xaml" />
    <EmbeddedResource Include="Engine\Theme.xaml" LogicalName="DynALisp.Windows.Theme.xaml" />
  </ItemGroup>

  <!-- Compile only: AutoCAD gives its own assemblies at run time. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- The windows that read the data (the Assembly Presets, AsmPresets.cs) use DynALisp.Core.dll,
       loaded by AutoCAD beside this DLL (never copied with it): -->
  <ItemGroup>
    <ProjectReference Include="..\Core\DynALisp.Core.csproj" Private="false" />
  </ItemGroup>

  <!-- The DLLs go where PackageContents.xml loads them: -->
  <Target Name="CopyToResources" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <ResourcesDir>$(MSBuildThisFileDirectory)..\..\Contents\Resources</ResourcesDir>
      <ResourcesDir Condition="'$(TargetFramework)' == 'net10.0-windows'">$(ResourcesDir)\Net10</ResourcesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResourcesDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) ($(TargetFramework)) to $(ResourcesDir)" />
  </Target>

</Project>
