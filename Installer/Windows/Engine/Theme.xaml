<!--
  Theme.xaml - DynALisp.Windows: the look of every DynALisp window (embedded in the DLL, read
  at run time by Theme.cs and merged into the resources of each window).

  The colours are the Dyl.* brushes (the ones of the docs website, docs.css, and the teal of
  the logo for the default button). A window file uses the keyed styles with
  {DynamicResource ...}: Dyl.Desc (the grey description under a setting or a section),
  Dyl.Label (the label of a value), Dyl.Error (the text named "error"), Dyl.OpenButton (set
  by OpenButton itself). GroupBox, Button, CheckBox, ComboBox and TextBox take theirs on
  their own. Windows are minimal (Windows convention): no colour or box that does not say
  something.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Dyl.Back" Color="#F4F6F9"/>
  <SolidColorBrush x:Key="Dyl.Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dyl.Border" Color="#E3E8EF"/>
  <SolidColorBrush x:Key="Dyl.BorderStrong" Color="#C5CDD8"/>
  <SolidColorBrush x:Key="Dyl.Text" Color="#1F2937"/>
  <SolidColorBrush x:Key="Dyl.Heading" Color="#0F172A"/>
  <SolidColorBrush x:Key="Dyl.Muted" Color="#5B6577"/>
  <SolidColorBrush x:Key="Dyl.Disabled" Color="#A6AEBB"/>
  <SolidColorBrush x:Key="Dyl.Hover" Color="#EEF2F6"/>
  <SolidColorBrush x:Key="Dyl.Pressed" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="Dyl.Accent" Color="#178C8C"/>
  <SolidColorBrush x:Key="Dyl.AccentHover" Color="#127373"/>
  <SolidColorBrush x:Key="Dyl.AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dyl.ErrorText" Color="#B42318"/>

  <!-- A section: a white card, its title above its content (the boxed_column of DCL): -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Padding" Value="14,10,14,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{DynamicResource Dyl.Surface}" BorderBrush="{DynamicResource Dyl.Border}"
                  BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True"
                                Margin="14,11,14,0" TextElement.FontWeight="SemiBold" TextElement.FontSize="13"
                                TextElement.Foreground="{DynamicResource Dyl.Heading}"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Dyl.Desc" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style x:Key="Dyl.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <Style x:Key="Dyl.Error" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.ErrorText}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,3"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="5,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Dyl.BorderStrong}"/>
  </Style>

  <!-- The buttons of the window (Save, Cancel, Open Docs...), the default one in teal: -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Dyl.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Dyl.BorderStrong}"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="14,4"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentText}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsDefault" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.AccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Surface}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Border}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The square open button (OpenButton.cs), one line high: -->
  <Style x:Key="Dyl.OpenButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Dyl.BorderStrong}"
                  BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Border}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
