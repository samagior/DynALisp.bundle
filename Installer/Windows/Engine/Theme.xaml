<!--
  Theme.xaml - DynALisp.Windows: the look of every DynALisp window (embedded in the DLL, read
  at run time by Theme.cs and merged into the resources of each window).

  The colours are the Dyl.* brushes, given by Theme.cs in the light or the dark theme of
  AutoCAD (COLORTHEME), the blue of AutoCAD for the default button and the switches on;
  never a colour written here or in a window file. A window file uses the keyed styles with
  {DynamicResource ...}: Dyl.Desc (the grey description under a setting or a section),
  Dyl.Label (the label of a value), Dyl.Sub (the title of a sub-section), Dyl.Error (the text
  named "error"), Dyl.OpenButton (set by OpenButton itself), Dyl.Tile (set by Gallery
  itself), Dyl.Chip (the items of a list of names), Dyl.Search (a search box), Dyl.Pill (a
  group of a gallery, set by Gallery itself, and Dyl.PillSmall its methods), Dyl.Note,
  Dyl.NoteVersion, Dyl.NoteTitle and Dyl.NotePicture (the changes of What's New), Dyl.Link (a
  Hyperlink). A TextBox
  shows its Tag as a hint while it is empty. GroupBox, Button, CheckBox, ComboBox, ListBox
  and TextBox take theirs on their own.
  Windows are minimal (Windows convention): no colour or box that does not say something.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


  <!-- A section: a card without border, its title above its content (the boxed_column of DCL): -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Padding" Value="16,6,16,14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{DynamicResource Dyl.Surface}" CornerRadius="8" SnapsToDevicePixels="True">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True"
                                Margin="16,14,16,0" TextElement.FontWeight="SemiBold" TextElement.FontSize="14"
                                TextElement.Foreground="{DynamicResource Dyl.Heading}"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Dyl.Desc" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style x:Key="Dyl.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The title of a sub-section of a card (Bands, Layer key overrides), over its values: -->
  <Style x:Key="Dyl.Sub" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,10,0,4"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Dyl.Error" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.ErrorText}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- An on/off setting: a switch (as the settings of Windows 11), its label after it. A switch
       without a label (the grid of Output Prep) takes no room for one: -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="track" Width="36" Height="18" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                    Background="Transparent" BorderBrush="{DynamicResource Dyl.Muted}" SnapsToDevicePixels="True">
              <Ellipse x:Name="knob" Width="10" Height="10" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource Dyl.Muted}"/>
            </Border>
            <ContentPresenter x:Name="cp" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Dyl.Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              <Setter TargetName="knob" Property="Width" Value="12"/>
              <Setter TargetName="knob" Property="Height" Value="12"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Dyl.AccentText}"/>
            </Trigger>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="cp" Property="Margin" Value="0"/>
            </Trigger>
            <!-- Greyed out: drawn as a switch turned off, whatever its value (kept for when it is
                 enabled again), so a setting that is not used never looks on: -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="track" Property="Background" Value="Transparent"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Left"/>
              <Setter TargetName="knob" Property="Margin" Value="3,0,0,0"/>
              <Setter TargetName="knob" Property="Width" Value="10"/>
              <Setter TargetName="knob" Property="Height" Value="10"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A small square box, for a checkbox in the rows of a list (the Load-bearing, Variable
       thickness and Low permeance columns of the layers of an assembly), where a switch on
       every row would be too heavy; greyed out, its border and its mark fade: -->
  <Style x:Key="Dyl.Check" TargetType="CheckBox">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="box" Width="14" Height="14" CornerRadius="3" BorderThickness="1" Background="Transparent"
                  BorderBrush="{DynamicResource Dyl.Muted}" SnapsToDevicePixels="True">
            <Path x:Name="mark" Data="M 2.5,6.5 L 5.5,9.5 L 10.5,3.5" Stroke="{DynamicResource Dyl.AccentText}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Dyl.Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="box" Property="Background" Value="Transparent"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="mark" Property="Stroke" Value="{DynamicResource Dyl.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A list: a box as the text boxes, its items in a card under it: -->
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="8,4,26,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{DynamicResource Dyl.Input}" BorderBrush="{DynamicResource Dyl.InputBorder}"
                          BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0"
                          Stroke="{DynamicResource Dyl.Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource Dyl.Surface}" BorderBrush="{DynamicResource Dyl.InputBorder}" BorderThickness="1"
                      CornerRadius="4" Margin="0,2,0,0" Padding="0,3"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3,0" CornerRadius="3">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Dyl.Accent}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{DynamicResource Dyl.Input}" BorderBrush="{DynamicResource Dyl.InputBorder}"
                  BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <!-- The hint of an empty box (its Tag: "Search presets"): -->
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A list (the presets of a preset window): no box of its own, it sits in its card; its
       items a line each, rounded, the ones selected in a darker tone: -->
  <Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="0,0,4,0">
            <ItemsPresenter/>
          </ScrollViewer>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An item of a list of names (the aliases of a preset): a chip, blue when it is picked
       (the ItemContainerStyle of its list, its items in a WrapPanel): -->
  <Style x:Key="Dyl.Chip" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="{DynamicResource Dyl.ButtonBack}" BorderBrush="{DynamicResource Dyl.Border}"
                  BorderThickness="1" CornerRadius="12" Padding="10,3" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An item of a list that is read, not picked (the changes of What's New, the
       ItemContainerStyle of its list): no hover, no selection, the text at the left: -->
  <Style x:Key="Dyl.Note" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="2,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Its parts: the heading of a version, the title of a change, its picture: -->
  <Style x:Key="Dyl.NoteVersion" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,4,0,8"/>
  </Style>

  <Style x:Key="Dyl.NoteTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Heading}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Dyl.NotePicture" TargetType="Image">
    <Setter Property="MaxWidth" Value="700"/>
    <Setter Property="MaxHeight" Value="340"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StretchDirection" Value="DownOnly"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
  </Style>

  <!-- A link (a Hyperlink: the docs page of a change of What's New), in the blue of AutoCAD,
       underlined under the mouse: -->
  <Style x:Key="Dyl.Link" TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Accent}"/>
    <Setter Property="TextDecorations" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentHover}"/>
        <Setter Property="TextDecorations" Value="Underline"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A search box: a TextBox with a magnifier before its text (the Filter of a list, the
       search of a gallery), its hint its Tag: -->
  <Style x:Key="Dyl.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="28,3,6,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{DynamicResource Dyl.Input}" BorderBrush="{DynamicResource Dyl.InputBorder}"
                  BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <Path Data="M 6,0 A 6,6 0 1 1 5.99,0 Z M 10.3,10.3 L 15,15" Stroke="{DynamicResource Dyl.Muted}" StrokeThickness="1.6"
                    Width="16" Height="16" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A pill of a gallery (Gallery.cs, its Pills): one group shown at a time, the one picked
       filled with the blue of AutoCAD: -->
  <Style x:Key="Dyl.Pill" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="14,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{DynamicResource Dyl.Surface}" BorderBrush="Transparent" BorderThickness="1.5"
                  CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A smaller pill (the methods of the preset selected in a gallery), so they fit in a row: -->
  <Style x:Key="Dyl.PillSmall" TargetType="RadioButton" BasedOn="{StaticResource Dyl.Pill}">
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- A tile of a gallery (Gallery.cs): a card, its border blue under the mouse, and blue and
       its card tinted while it is selected (its Tag "sel"): -->
  <Style x:Key="Dyl.Tile" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Dyl.Surface}"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.5"
                  CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="Tag" Value="sel">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A scroll bar standing (a list, a gallery): a thin rounded thumb, no arrows: -->
  <Style TargetType="ScrollBar">
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="th" Width="6" CornerRadius="3" Background="{DynamicResource Dyl.BorderStrong}"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource Dyl.Muted}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The buttons of the window (Save, Cancel, Open Docs...), the default one in teal: -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Dyl.ButtonBack}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Dyl.BorderStrong}"/>
    <Setter Property="MinWidth" Value="92"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="16,4"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Accent}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentText}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsDefault" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.AccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Surface}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Border}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A line of a list that is clicked (the templates of the Start page): flat, its
       background under the mouse: -->
  <Style x:Key="Dyl.Row" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A button in teal that is not the default one of its window (New of the Start page, whose
       Enter belongs to its search box): -->
  <Style x:Key="Dyl.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.AccentText}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource Dyl.Accent}" BorderBrush="{DynamicResource Dyl.Accent}"
                  BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Surface}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dyl.Border}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The open button (OpenButton.cs), one line high: its icon alone, a square under it on hover: -->
  <Style x:Key="Dyl.OpenButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Dyl.BorderStrong}"
                  BorderThickness="0" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dyl.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Dyl.Disabled}"/>
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A sketch of a choice (the ends and corners of Quick Draw), drawn in the window file as the
       sketches of its docs page: a Dyl.Sketch box, holding a Grid of the size of the drawing in a
       Viewbox, one Canvas per item shown by a rule (dyl:Win.VisibleBy="men=Round"). Its paths:
       Dyl.Sketch.Outline the border, Dyl.Sketch.Center the line drawn (dashed, in the accent),
       Dyl.Sketch.Ghost what is not drawn (dashed), Dyl.Sketch.Dim a dimension, Dyl.Sketch.Point
       a point picked, Dyl.Sketch.HatchA and HatchB the hatches (Dyl.HatchA, Dyl.HatchB of
       Theme.Brushes); Dyl.Sketch.Text the text of a dimension. A dash is in widths of its line. -->
  <Style x:Key="Dyl.Sketch" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Dyl.Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Dyl.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Height" Value="132"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Margin" Value="0,6,0,6"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Outline" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Dyl.Heading}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineJoin" Value="Miter"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Center" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Dyl.Accent}"/>
    <Setter Property="StrokeThickness" Value="1.2"/>
    <Setter Property="StrokeDashArray" Value="7.5 3.3 1.7 3.3"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Ghost" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="StrokeDashArray" Value="4 3"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Dim" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="StrokeThickness" Value="0.9"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Point" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource Dyl.Accent}"/>
  </Style>
  <Style x:Key="Dyl.Sketch.HatchA" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource Dyl.HatchA}"/>
  </Style>
  <Style x:Key="Dyl.Sketch.HatchB" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource Dyl.HatchB}"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style x:Key="Dyl.Sketch.Ask" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>
