<!--
  DynALisp.Core - the core of DynALisp in .NET: the data files read once per session and shared
  by every drawing, given to the Lisp side by (Dyl:Data ...).

    dotnet build Installer\Core -c Release

  Builds the same code twice, both committed and loaded by PackageContents.xml, as
  DynALisp.Startup:
    - net8.0-windows: Contents\Resources\DynALisp.Core.dll, AutoCAD 2025 and 2026 (.NET 8),
      with the references of AutoCAD 2025;
    - net10.0-windows: Contents\Resources\Net10\DynALisp.Core.dll, AutoCAD 2027 and later
      (.NET 10), with the references of AutoCAD 2027: AutoCAD 2027 is not binary compatible
      with 2025 and 2026.
  Close AutoCAD first: it keeps the DLLs open. Needs the .NET 10 SDK, which builds both; it has
  no WPF, so it builds on Linux too (EnableWindowsTargeting).

  Data\ is the reading of the files, without AutoCAD (a library of its own, tested by Tests\):
  its files are compiled into this DLL, so the plugin is one file.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>DynALisp.Core</AssemblyName>
    <RootNamespace>DynALisp.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Samuel Martineau</Company>
    <Product>DynALisp</Product>
    <Copyright>Copyright (C) 2026 Samuel Martineau, GNU General Public License v3</Copyright>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The library and its tests are projects of their own; only the code of the library is
       compiled here: -->
  <ItemGroup>
    <Compile Remove="Tests\**;Data\bin\**;Data\obj\**" />
    <None Remove="Tests\**;Data\bin\**;Data\obj\**" />
  </ItemGroup>

  <!-- Compile only: AutoCAD gives its own assemblies at run time. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- The DLLs go where PackageContents.xml loads them: -->
  <Target Name="CopyToResources" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <ResourcesDir>$(MSBuildThisFileDirectory)..\..\Contents\Resources</ResourcesDir>
      <ResourcesDir Condition="'$(TargetFramework)' == 'net10.0-windows'">$(ResourcesDir)\Net10</ResourcesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResourcesDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) ($(TargetFramework)) to $(ResourcesDir)" />
  </Target>

</Project>
