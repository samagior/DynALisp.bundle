<!--
  DynALisp.Simulation - the simulation of a 2D detail (Dyl-Simulation): reads the detail in the
  drawing, and shows its grid, its problems and later its results over it.

    dotnet build Installer\Simulation -c Release

  Builds the same code twice, both committed and loaded by PackageContents.xml, as
  DynALisp.Startup:
    - net8.0-windows: Contents\Resources\DynALisp.Simulation.dll, AutoCAD 2025 and later
      (.NET 8), with the references of AutoCAD 2025;
    - net48: Contents\Resources\Net48\DynALisp.Simulation.dll, AutoCAD 2015 to 2024 (.NET
      Framework), with the references of AutoCAD 2015.
  Close AutoCAD first: it keeps the DLLs open. Needs the .NET 8 SDK; it has no WPF, so it
  builds on Linux too (EnableWindowsTargeting).

  Core\ is the calculation, without AutoCAD (a library of its own, tested by Tests\): its files
  are compiled into this DLL, so the plugin is one file.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>DynALisp.Simulation</AssemblyName>
    <RootNamespace>DynALisp.Simulation</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Samuel Martineau</Company>
    <Product>DynALisp</Product>
    <Copyright>Copyright (C) 2026 Samuel Martineau, GNU General Public License v3</Copyright>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The library and its tests are projects of their own; only the code of the library is
       compiled here: -->
  <ItemGroup>
    <Compile Remove="Tests\**;Core\bin\**;Core\obj\**" />
    <None Remove="Tests\**;Core\bin\**;Core\obj\**" />
  </ItemGroup>

  <!-- Compile only: AutoCAD gives its own assemblies at run time. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="20.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The DLLs go where PackageContents.xml loads them: -->
  <Target Name="CopyToResources" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <ResourcesDir>$(MSBuildThisFileDirectory)..\..\Contents\Resources</ResourcesDir>
      <ResourcesDir Condition="'$(TargetFramework)' == 'net48'">$(ResourcesDir)\Net48</ResourcesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResourcesDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) ($(TargetFramework)) to $(ResourcesDir)" />
  </Target>

</Project>
