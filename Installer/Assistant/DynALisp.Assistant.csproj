<!--
  DynALisp.Assistant - the Assistant palette of DynALisp (Dyl-Assistant) and the one-shot
  requests of the other tools ((Dyl:ClaudeRun ...)), both through Claude Code, the command
  line of Anthropic, installed and signed in by the user (their own Claude account).

    dotnet build Installer\Assistant -c Release

  Builds the same code twice, both committed and loaded by PackageContents.xml:
    - net8.0-windows: Contents\Resources\DynALisp.Assistant.dll, AutoCAD 2025 and later
      (.NET 8), with the references of AutoCAD 2025;
    - net48: Contents\Resources\Net48\DynALisp.Assistant.dll, AutoCAD 2016 to 2024 (.NET
      Framework), with the references of AutoCAD 2016: the Assistant needs AutoCAD 2016
      (ExecuteInCommandContextAsync, for the changes it will make to the drawing), while
      the rest of DynALisp loads in AutoCAD 2015.
  Close AutoCAD first: it keeps the DLLs open. Needs the .NET 8 SDK (on Linux, add
  -p:EnableWindowsTargeting=true).

  Plugin.cs is the Lisp side (the Lisp functions), Cli.cs finds and runs Claude Code,
  Chat.cs drives the conversation of the palette, Palette.cs is the palette itself (built in
  code: a conversation is not a window file of Res), Json.cs reads and writes its messages.
  Server.cs is the MCP server of the tools of the drawing (local HTTP, a token), Tools.cs
  lists them and reads the drawing, Writes.cs changes it once the user approves, Host.cs
  runs them on the thread of AutoCAD, each change in one undo group.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>DynALisp.Assistant</AssemblyName>
    <RootNamespace>DynALisp.Assistant</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Samuel Martineau</Company>
    <Product>DynALisp</Product>
    <Copyright>Copyright (C) 2026 Samuel Martineau, GNU General Public License v3</Copyright>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Compile only: AutoCAD gives its own assemblies at run time. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="20.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- The DLLs go where PackageContents.xml loads them: -->
  <Target Name="CopyToResources" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != ''">
    <PropertyGroup>
      <ResourcesDir>$(MSBuildThisFileDirectory)..\..\Contents\Resources</ResourcesDir>
      <ResourcesDir Condition="'$(TargetFramework)' == 'net48'">$(ResourcesDir)\Net48</ResourcesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResourcesDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) ($(TargetFramework)) to $(ResourcesDir)" />
  </Target>

</Project>
