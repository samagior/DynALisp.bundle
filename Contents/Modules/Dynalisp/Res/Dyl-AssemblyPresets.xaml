  Opened by the open button of Assembly in the Quick Draw window (it closes with 5,
  the Lisp shows this one: Dyl:QuickDrawLayersDialog of Apps\Draw\Dyl-QuickDraw.lsp), on the
  layers of the preset shown. A list of rows edited in the window (Installer\Windows\Engine  Rows.cs): ll/rows, a row per layer, its columns: 0 the kind (P Hatch, S Space, L Line), 1
  the Quick Draw preset of a Hatch layer (its id), 2 the thickness of a Hatch or a Space, 3
  the hatch layer key of a Hatch layer ("": the key of its preset), 4 the layer key of a Line;
  a Hatch layer: 5 its own band settings on ("1"), 6 to 13 those settings (hatch aligned to,
  ends, extension, angle, corners, miter limit, lap, joints: edited in the Band Settings
  window, opened by lbe on the layers selected), 14 its own border on, 15 the layer key of
  that border, 16 Structural ("1": the structural layer, one at most: the window clears it in
  the others, dyl:Win.Exclusive). lj is the justification of the assembly (the line drawn,
  that of the preset: Structural layer puts it in the middle of the structural layer). Every
  column is kept in every row, so a layer turned into another kind and
  back gets its values again; the Lisp keeps those of its kind. Add, Remove, Move up, Move
  down and Flip run in the window; OK gives the layers to every preset selected. The preview
  (an AssemblyTile, Installer\Windows\Engine\Assembly.cs) draws the rows as they are edited:
  lp/specs the preview of each preset, ll/ends the ends of the whole band, ll/paper the
  inches of a drawing unit and the drawing scale, and the line drawn where lj puts it.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Assembly Layers" dyl:Win.Docs="Draw\Dyl-AssemblyPresets.htm">
  <Window.Resources>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="580"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="380"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The layers, from the left border of the band (Flip: the other way): -->
    <GroupBox Header="Layers" Margin="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,0,10,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Kind"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Preset"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" HorizontalAlignment="Right" Text="Thickness"/>
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button x:Name="la" DockPanel.Dock="Left" Margin="0" Content="Add" dyl:Win.Do="add"/>
          <Button x:Name="ld" DockPanel.Dock="Left" Content="Remove" dyl:Win.Do="remove"/>
          <Button x:Name="lf" DockPanel.Dock="Right" Content="Flip" dyl:Win.Do="flip"/>
          <Button x:Name="lv" DockPanel.Dock="Right" Content="Move down" dyl:Win.Do="down"/>
          <Button x:Name="lu" DockPanel.Dock="Right" Content="Move up" dyl:Win.Do="up"/>
          <Border/>
        </DockPanel>
        <TextBlock x:Name="lt" DockPanel.Dock="Bottom" Style="{DynamicResource Dyl.Desc}" Margin="6,8,0,0"
                   dyl:Win.Summary="{}{count:lk!=L|layer|layers}, {count:lk=L|line|lines}, width {sum:2:lk!=L}"
                   dyl:Win.SummaryEmpty="No layers."/>
        <!-- Ctrl / Shift click: several layers edited at once: -->
        <ListBox x:Name="ll" Height="280" dyl:Win.Rows="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [0]}"/>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                  <TextBlock x:Name="pre" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding [1], Mode=OneWay}"/><Run x:Name="hk" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding V[3], Mode=OneWay, StringFormat='{}  [{0}]'}"/><Run x:Name="sr" Foreground="{DynamicResource Dyl.Accent}" Text=""/>
                  </TextBlock>
                  <TextBlock x:Name="key" Visibility="Collapsed" Text="{Binding [4]}" TextTrimming="CharacterEllipsis"/>
                  <!-- Its own band settings (its ends, its corners) and its own border: -->
                  <TextBlock x:Name="own" Foreground="{DynamicResource Dyl.Muted}" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run x:Name="bd" Text="{Binding V[7], Mode=OneWay}"/><Run x:Name="bc" Text="{Binding V[10], Mode=OneWay, StringFormat='{}, {0}'}"/><Run x:Name="bk" Text="{Binding V[15], Mode=OneWay, StringFormat='{}  |  Border {0}'}"/>
                  </TextBlock>
                </StackPanel>
                <TextBlock x:Name="thk" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding V[2]}"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding V[5]}" Value="0">
                  <Setter TargetName="bd" Property="Text" Value=""/>
                  <Setter TargetName="bc" Property="Text" Value=""/>
                  <Setter TargetName="bk" Property="Text" Value="{Binding V[15], Mode=OneWay, StringFormat='Border {0}'}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding V[14]}" Value="0">
                  <Setter TargetName="bk" Property="Text" Value=""/>
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding V[5]}" Value="0"/>
                    <Condition Binding="{Binding V[14]}" Value="0"/>
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="own" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding V[3]}" Value="">
                  <Setter TargetName="hk" Property="Text" Value=""/>
                </DataTrigger>
                <DataTrigger Binding="{Binding V[16]}" Value="1">
                  <Setter TargetName="sr" Property="Text" Value="  Structural"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding V[0]}" Value="S">
                  <Setter TargetName="pre" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="own" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding V[0]}" Value="L">
                  <Setter TargetName="pre" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="own" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="key" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="thk" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </GroupBox>

    <StackPanel Grid.Column="2">
    <!-- The layer shown (the first one selected); with none selected, the layer Add adds: -->
    <GroupBox Header="Layer" Margin="0" dyl:Win.Summary="Layer{sel| (# selected)}">
      <StackPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="lk" DockPanel.Dock="Right" Width="220" dyl:Win.Column="0"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Kind"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=P">
          <ComboBox x:Name="lp" DockPanel.Dock="Right" Width="220" dyl:Win.Column="1"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Preset"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=P">
          <ComboBox x:Name="lh" DockPanel.Dock="Right" Width="220" dyl:Win.Column="3"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Hatch layer key"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk!=L">
          <TextBox x:Name="lw" DockPanel.Dock="Right" Width="220" dyl:Win.Column="2" dyl:Win.Follows="lp/widths"
                   dyl:Win.Check="positive" dyl:Win.CheckMessage="The thickness must be a number greater than 0."/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Thickness"/>
        </DockPanel>
        <!-- The structural layer, the line of the band on its middle (Structural layer): -->
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=P">
          <CheckBox x:Name="lsr" Content="Structural" dyl:Win.Column="16" dyl:Win.Exclusive="1"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=L">
          <ComboBox x:Name="ly" DockPanel.Dock="Right" Width="220" dyl:Win.Column="4"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Line layer key"/>
        </DockPanel>
        <!-- A Hatch layer: its own band settings (the Band Settings window on the layers
             selected), its own border on its layer key: -->
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=P">
          <dyl:OpenButton x:Name="lbe" DockPanel.Dock="Right" ToolTip="Band Settings" dyl:Win.EnabledBy="lbs"
                          dyl:Win.Open="Dyl-QuickDrawBandSettings.xaml"
                          dyl:Win.Columns="mht:6,men:7,mex:8,mea:9,mco:10,mml:11,mlt:12,mjo:13"/>
          <CheckBox x:Name="lbs" Content="Custom band settings" dyl:Win.Column="5"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="lk=P">
          <ComboBox x:Name="lbk" DockPanel.Dock="Right" Width="220" dyl:Win.Column="15" dyl:Win.EnabledBy="lbr"/>
          <CheckBox x:Name="lbr" Content="Border" dyl:Win.Column="14"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <!-- The whole assembly: where the line drawn is (the Justification of the preset): -->
    <GroupBox Header="Assembly" Margin="0,10,0,0">
      <DockPanel Style="{StaticResource Row}">
        <ComboBox x:Name="lj" DockPanel.Dock="Right" Width="220"/>
        <TextBlock Style="{DynamicResource Dyl.Label}" Text="Justification"/>
      </DockPanel>
    </GroupBox>
    </StackPanel>

    <!-- The assembly as it is drawn, a wall in plan, built as the layers are edited: -->
    <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="Preview" Margin="0,10,0,0">
      <dyl:AssemblyTile Height="150" Radius="6" Rows="ll" Columns="0 1 2 5 7 8 9 14 6 16" Line="lj" Specs="lp/specs" Ends="ll/ends" Paper="ll/paper"
                        Ink="{DynamicResource Dyl.Text}" Fill="{DynamicResource Dyl.Input}" LabelBack="{DynamicResource Dyl.Surface}"
                        Accent="{DynamicResource Dyl.Accent}"/>
    </GroupBox>

    <TextBlock x:Name="error" Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </Grid>
</Window>
