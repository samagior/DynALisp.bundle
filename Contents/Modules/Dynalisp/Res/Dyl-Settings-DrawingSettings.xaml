  Opened over the Settings window by the open button of Drawing Settings (dyl:Win.Open of
  Dyl-Settings.xaml), on its values: OK keeps them, saved with the other settings by Save.
  The lists of the unit (u) and grid (g) presets of the imperial (im) and metric (mt)
  drawings, first item: not checked (Dyl:SetWinVals). The Shrinkwrap gap step
  (Remote\Dyl-Shrinkwrap.lsp, DynalispShrinkGapImperial / Metric): when no outline is found,
  the gap tolerance is made larger by this step, up to 10 times; a number greater than 0.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Drawing Settings" dyl:Win.Docs="Core\Dyl-Settings.htm">
  <StackPanel Margin="16,16,16,14" Width="640">
    <GroupBox Header="Drawing Settings">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="4" Style="{DynamicResource Dyl.Desc}" Text="Checked in every drawing: one that differs is set to its default."/>
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Dyl.Label}" Margin="0,4,0,6" FontWeight="SemiBold" Text="Imperial drawings"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Style="{DynamicResource Dyl.Label}" Margin="0,4,0,6" FontWeight="SemiBold" Text="Metric drawings"/>
        <TextBlock Grid.Row="2" Style="{DynamicResource Dyl.Label}" Text="Units"/>
        <ComboBox x:Name="uim" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"/>
        <ComboBox x:Name="umt" Grid.Row="2" Grid.Column="3" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="3" Style="{DynamicResource Dyl.Label}" Text="Grid"/>
        <ComboBox x:Name="gim" Grid.Row="3" Grid.Column="1"/>
        <ComboBox x:Name="gmt" Grid.Row="3" Grid.Column="3"/>
      </Grid>
    </GroupBox>
    <GroupBox Header="Shrinkwrap gap step" Margin="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="4" Style="{DynamicResource Dyl.Desc}" Text="Tried when no outline is found."/>
        <TextBlock Grid.Row="1" Style="{DynamicResource Dyl.Label}" Text="Step"/>
        <TextBox x:Name="gpi" Grid.Row="1" Grid.Column="1" dyl:Win.Check="positive" dyl:Win.CheckMessage="A gap step is a number greater than 0 (drawing units)."/>
        <TextBox x:Name="gpm" Grid.Row="1" Grid.Column="3" dyl:Win.Check="positive" dyl:Win.CheckMessage="A gap step is a number greater than 0 (drawing units)."/>
      </Grid>
    </GroupBox>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" Visibility="Collapsed"/>
    <DockPanel Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
      <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="2,0,0,0" VerticalAlignment="Center" Text="Saved when Settings is saved."/>
    </DockPanel>
  </StackPanel>
</Window>
