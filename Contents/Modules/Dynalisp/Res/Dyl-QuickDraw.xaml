  Shown by DynALisp.Windows.dll (Installer\Windows) through the preset engine
  (Remote>>Dyl:PresetWin of Remote\Dyl-Presets.lsp, for Dyl:QuickDrawDialog of
  Apps\Draw\Dyl-QuickDraw.lsp). A preset window: its list is "lst", the presets are edited
  in the window itself by the preset editor (Installer\Windows\Engine\Presets.cs: the list,
  New, Copy, Delete, the resets, the aliases, at the bottom of Parameters), the Lisp saves them on Draw (1) and Save (2).
  The controls of the values are named as the tiles of the presets (pst/tiles, the column
  of each one in a preset, see *qd:tiles*); mbs is Custom band settings, mak the assembly
  preset of an assembly (its id), hbr Has a border and hha Has a hatch (the border and the
  hatch themselves, their layer key and the properties they override, are columns of the
  preset with no control here: they are edited in the Border Settings and Hatch Settings
  windows); mei, mwl, mld, hbi and hhi show the columns the Lisp adds for the window (the own
  ends and corners of the bands, the width of the layers of the assembly, its description
  beside the preview: those of the assembly picked in mak, pst/follow; the summaries of the
  border and of the hatch); mpv is the
  preview of the preset shown (pst/spec, pst/outline). The open
  buttons close the window with the code of what they open, as the DCL window did: 3 Band
  Settings, 5 Assembly Presets, 8 Preset Groups, 12 Border Settings, 13 Hatch Settings (its
  own open button, the Materials window, closes it with 9); the
  Lisp opens the
  window again once it is done. What each control greys out, as Remote>>Dyl:MaterialDlgBehaviors
  did: its dyl:Win.EnabledBy (the method, an assembly, a solid hatch: pst/solid).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Quick Draw" dyl:Win.Docs="Draw\Dyl-QuickDraw.htm">
  <Window.Resources>
    <!-- A row of a value: its label on the left, its box at the right of the column: -->
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="440"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="660"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The presets: -->
    <DockPanel>
      <GroupBox Header="Presets">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox x:Name="srt" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" ToolTip="Sort by"/>
            <TextBox x:Name="flt" Style="{DynamicResource Dyl.Search}" Tag="Filter" MaxLength="64"/>
          </DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Show"/>
            <ComboBox x:Name="shg" DockPanel.Dock="Left" Width="150"/>
            <Button x:Name="shd" DockPanel.Dock="Left" Content="Set default"/>
            <TextBlock x:Name="pcn" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}"/>
          </DockPanel>
          <!-- The titles of the columns of the list (the same widths as its items): -->
          <Grid DockPanel.Dock="Top" Margin="6,0,10,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Group"/>
            <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Name"/>
            <TextBlock Grid.Column="3" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Aliases"/>
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="new" Margin="0" Content="New"/>
            <Button x:Name="cpy" Content="Copy"/>
            <Button x:Name="del" Content="Delete"/>
          </StackPanel>
          <!-- Double-click: draws the preset. Ctrl / Shift click: several presets edited at once: -->
          <ListBox x:Name="lst" Height="542">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                  </Grid.ColumnDefinitions>
                  <dyl:HatchTile Width="34" Height="20" HorizontalAlignment="Left" Radius="3" ShowScale="False" Spec="{Binding Spec}"
                                 Ink="{DynamicResource Dyl.Text}" Fill="{DynamicResource Dyl.Input}"/>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding Group}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Dyl.Muted}"
                             Text="{Binding Aliases}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </GroupBox>
    </DockPanel>

    <!-- The preset shown: -->
    <StackPanel Grid.Column="2">
      <GroupBox Padding="16,0,16,14">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBox x:Name="nam" DockPanel.Dock="Right" Width="320" MaxLength="64"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Name"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="grp" DockPanel.Dock="Right" Width="320"/>
            <dyl:OpenButton x:Name="gre" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="8" ToolTip="Preset Groups"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Group"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock x:Name="prm" DockPanel.Dock="Left" Style="{DynamicResource Dyl.Desc}" Margin="0,0,12,0"/>
            <TextBlock x:Name="src" Style="{DynamicResource Dyl.Desc}" Margin="0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <!-- The preview of the preset shown, as in the Quick Draw Gallery: its hatch, or the
           layers of its assembly side by side, outlined when it has a border; beside an
           assembly, its total thickness and its layers (mld), pale: -->
      <GroupBox Header="Preview">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <dyl:HatchTile x:Name="mpv" Height="128" Radius="6"
                         Ink="{DynamicResource Dyl.Text}" Fill="{DynamicResource Dyl.Input}" LabelBack="{DynamicResource Dyl.Surface}"/>
          <TextBlock x:Name="mld" Grid.Column="1" Style="{DynamicResource Dyl.Desc}" Margin="16,0,0,0" MinWidth="170" Opacity="0.8"
                     dyl:Win.VisibleBy="mas,mth=Linear|Offset|"/>
        </Grid>
      </GroupBox>

      <!-- How the preset is drawn, in two columns: its method and their values; its bands (Linear, Offset): their width, an assembly of layers, their band
           settings; under them its hatch and its border, then the aliases of the preset: -->
      <GroupBox Header="Parameters">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="29"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,0,0,4" Text="Drawing"/>
              <DockPanel Style="{StaticResource Row}">
                <ComboBox x:Name="mth" DockPanel.Dock="Right" Width="150"/>
                <TextBlock Style="{DynamicResource Dyl.Label}" Text="Default method"/>
              </DockPanel>
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mth=Polygon|">
                <TextBox x:Name="msd" DockPanel.Dock="Right" Width="150"
                         dyl:Win.Check="empty;integer;min=3;max=1024"
                         dyl:Win.CheckMessage="The number of sides must be a whole number from 3 to 1024 (empty: asked when drawn)."/>
                <TextBlock Style="{DynamicResource Dyl.Label}" Text="Sides"/>
              </DockPanel>
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mth=Shrinkwrap|">
                <TextBox x:Name="mgp" DockPanel.Dock="Right" Width="90" dyl:Win.EnabledBy="mgo"
                         dyl:Win.Check="empty;number;min=0"
                         dyl:Win.CheckMessage="The gap tolerance must be a number, 0 or more (empty: asked when drawn)."/>
                <CheckBox x:Name="mgo" Content="Gap override"/>
              </DockPanel>
            </StackPanel>
            <!-- The line between the two columns: -->
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Dyl.Border}"/>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,0,0,4" Text="Bands" dyl:Win.EnabledBy="mth=Linear|Offset|"/>
              <!-- The width of an assembly: the total of its layers, greyed out: -->
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mth=Linear|Offset|">
                <Grid DockPanel.Dock="Right" Width="150">
                  <TextBox x:Name="mwd" MaxLength="128" dyl:Win.VisibleBy="!mas;mth!=Linear|Offset|"
                           dyl:Win.Check="empty;widths"
                           dyl:Win.CheckMessage="Widths must be numbers greater than 0, divided by commas (empty: the last width used)."/>
                  <TextBox x:Name="mwl" IsEnabled="False" dyl:Win.VisibleBy="mas,mth=Linear|Offset|"/>
                </Grid>
                <TextBlock Style="{DynamicResource Dyl.Label}" Text="Width"/>
              </DockPanel>
              <!-- Where the line drawn is in the band (Linear), an assembly's too (Structural
                   layer: the middle of the layer of its assembly checked Structural): -->
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mth=Linear|">
                <ComboBox x:Name="mjs" DockPanel.Dock="Right" Width="150"/>
                <TextBlock Style="{DynamicResource Dyl.Label}" Text="Justification"/>
              </DockPanel>
              <!-- A band of several layers: an assembly preset, picked in the list; its open
                   button opens the Assembly Presets window, to make or edit them: -->
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mth=Linear|Offset|">
                <ComboBox x:Name="mak" DockPanel.Dock="Right" Width="150" dyl:Win.EnabledBy="mas"/>
                <dyl:OpenButton x:Name="mae" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="5" ToolTip="Assembly Presets"
                                dyl:Win.EnabledBy="mas"/>
                <CheckBox x:Name="mas" Content="Assembly"/>
              </DockPanel>
              <!-- Custom band settings: on, the hatch along the line (its scale
                   and origin), the ends and the corners of the Band Settings window (its open
                   button); off, the defaults; greyed out for an assembly (each layer has its own,
                   in the Assembly Presets window). What the bands are drawn with is summed up
                   under it: -->
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="!mas,mth=Linear|Offset|">
                <dyl:OpenButton x:Name="mbe" DockPanel.Dock="Right" dyl:Win.Close="3" ToolTip="Band Settings"
                                dyl:Win.EnabledBy="mbs"/>
                <CheckBox x:Name="mbs" Content="Custom band settings"/>
              </DockPanel>
              <Grid Margin="46,0,0,4" dyl:Win.EnabledBy="!mas,mth=Linear|Offset|">
                <TextBlock x:Name="mei" Style="{DynamicResource Dyl.Desc}" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" dyl:Win.VisibleBy="mbs"/>
                <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="0" Text="Square, Mitered" dyl:Win.VisibleBy="!mbs"/>
              </Grid>
            </StackPanel>
          </Grid>
          <!-- What is drawn of the preset, in the same two columns: its hatch and its border,
               each on the layer key of its settings window (its open button), with the
               properties it overrides, summed up under it. Both are greyed out for an
               assembly (each layer has its own, in the Assembly Presets window). The material
               of the hatch is picked in the Hatch Settings window; Has a hatch is greyed out
               for Replace (it changes hatches that are there), its open button kept there for
               the material: -->
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="29"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,0,0,4" Text="Hatch"/>
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="!mas;mth!=Linear|Offset|">
                <dyl:OpenButton x:Name="hhe" DockPanel.Dock="Right" dyl:Win.Close="13" ToolTip="Hatch Settings"
                                dyl:Win.EnabledBy="hha;mth=Replace"/>
                <CheckBox x:Name="hha" Content="Has a hatch" dyl:Win.EnabledBy="mth!=Replace"/>
              </DockPanel>
              <Grid Margin="46,0,0,4" dyl:Win.EnabledBy="!mas;mth!=Linear|Offset|">
                <TextBlock x:Name="hhi" Style="{DynamicResource Dyl.Desc}" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" dyl:Win.VisibleBy="hha;mth=Replace"/>
              </Grid>
            </StackPanel>
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Dyl.Border}"/>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,0,0,4" Text="Border"/>
              <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="!mas;mth!=Linear|Offset|">
                <dyl:OpenButton x:Name="hbe" DockPanel.Dock="Right" dyl:Win.Close="12" ToolTip="Border Settings"
                                dyl:Win.EnabledBy="hbr"/>
                <CheckBox x:Name="hbr" Content="Has a border"/>
              </DockPanel>
              <Grid Margin="46,0,0,4" dyl:Win.EnabledBy="!mas;mth!=Linear|Offset|">
                <TextBlock x:Name="hbi" Style="{DynamicResource Dyl.Desc}" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" dyl:Win.VisibleBy="hbr"/>
              </Grid>
            </StackPanel>
          </Grid>
          <!-- The aliases of the preset shown (the short names that run it), picked to be renamed
               or removed: -->
          <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource Dyl.Border}"/>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Text="Aliases"/>
          <ListBox x:Name="als" ItemContainerStyle="{DynamicResource Dyl.Chip}" MinHeight="30" MaxHeight="64" Margin="0,0,0,4">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <DockPanel>
            <Button x:Name="adel" DockPanel.Dock="Right" Content="Remove" MinWidth="76"/>
            <Button x:Name="aren" DockPanel.Dock="Right" Content="Rename" MinWidth="76"/>
            <Button x:Name="aad" DockPanel.Dock="Right" Content="Add" MinWidth="60"/>
            <TextBox x:Name="aln" Tag="New alias" MaxLength="64"/>
          </DockPanel>
          <TextBlock x:Name="ams" Style="{DynamicResource Dyl.Desc}" Margin="2,6,0,0"/>
        </StackPanel>
      </GroupBox>

    </StackPanel>

    <TextBlock x:Name="error" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" Visibility="Collapsed"/>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Button x:Name="rst" DockPanel.Dock="Left" Margin="0" Content="Reset Selected"/>
      <Button x:Name="all" DockPanel.Dock="Left" Content="Reset All"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Draw" IsDefault="True"/>
        <Button Content="_Save" dyl:Win.Close="2"/>
        <Button Content="_Cancel" IsCancel="True"/>
        <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
