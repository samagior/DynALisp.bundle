  Shown by Dyl:ChildPicker (Child picker of Resources\dynalisp.mnl) for every main command
  whose file holds preset children (Make Layers, Layer Filters, Standard Grid...): its title
  (win/title), the children turned on (aliases TAB name) and the hint of the caller (hnt).
  Its docs page is the page of the main command, given by the Lisp (docs/child). OK or a
  child double-clicked closes it with 1: the Lisp runs the child picked.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp" dyl:Win.Docs="child">
  <StackPanel Margin="14" Width="560">
    <GroupBox Header="Commands" Margin="0">
      <StackPanel>
        <Grid Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Aliases"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Command"/>
        </Grid>
        <ListBox x:Name="lst" Height="360" dyl:Win.Close="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"/>
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="hnt" Style="{DynamicResource Dyl.Desc}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="0" Text="The aliases are edited in Dyl-Suite."/>
      </StackPanel>
    </GroupBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" dyl:Win.EnabledBy="lst!=-1"/>
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
