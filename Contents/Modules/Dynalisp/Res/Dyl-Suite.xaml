  Shown by c:Dyl-Suite (StartupSuite region of Resources\dynalisp.mnl). Its list (lst) is the
  list of the Startup Suite window (Installer\Windows\Engine\Suite.cs): the Lisp gives the
  commands (ste/rows) and the aliases (ste/als), the window filters, sorts, folds the
  children, turns the commands on and off, edits the aliases and opens the docs and the Lisp
  files itself, with no call to the Lisp; Save (1) gives them back, and the Lisp saves
  StartupSuite.csv and Aliases.csv. Open in VS Code closes it with 3: the Lisp opens the
  folder, then this window again, as it was.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Startup Suite" dyl:Win.Docs="Core\Dyl-Suite.htm">
  <Window.Resources>
    <!-- The columns of the list, the same for its titles and its lines: -->
    <GridLength x:Key="ColLoad">34</GridLength>
    <GridLength x:Key="ColFold">18</GridLength>
    <GridLength x:Key="ColCmd">250</GridLength>
    <GridLength x:Key="ColAls">180</GridLength>
    <GridLength x:Key="ColName">330</GridLength>
    <GridLength x:Key="ColMod">100</GridLength>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="560"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="520"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The commands: what is listed, the list, what the buttons under it do to it: -->
    <GroupBox Grid.ColumnSpan="3" Header="Commands" Margin="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Module"/>
          <ComboBox x:Name="mod" DockPanel.Dock="Left" Width="120" Margin="0,0,16,0"/>
          <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Group"/>
          <ComboBox x:Name="grp" DockPanel.Dock="Left" Width="140" Margin="0,0,16,0"/>
          <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Show"/>
          <ComboBox x:Name="shw" DockPanel.Dock="Left" Width="120" Margin="0,0,16,0"/>
          <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Sort by"/>
          <ComboBox x:Name="srt" DockPanel.Dock="Left" Width="110" Margin="0,0,16,0"/>
          <Button x:Name="clr" DockPanel.Dock="Right" Content="Clear"/>
          <TextBox x:Name="flt" Style="{DynamicResource Dyl.Search}" Tag="Search" MaxLength="64"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <CheckBox x:Name="sof" DockPanel.Dock="Left" Content="Show unloaded commands" Margin="0,4,24,4"/>
          <CheckBox x:Name="sch" DockPanel.Dock="Left" Content="Show child commands"/>
          <TextBlock x:Name="cnt" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}"/>
        </DockPanel>
        <!-- The titles of the columns of the list (the same widths as its lines): -->
        <Grid DockPanel.Dock="Top" Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColLoad}"/>
            <ColumnDefinition Width="{StaticResource ColFold}"/>
            <ColumnDefinition Width="{StaticResource ColCmd}"/>
            <ColumnDefinition Width="{StaticResource ColAls}"/>
            <ColumnDefinition Width="{StaticResource ColName}"/>
            <ColumnDefinition Width="{StaticResource ColMod}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Load"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Command"/>
          <TextBlock Grid.Column="3" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Aliases"/>
          <TextBlock Grid.Column="4" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Name"/>
          <TextBlock Grid.Column="5" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Module"/>
          <TextBlock Grid.Column="6" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Group"/>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="onf" Margin="0" Content="On/Off"/>
          <Button x:Name="aonf" Content="All Listed On/Off"/>
          <Button x:Name="fld" Margin="24,0,0,0" Content="Fold/Unfold"/>
          <Button x:Name="fal" Content="Fold/Unfold All"/>
        </StackPanel>
        <!-- Ctrl / Shift click: several commands; double-click: folds a main command with
             children, opens the docs of any other; its box turns it on or off: -->
        <ListBox x:Name="lst" Height="430" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColLoad}"/>
                  <ColumnDefinition Width="{StaticResource ColFold}"/>
                  <ColumnDefinition Width="{StaticResource ColCmd}"/>
                  <ColumnDefinition Width="{StaticResource ColAls}"/>
                  <ColumnDefinition Width="{StaticResource ColName}"/>
                  <ColumnDefinition Width="{StaticResource ColMod}"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{DynamicResource Dyl.Check}" HorizontalAlignment="Left" Margin="4,0,0,0"
                          IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
                <TextBlock Grid.Column="1" Tag="fold" Text="{Binding Fold}" Background="Transparent" Cursor="Hand"
                           VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Command}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Margin" Value="0,0,8,0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Child}" Value="True">
                          <Setter Property="Margin" Value="18,0,8,0"/>
                          <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Dyl.Muted}"
                           Text="{Binding Aliases}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding Module}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding Group}" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </GroupBox>

    <!-- The command selected: its name, its description, its main command or children: -->
    <GroupBox Grid.Row="1" Header="Selection">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="doc" Margin="0" Content="Command docs"/>
          <Button x:Name="lsp" Content="Open Lisp"/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="nam" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
          <TextBlock x:Name="des" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="pth" Style="{DynamicResource Dyl.Desc}" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </GroupBox>

    <!-- The aliases of the one command selected: picked, typed, added, renamed, removed: -->
    <GroupBox Grid.Row="1" Grid.Column="2" Header="Aliases of the command">
      <StackPanel>
        <ListBox x:Name="als" ItemContainerStyle="{DynamicResource Dyl.Chip}" MinHeight="30" MaxHeight="64" Margin="0,0,0,4">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <DockPanel>
          <Button x:Name="adel" DockPanel.Dock="Right" Content="Remove" MinWidth="76"/>
          <Button x:Name="aren" DockPanel.Dock="Right" Content="Rename" MinWidth="76"/>
          <Button x:Name="aad" DockPanel.Dock="Right" Content="Add" MinWidth="60"/>
          <TextBox x:Name="aln" Tag="New alias" MaxLength="64"/>
        </DockPanel>
        <TextBlock x:Name="ams" Style="{DynamicResource Dyl.Desc}" Margin="0,6,0,0"/>
      </StackPanel>
    </GroupBox>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Button x:Name="vsc" DockPanel.Dock="Left" Margin="0" Content="Open in VS Code" dyl:Win.Close="3"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="_Save" IsDefault="True"/>
        <Button Content="_Cancel" IsCancel="True"/>
        <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
      <!-- An alias refused once saved (an AutoCAD command: Dyl:SuiteWinBad): -->
      <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="16,0,8,0" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
