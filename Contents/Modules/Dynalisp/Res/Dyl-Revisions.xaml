  Shown by c:Dyl-Revisions (Apps\Output\Dyl-Revisions.lsp): the project (prj), its revisions,
  a list of rows edited in the window (Installer\Windows\Engine\Rows.cs): rev/rows, a row per
  revision (id numbering date description issuedto issuedby issued sequence number; the last
  two shown, never edited), the fields giving their value to the revisions selected that are
  not issued. Its sheets (sht: sheet TAB layout TAB has the revision picked TAB its revisions),
  whose third column follows the revision picked (Win.ItemsBy, sht/by: the items of the sheets
  for each revision). Every button that changes the numbers closes the window with its number
  and the Lisp shows it again: 2 Update All Sheets, 4 Title blocks, 5 a numbering picked,
  6 New, 7 Delete, 8 Move up, 9 Move down, 10 Add Revision, 11 Remove Revision, 12 the
  numbering of the project, 13 its first number.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Revisions" dyl:Win.Docs="Output\Dyl-Revisions.htm">
  <Window.Resources>
    <GridLength x:Key="ColSeq">44</GridLength>
    <GridLength x:Key="ColNum">70</GridLength>
    <GridLength x:Key="ColDat">96</GridLength>
    <GridLength x:Key="ColIss">52</GridLength>
    <GridLength x:Key="ColSht">330</GridLength>
    <GridLength x:Key="ColLay">220</GridLength>
    <GridLength x:Key="ColHas">110</GridLength>
  </Window.Resources>
  <StackPanel Margin="14" Width="1000">
    <TextBlock x:Name="prj" Style="{DynamicResource Dyl.Desc}" TextTrimming="CharacterEllipsis" Margin="2,0,0,10"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <!-- The revisions, in their sequence: -->
      <GroupBox Header="Revisions" Margin="0">
        <StackPanel>
          <Grid Margin="6,0,24,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource ColSeq}"/>
              <ColumnDefinition Width="{StaticResource ColNum}"/>
              <ColumnDefinition Width="{StaticResource ColDat}"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="{StaticResource ColIss}"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Seq."/>
            <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Number"/>
            <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Date"/>
            <TextBlock Grid.Column="3" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Description"/>
            <TextBlock Grid.Column="4" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Issued"/>
          </Grid>
          <ListBox x:Name="rev" Height="250" SelectionMode="Extended" dyl:Win.Rows="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColSeq}"/>
                    <ColumnDefinition Width="{StaticResource ColNum}"/>
                    <ColumnDefinition Width="{StaticResource ColDat}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColIss}"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{DynamicResource Dyl.Muted}" Text="{Binding V[7]}"/>
                  <TextBlock Grid.Column="1" Text="{Binding V[8]}"/>
                  <TextBlock Grid.Column="2" Text="{Binding V[2]}" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding V[3]}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                  <CheckBox Grid.Column="4" Style="{DynamicResource Dyl.Check}" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False"
                            IsChecked="{Binding V[6], Mode=OneWay, Converter={x:Static dyl:On.Converter}}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="new" Margin="0" Content="New" dyl:Win.Close="6"/>
            <Button x:Name="del" Content="Delete" dyl:Win.Close="7" dyl:Win.EnabledBy="rev!=-1"/>
            <Button x:Name="up" Content="Move Up" dyl:Win.Close="8" dyl:Win.EnabledBy="rev!=-1"/>
            <Button x:Name="dn" Content="Move Down" dyl:Win.Close="9" dyl:Win.EnabledBy="rev!=-1"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <StackPanel Grid.Column="2">
        <!-- The revision picked (the first one selected); an issued one is greyed out but Issued: -->
        <GroupBox Header="Parameters" Margin="0" dyl:Win.Summary="Parameters{sel| (# selected)}">
          <StackPanel>
            <DockPanel Margin="0,3" dyl:Win.EnabledBy="!iss">
              <ComboBox x:Name="num" DockPanel.Dock="Right" Width="240" dyl:Win.Column="1" dyl:Win.Close="5"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Numbering"/>
            </DockPanel>
            <DockPanel Margin="0,3" dyl:Win.EnabledBy="!iss">
              <TextBox x:Name="dat" DockPanel.Dock="Right" Width="240" MaxLength="32" dyl:Win.Column="2"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Date"/>
            </DockPanel>
            <DockPanel Margin="0,3" dyl:Win.EnabledBy="!iss">
              <TextBox x:Name="dsc" DockPanel.Dock="Right" Width="240" MaxLength="255" dyl:Win.Column="3"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Description"/>
            </DockPanel>
            <DockPanel Margin="0,3" dyl:Win.EnabledBy="!iss">
              <TextBox x:Name="ito" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="4"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Issued to"/>
            </DockPanel>
            <DockPanel Margin="0,3" dyl:Win.EnabledBy="!iss">
              <TextBox x:Name="iby" DockPanel.Dock="Right" Width="240" MaxLength="64" dyl:Win.Column="5"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Issued by"/>
            </DockPanel>
            <CheckBox x:Name="iss" Content="Issued" Margin="0,8,0,0" dyl:Win.Column="6"/>
          </StackPanel>
        </GroupBox>

        <!-- The numbering of the project, its title blocks: -->
        <GroupBox Header="Project">
          <StackPanel>
            <DockPanel Margin="0,3">
              <ComboBox x:Name="pnm" DockPanel.Dock="Right" Width="240" dyl:Win.Close="12"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Numbering"/>
            </DockPanel>
            <DockPanel Margin="0,3">
              <ComboBox x:Name="pst" DockPanel.Dock="Right" Width="240" dyl:Win.Close="13"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="First number"/>
            </DockPanel>
            <DockPanel Margin="0,3">
              <TextBlock x:Name="tbs" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center"/>
              <dyl:OpenButton x:Name="tbm" DockPanel.Dock="Right" Margin="0,0,8,0" ToolTip="Revision Title Blocks" dyl:Win.Close="4"/>
              <TextBlock Style="{DynamicResource Dyl.Label}" Text="Title blocks"/>
            </DockPanel>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </Grid>

    <!-- The sheets of the project, what each one has of the revision picked, its revisions: -->
    <GroupBox Header="Sheets">
      <StackPanel>
        <Grid Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColSht}"/>
            <ColumnDefinition Width="{StaticResource ColLay}"/>
            <ColumnDefinition Width="{StaticResource ColHas}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Sheet"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Layout"/>
          <TextBlock x:Name="shh" Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" dyl:Win.ItemsBy="rev"/>
          <TextBlock Grid.Column="3" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Revisions"/>
        </Grid>
        <ListBox x:Name="sht" Height="250" SelectionMode="Extended" dyl:Win.ItemsBy="rev">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColSht}"/>
                  <ColumnDefinition Width="{StaticResource ColLay}"/>
                  <ColumnDefinition Width="{StaticResource ColHas}"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"/>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
                <TextBlock Grid.Column="2" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"/>
                <TextBlock Grid.Column="3" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=3}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,10,0,0">
          <TextBlock x:Name="scn" DockPanel.Dock="Right" Style="{DynamicResource Dyl.Desc}" VerticalAlignment="Center" dyl:Win.ItemsBy="rev"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="add" Margin="0" Content="Add Revision" dyl:Win.Close="10" dyl:Win.EnabledBy="sht!=,rev!=-1"/>
            <Button x:Name="rem" Content="Remove Revision" dyl:Win.Close="11" dyl:Win.EnabledBy="sht!=,rev!=-1"/>
            <Button x:Name="all" Content="Update All Sheets" dyl:Win.Close="2"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </GroupBox>

    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" TextWrapping="Wrap" Margin="2,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
