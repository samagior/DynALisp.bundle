  Shown by DynALisp.Windows.dll (Installer\Windows) through the preset engine
  (Remote>>Dyl:PresetWin of Remote\Dyl-Presets.lsp, for Remote>>Dyl:MaterialDialog of
  Remote\Dyl-Materials.lsp): by the command Dyl-Materials, and by the open button beside
  Material in the Quick Draw and Quick Shape windows. A preset window: its list "lst" is the
  materials (pst/rows: id group name cut surface conductivity density resistance permeability
  permeance), edited in
  the window itself (Installer\Windows\Engine\Presets.cs: the list, New, Copy, Delete, the
  resets); OK (1) saves them and gives the material selected to the window it was opened
  from. mat is the Cut hatch preset (the Material list of the engine, on the hatch presets:
  pst/mats, every one listed, pst/matfree), mpv its preview, sur the Surface hatch preset
  (sur/list, sur/vals: "" Same as Cut), cnd, den, rsi, vpm and vpc the data, in the units
  of the drawing (mt.imp "1": imperial, the Lisp converts them, *mt:data*). The open buttons close
  the window with the code of what they open: 8 Preset Groups, 9 Hatch Presets on the Cut
  hatch preset, 10 Hatch Presets on the Surface hatch preset; the Lisp opens the window
  again once it is done.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Materials" dyl:Win.Docs="Draw\Dyl-Materials.htm">
  <Window.Resources>
    <!-- A row of a value: its label on the left, its box at the right of the column: -->
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
    <!-- The unit after a value box: -->
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="DockPanel.Dock" Value="Right"/>
      <Setter Property="Width" Value="110"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Dyl.Muted}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="560"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The materials (Ctrl / Shift click: several edited at once), each one with the
         preview of its Cut hatch preset: -->
    <GroupBox Header="Materials" Margin="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <ComboBox x:Name="srt" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" ToolTip="Sort by"/>
          <TextBox x:Name="flt" Style="{DynamicResource Dyl.Search}" Tag="Filter" MaxLength="64"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Dyl.Label}" Text="Show"/>
          <ComboBox x:Name="shg" DockPanel.Dock="Left" Width="110"/>
          <Button x:Name="shd" DockPanel.Dock="Left" Content="Set default"/>
          <TextBlock x:Name="pcn" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}"/>
        </DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,0,10,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Group"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Name"/>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="new" Margin="0" Content="New"/>
          <Button x:Name="cpy" Content="Copy"/>
          <Button x:Name="del" Content="Delete"/>
        </StackPanel>
        <ListBox x:Name="lst" MinHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <dyl:HatchTile Width="34" Height="20" HorizontalAlignment="Left" Radius="3" ShowScale="False" Spec="{Binding Spec}"
                               Ink="{DynamicResource Dyl.Text}" Fill="{DynamicResource Dyl.Input}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding Group}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </GroupBox>

    <!-- The material shown: -->
    <StackPanel Grid.Column="2">
      <GroupBox Padding="16,0,16,14" Margin="0">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBox x:Name="nam" DockPanel.Dock="Right" Width="300" MaxLength="64"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Name"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="grp" DockPanel.Dock="Right" Width="300"/>
            <dyl:OpenButton x:Name="gre" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="8" ToolTip="Preset Groups"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Group"/>
          </DockPanel>
          <TextBlock x:Name="prm" Style="{DynamicResource Dyl.Desc}" Margin="0,4,0,0"/>
        </StackPanel>
      </GroupBox>

      <!-- Its hatch presets: in section (Cut) and in elevation (Surface, Same as Cut): -->
      <GroupBox Header="Hatch">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="mat" DockPanel.Dock="Right" Width="300"/>
            <dyl:OpenButton x:Name="edm" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="9" ToolTip="Hatch Presets"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Cut"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="sur" DockPanel.Dock="Right" Width="300"/>
            <dyl:OpenButton x:Name="eds" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="10" ToolTip="Hatch Presets"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Surface"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <!-- The Cut hatch preset as it plots: -->
      <GroupBox Header="Preview">
        <dyl:HatchTile x:Name="mpv" Height="110" Radius="6"
                       Ink="{DynamicResource Dyl.Text}" Fill="{DynamicResource Dyl.Input}" LabelBack="{DynamicResource Dyl.Surface}"/>
      </GroupBox>

      <!-- Its data, in the units of the drawing (empty: not known): -->
      <GroupBox Header="Data">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Unit}" Text="W/m·K" dyl:Win.VisibleBy="!mt.imp"/>
            <TextBlock Style="{StaticResource Unit}" Text="Btu·in/h·ft²·°F" dyl:Win.VisibleBy="mt.imp"/>
            <TextBox x:Name="cnd" DockPanel.Dock="Right" Width="120" dyl:Win.Check="empty;positive"
                     dyl:Win.CheckMessage="The thermal conductivity must be a number greater than 0 (empty: not known)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Thermal conductivity"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Unit}" Text="kg/m³" dyl:Win.VisibleBy="!mt.imp"/>
            <TextBlock Style="{StaticResource Unit}" Text="lb/ft³" dyl:Win.VisibleBy="mt.imp"/>
            <TextBox x:Name="den" DockPanel.Dock="Right" Width="120" dyl:Win.Check="empty;positive"
                     dyl:Win.CheckMessage="The density must be a number greater than 0 (empty: not known)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Density"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Unit}" Text="m²·K/W" dyl:Win.VisibleBy="!mt.imp"/>
            <TextBlock Style="{StaticResource Unit}" Text="h·ft²·°F/Btu" dyl:Win.VisibleBy="mt.imp"/>
            <TextBox x:Name="rsi" DockPanel.Dock="Right" Width="120" dyl:Win.Check="empty;positive"
                     dyl:Win.CheckMessage="The thermal resistance must be a number greater than 0 (empty: not known)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Thermal resistance"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Unit}" Text="ng/Pa·s·m" dyl:Win.VisibleBy="!mt.imp"/>
            <TextBlock Style="{StaticResource Unit}" Text="perm·in" dyl:Win.VisibleBy="mt.imp"/>
            <TextBox x:Name="vpm" DockPanel.Dock="Right" Width="120" dyl:Win.Check="empty;positive"
                     dyl:Win.CheckMessage="The vapour permeability must be a number greater than 0 (empty: not known)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Vapour permeability"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Unit}" Text="ng/Pa·s·m²" dyl:Win.VisibleBy="!mt.imp"/>
            <TextBlock Style="{StaticResource Unit}" Text="perm" dyl:Win.VisibleBy="mt.imp"/>
            <TextBox x:Name="vpc" DockPanel.Dock="Right" Width="120" dyl:Win.Check="empty;positive"
                     dyl:Win.CheckMessage="The vapour permeance must be a number greater than 0 (empty: not known)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Vapour permeance"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
    </StackPanel>

    <TextBlock x:Name="error" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Button x:Name="rst" DockPanel.Dock="Left" Margin="0" Content="Reset Selected"/>
      <Button x:Name="all" DockPanel.Dock="Left" Content="Reset All"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK" IsDefault="True"/>
        <Button Content="_Cancel" IsCancel="True"/>
        <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
