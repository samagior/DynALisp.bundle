  along with this program.  If not, see <https://www.gnu.org/licenses/>.

  Opened by the open button of Months in the Simulation window (Res\Dyl-Simulation.xaml), by
  the window itself (dyl:Win.Open on the columns of the climates selected), on the climate
  shown; OK gives the months to every climate selected. The keys are the columns of the row
  of a climate, as they are shown (Dyl:SimClimRow of Apps\Analysis\Dyl-Simulation.lsp): mt1
  to mt12 the temperature of each month, January first (columns 6 to 17, in F while sim.imp
  is "1"), mh1 to mh12 its relative humidity (columns 18 to 29, %). A climate without its
  months is the same all year; the monthly balance refuses one with some months and not all.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Months" dyl:Win.Docs="Analysis\Dyl-SimulationMonths.htm">
  <StackPanel Margin="14" Width="380">
    <GroupBox Header="Months" Margin="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" Text="Temperature °C" dyl:Win.VisibleBy="!sim.imp"/>
        <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" Text="Temperature °F" dyl:Win.VisibleBy="sim.imp"/>
        <TextBlock Grid.Column="3" Foreground="{DynamicResource Dyl.Muted}" Text="Humidity %"/>
        <TextBlock Grid.Row="1" Style="{DynamicResource Dyl.Label}" Text="January" VerticalAlignment="Center"/>
        <TextBox x:Name="mt1" Grid.Row="1" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of January must be a number (empty: not known)."/>
        <TextBox x:Name="mh1" Grid.Row="1" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of January must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="2" Style="{DynamicResource Dyl.Label}" Text="February" VerticalAlignment="Center"/>
        <TextBox x:Name="mt2" Grid.Row="2" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of February must be a number (empty: not known)."/>
        <TextBox x:Name="mh2" Grid.Row="2" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of February must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="3" Style="{DynamicResource Dyl.Label}" Text="March" VerticalAlignment="Center"/>
        <TextBox x:Name="mt3" Grid.Row="3" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of March must be a number (empty: not known)."/>
        <TextBox x:Name="mh3" Grid.Row="3" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of March must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="4" Style="{DynamicResource Dyl.Label}" Text="April" VerticalAlignment="Center"/>
        <TextBox x:Name="mt4" Grid.Row="4" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of April must be a number (empty: not known)."/>
        <TextBox x:Name="mh4" Grid.Row="4" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of April must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="5" Style="{DynamicResource Dyl.Label}" Text="May" VerticalAlignment="Center"/>
        <TextBox x:Name="mt5" Grid.Row="5" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of May must be a number (empty: not known)."/>
        <TextBox x:Name="mh5" Grid.Row="5" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of May must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="6" Style="{DynamicResource Dyl.Label}" Text="June" VerticalAlignment="Center"/>
        <TextBox x:Name="mt6" Grid.Row="6" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of June must be a number (empty: not known)."/>
        <TextBox x:Name="mh6" Grid.Row="6" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of June must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="7" Style="{DynamicResource Dyl.Label}" Text="July" VerticalAlignment="Center"/>
        <TextBox x:Name="mt7" Grid.Row="7" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of July must be a number (empty: not known)."/>
        <TextBox x:Name="mh7" Grid.Row="7" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of July must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="8" Style="{DynamicResource Dyl.Label}" Text="August" VerticalAlignment="Center"/>
        <TextBox x:Name="mt8" Grid.Row="8" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of August must be a number (empty: not known)."/>
        <TextBox x:Name="mh8" Grid.Row="8" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of August must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="9" Style="{DynamicResource Dyl.Label}" Text="September" VerticalAlignment="Center"/>
        <TextBox x:Name="mt9" Grid.Row="9" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of September must be a number (empty: not known)."/>
        <TextBox x:Name="mh9" Grid.Row="9" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of September must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="10" Style="{DynamicResource Dyl.Label}" Text="October" VerticalAlignment="Center"/>
        <TextBox x:Name="mt10" Grid.Row="10" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of October must be a number (empty: not known)."/>
        <TextBox x:Name="mh10" Grid.Row="10" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of October must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="11" Style="{DynamicResource Dyl.Label}" Text="November" VerticalAlignment="Center"/>
        <TextBox x:Name="mt11" Grid.Row="11" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of November must be a number (empty: not known)."/>
        <TextBox x:Name="mh11" Grid.Row="11" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of November must be a number from 0 to 100 (empty: not known)."/>
        <TextBlock Grid.Row="12" Style="{DynamicResource Dyl.Label}" Text="December" VerticalAlignment="Center"/>
        <TextBox x:Name="mt12" Grid.Row="12" Grid.Column="1" Margin="0,3" dyl:Win.Check="empty;number"
                 dyl:Win.CheckMessage="The temperature of December must be a number (empty: not known)."/>
        <TextBox x:Name="mh12" Grid.Row="12" Grid.Column="3" Margin="0,3" dyl:Win.Check="empty;number;min=0;max=100"
                 dyl:Win.CheckMessage="The relative humidity of December must be a number from 0 to 100 (empty: not known)."/>
      </Grid>
    </GroupBox>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
