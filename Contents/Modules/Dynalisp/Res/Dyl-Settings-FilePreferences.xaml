<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - File Preferences" dyl:Win.Docs="Setup\Dyl-SetFilePrefs.htm">
  <StackPanel Margin="16,16,16,14" Width="520">
    <GroupBox Header="DynALisp profile" Margin="0">
      <StackPanel>
        <TextBlock Style="{DynamicResource Dyl.Desc}" Text="Set in every drawing."/>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="pcl" DockPanel.Dock="Right" Width="280"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="AEC library classification"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="pun" DockPanel.Dock="Right" Width="280"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Drawing units"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="pla" DockPanel.Dock="Right" Width="280"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Content language"/>
        </DockPanel>
        <CheckBox x:Name="pcd" Content="Use the custom dictionary of the language"/>
        <TextBlock x:Name="pfs" Style="{DynamicResource Dyl.Desc}" Margin="0,8,0,0"/>
      </StackPanel>
    </GroupBox>
    <DockPanel Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
      <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="2,0,0,0" VerticalAlignment="Center" Text="Saved when Settings is saved."/>
    </DockPanel>
  </StackPanel>
</Window>
