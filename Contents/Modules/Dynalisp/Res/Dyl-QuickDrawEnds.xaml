  Opened by the open button of Custom ends in the Quick Draw window (it closes with 3, the
  Lisp shows this one: Dyl:QuickDrawBandDialog of Apps\Draw\Dyl-QuickDraw.lsp), on the
  behaviors of the preset shown. OK gives them to every preset selected. The keys are the
  tiles of *mt:bandwindows* (Remote\Dyl-Materials.lsp): men the ends (men/vals: the keys of
  *mt:ends*), mex the extension (Extended), mea the end angle (Angled); greyed out unless the
  ends picked use them, or Ask when drawn. Under the list, the sketch of the ends picked (one
  Canvas each, shown by its rule), drawn as in Docs\Draw\Dyl-QuickDraw.htm#endscorners.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Ends" dyl:Win.Docs="Draw\Dyl-QuickDrawBandSettings.htm">
  <Window.Resources>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="14" Width="400">
    <GroupBox Header="Ends" Margin="0">
      <StackPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="men" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Ends"/>
        </DockPanel>
        <Border Style="{DynamicResource Dyl.Sketch}">
          <Viewbox>
            <Grid Width="240" Height="120">
              <Canvas dyl:Win.VisibleBy="men=Square">
                <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,60 L215,60"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
              </Canvas>
              <Canvas dyl:Win.VisibleBy="men=Open">
                <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 L200,40"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,80 L200,80"/>
                <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M40,40 L40,80"/>
                <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M200,40 L200,80"/>
                <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,60 L215,60"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
              </Canvas>
              <Canvas dyl:Win.VisibleBy="men=Extended">
                <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M18,40 L222,40 222,80 18,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M18,40 L222,40 222,80 18,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,60 L230,60"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M200,96 L222,96"/>
                <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M200,90 L200,102"/>
                <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M222,90 L222,102"/>
                <TextBlock Style="{DynamicResource Dyl.Sketch.Text}" Text="ext" Canvas.Left="198" Canvas.Top="104"/>
              </Canvas>
              <Canvas dyl:Win.VisibleBy="men=Round">
                <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 H200 A20,20 0 0 1 200,80 H40 A20,20 0 0 1 40,40 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 H200 A20,20 0 0 1 200,80 H40 A20,20 0 0 1 40,40 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,60 L230,60"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
              </Canvas>
              <Canvas dyl:Win.VisibleBy="men=Angled">
                <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M52,40 L212,40 188,80 28,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M52,40 L212,40 188,80 28,80 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,60 L220,60"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M200,40 L200,80"/>
                <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M200,46 A14,14 0 0 1 208,47"/>
                <TextBlock Style="{DynamicResource Dyl.Sketch.Text}" Text="angle" Canvas.Left="206" Canvas.Top="20"/>
              </Canvas>
              <TextBlock Style="{DynamicResource Dyl.Sketch.Ask}" dyl:Win.VisibleBy="men=Ask" FontSize="14" Text="Asked when drawn"/>
            </Grid>
          </Viewbox>
        </Border>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="men=Extended|Ask">
          <TextBox x:Name="mex" DockPanel.Dock="Right" Width="180"
                   dyl:Win.Check="empty;number;min=0"
                   dyl:Win.CheckMessage="The extension must be a number, 0 or more (empty: half the width)."/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Extension"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="men=Angled|Ask">
          <TextBox x:Name="mea" DockPanel.Dock="Right" Width="180"
                   dyl:Win.Check="number;min=-80;max=80"
                   dyl:Win.CheckMessage="The end angle must be a number from -80 to 80 (0: square)."/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Angle"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
