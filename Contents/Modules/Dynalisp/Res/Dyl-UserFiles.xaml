  Shown by c:Dyl-UserFiles (UserFiles region of Resources\dynalisp.mnl): lst the user copies
  (path under the User folder TAB what it is), msg what was done. Every button but Close works
  on files, so it closes the window with its number and the Lisp shows it again: 2 Open (or
  an item double-clicked), 3 Open User folder, 4 Reset to default, 5 Make it the default
  (both asked twice: the second click on the same item does it), 6 Export settings,
  7 Import settings.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - User Files" dyl:Win.Docs="Core\Dyl-Info.htm">
  <StackPanel Margin="14" Width="860">
    <!-- The user copies, read in place of their default under Contents: -->
    <GroupBox Header="Your files" Margin="0">
      <StackPanel>
        <TextBlock x:Name="loc" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
        <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="0,0,0,8"
                   Text="Your edits are saved there; the defaults under Contents are never changed by the commands."/>
        <ListBox x:Name="lst" Height="330" dyl:Win.Close="2">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="560"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="msg" Foreground="{DynamicResource Dyl.Accent}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="opn" Margin="0" Content="_Open" dyl:Win.Close="2" dyl:Win.EnabledBy="lst!=-1"/>
          <Button x:Name="dir" Content="Open User folder" dyl:Win.Close="3"/>
          <Button x:Name="rst" Margin="24,0,0,0" Content="_Reset to default" dyl:Win.Close="4" dyl:Win.EnabledBy="lst!=-1"/>
          <Button x:Name="pub" Content="_Make it the default" dyl:Win.Close="5" dyl:Win.EnabledBy="lst!=-1"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <!-- Saved settings (Dyl:SetsExport / Dyl:SetsImport): the User folder, the settings and
         the MyTools module, in a "DynALisp Settings <date>" folder: -->
    <GroupBox Header="Saved settings">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
          <Button x:Name="exp" Margin="0" Content="_Export settings..." dyl:Win.Close="6"/>
          <Button x:Name="imp" Content="_Import settings..." dyl:Win.Close="7"/>
        </StackPanel>
        <TextBlock Style="{DynamicResource Dyl.Desc}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0"
                   Text="Your files, the settings and MyTools, to keep or move to another computer."/>
      </DockPanel>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" IsCancel="True" IsDefault="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
