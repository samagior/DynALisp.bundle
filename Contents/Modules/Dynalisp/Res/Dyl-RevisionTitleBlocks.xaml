  Shown by Dyl:RevBlocksDialog (Apps\Output\Dyl-Revisions.lsp), from its command and the open
  button of Title blocks in the Revisions window: the title blocks of RevisionBlocks.csv, a
  list of rows edited in the window (Installer\Windows\Engine\Rows.cs): tbl/rows, a row per
  title block (block rows first number date description issuedto issuedby current
  currentdate), the fields giving their value to the title blocks selected. Pick... (3) closes
  it: the Lisp guesses the title block picked in the drawing and shows it again. OK saves them.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Revision Title Blocks" dyl:Win.Docs="Output\Dyl-Revisions.htm">
  <Window.Resources>
    <GridLength x:Key="ColRows">50</GridLength>
    <GridLength x:Key="ColFirst">130</GridLength>
  </Window.Resources>
  <StackPanel Margin="14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <GroupBox Header="Title blocks" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="new" Margin="0" Content="Add" dyl:Win.Do="add"/>
            <Button x:Name="del" Content="Delete" dyl:Win.Do="remove"/>
            <Button x:Name="pck" Content="Pick..." dyl:Win.Close="3"/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="6,0,24,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="{StaticResource ColRows}"/>
              <ColumnDefinition Width="{StaticResource ColFirst}"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Block"/>
            <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Rows"/>
            <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Row 1"/>
          </Grid>
          <ListBox x:Name="tbl" SelectionMode="Extended" dyl:Win.Rows="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColRows}"/>
                    <ColumnDefinition Width="{StaticResource ColFirst}"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding [0]}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding [1]}"/>
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource Dyl.Muted}" Text="{Binding [2]}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </GroupBox>

      <!-- The title block picked (the first one selected): its block, its rows, the tags of
           the attributes of a row (# the number of the row) and of the sheet: -->
      <GroupBox Grid.Column="2" Header="Parameters" Margin="0" dyl:Win.Summary="Parameters{sel| (# selected)}">
        <StackPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="nam" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="0"
                     dyl:Win.Unique="Another title block has this block name."
                     dyl:Win.Check="text" dyl:Win.CheckMessage="A title block needs a block name (wildcards * and ? can be used)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Block"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="rws" DockPanel.Dock="Right" Width="240" MaxLength="2" dyl:Win.Column="1"
                     dyl:Win.Check="integer;min=0;max=50" dyl:Win.CheckMessage="Rows: a whole number from 0 to 50."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Rows"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <ComboBox x:Name="fst" DockPanel.Dock="Right" Width="240" dyl:Win.Column="2"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Row 1"/>
          </DockPanel>

          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,14,0,4" Text="Row attributes"/>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a3" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="3"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Number"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a4" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="4"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Date"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a5" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="5"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Description"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a6" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="6"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Issued to"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a7" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="7"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Issued by"/>
          </DockPanel>

          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0,14,0,4" Text="Sheet attributes"/>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a8" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="8"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Current revision"/>
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBox x:Name="a9" DockPanel.Dock="Right" Width="240" MaxLength="128" dyl:Win.Column="9"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Current date"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
    </Grid>

    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" TextWrapping="Wrap" Margin="2,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
