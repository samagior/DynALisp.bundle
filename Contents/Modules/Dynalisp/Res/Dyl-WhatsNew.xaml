  Shown by Dyl:InfoNotesDlg (Info region of Resources\dynalisp.mnl): before an update, after
  one (the first startup of a new version) or all of them (What's new of Dyl-Info). hed is
  the line above the changes, lst what each version brings (CHANGELOG.md, read by
  Dyl:InfoNotes), msg the line under them. Each item of lst is a change, its columns divided
  by tabs: the heading of its version (on the first change of each version), its title, its
  text, its picture (a file, or an address of the docs website), what opens its link (its
  docs page) and the label of the link; dyl:Cell gives each column as its target needs it
  (a text, a picture, an address, hidden when empty). Install (2, its label from the Lisp,
  greyed out when there is nothing to install) starts the setup; All releases (3) opens the
  releases page, and the Lisp shows the window again.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - What's New" dyl:Win.Docs="Core\Dyl-Info.htm">
  <StackPanel Margin="14" Width="760">
    <GroupBox Header="What's new" Margin="0">
      <StackPanel>
        <TextBlock x:Name="hed" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox x:Name="lst" Height="460" ScrollViewer.CanContentScroll="False" ItemContainerStyle="{DynamicResource Dyl.Note}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{DynamicResource Dyl.NoteVersion}"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"
                           Visibility="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"/>
                <TextBlock Style="{DynamicResource Dyl.NoteTitle}"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"
                           Visibility="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"
                           Visibility="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"/>
                <Image Style="{DynamicResource Dyl.NotePicture}"
                       Source="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=3}"
                       Visibility="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=3}"/>
                <TextBlock Margin="0,6,0,0" Visibility="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=4}">
                  <Hyperlink Style="{DynamicResource Dyl.Link}" NavigateUri="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=4}">
                    <Run Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=5, Mode=OneWay}"/>
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="msg" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
    </GroupBox>
    <DockPanel Margin="0,12,0,0">
      <Button x:Name="ins" DockPanel.Dock="Left" Margin="0" Content="Install" dyl:Win.Close="2"/>
      <Button x:Name="rel" DockPanel.Dock="Left" Content="All releases" dyl:Win.Close="3"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
        <Button Content="Close" IsCancel="True" IsDefault="True"/>
        <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
