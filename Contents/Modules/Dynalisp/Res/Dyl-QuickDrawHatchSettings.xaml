  Opened by the open button of Has a hatch in the Quick Draw window (it closes with 13, the
  Lisp shows this one: Dyl:QuickDrawHatchDialog of Apps\Draw\Dyl-QuickDraw.lsp), on the hatch
  of the preset shown; OK gives it to every preset selected. Opened too by the open button of
  Has a hatch of a Hatch layer in the Assembly Presets window, by the window itself
  (dyl:Win.Open on the columns of the layers selected), sub "1": the open buttons of the layer
  key and of the color, which close the window for the Lisp, are greyed out there (the color
  is typed). The keys are the hatch tiles of *mt:hatchtiles* (Remote\Dyl-Materials.lsp): hky
  the layer key (hky/vals the keys, "" first: From hatch preset, the hatch layer key of its
  hatch preset), then each override of the properties of its layer, a checkbox and its
  value, named as those of the Border Settings window: bco bcv the color ("n" or "r,g,b"; bcp
  the color window of AutoCAD, closes with 11), blo blt the linetype, bso bsc the linetype
  scale, bwo bwt the lineweight (bwt/vals in hundredths of a millimeter), bto btr the
  transparency. okp, the Layer Keys window, closes with 6.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Hatch Settings" dyl:Win.Docs="Draw\Dyl-QuickDrawHatchSettings.htm">
  <Window.Resources>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="14" Width="420">
    <GroupBox Header="Hatch" Margin="0">
      <StackPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="hky" DockPanel.Dock="Right" Width="160"/>
          <dyl:OpenButton x:Name="okp" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="6" ToolTip="Layer Keys" dyl:Win.EnabledBy="!sub"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Layer key"/>
        </DockPanel>
        <!-- The properties of the layer of its key the hatch overrides, in place of those its hatch preset overrides: -->
        <TextBlock Style="{DynamicResource Dyl.Sub}" Text="Layer key overrides"/>
        <DockPanel Style="{StaticResource Row}">
          <TextBox x:Name="bcv" DockPanel.Dock="Right" Width="160" dyl:Win.EnabledBy="bco"
                   dyl:Win.Check="color" dyl:Win.CheckMessage="A color is an AutoCAD color number 1-255 or r,g,b (0-255 each), or use the open button beside it."/>
          <dyl:OpenButton x:Name="bcp" DockPanel.Dock="Right" Margin="0,0,8,0" dyl:Win.Close="11" ToolTip="Select Color" dyl:Win.EnabledBy="bco,!sub"/>
          <CheckBox x:Name="bco" Content="Color"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}">
          <TextBox x:Name="blt" DockPanel.Dock="Right" Width="160" CharacterCasing="Upper" dyl:Win.EnabledBy="blo"
                   dyl:Win.Check="text" dyl:Win.CheckMessage="The linetype cannot be empty."/>
          <CheckBox x:Name="blo" Content="Linetype"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}">
          <TextBox x:Name="bsc" DockPanel.Dock="Right" Width="160" dyl:Win.EnabledBy="bso"
                   dyl:Win.Check="positive" dyl:Win.CheckMessage="The linetype scale must be a number greater than 0."/>
          <CheckBox x:Name="bso" Content="Linetype scale"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="bwt" DockPanel.Dock="Right" Width="160" dyl:Win.EnabledBy="bwo"/>
          <CheckBox x:Name="bwo" Content="Lineweight"/>
        </DockPanel>
        <TextBlock Style="{DynamicResource Dyl.Sub}" Text="Optional settings"/>
        <DockPanel Style="{StaticResource Row}">
          <TextBox x:Name="btr" DockPanel.Dock="Right" Width="160" dyl:Win.EnabledBy="bto"
                   dyl:Win.Check="integer;min=0;max=90" dyl:Win.CheckMessage="The transparency must be a whole number from 0 to 90."/>
          <CheckBox x:Name="bto" Content="Transparency"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
