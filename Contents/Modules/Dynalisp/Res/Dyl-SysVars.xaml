  Shown by c:Dyl-SysVars (Apps\Setup\Dyl-SysVars.lsp), like the System Variable Monitor of
  AutoCAD: each variable of the profile shown (pro) with its preferred value and its current
  value, marked when it differs (lst: variable TAB preferred TAB current), then the protected
  variables (kls). A row picked fills the boxes under its list (Win.Fills). Every button but
  OK and Cancel checks or changes the variables, so it closes the window with its number and
  the Lisp shows it again: 2 another profile picked, 3 New..., 4 Copy..., 5 Rename...,
  6 Delete, 7 Add, 8 Use current, 9 List..., 10 Remove, 11 Reset all; for the protected
  variables 12 Add, 13 Use current, 14 List..., 15 Remove.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - System Variables" dyl:Win.Docs="Setup\Dyl-SysVars.htm">
  <Window.Resources>
    <GridLength x:Key="ColVar">220</GridLength>
    <GridLength x:Key="ColVal">240</GridLength>
  </Window.Resources>
  <StackPanel Margin="14" Width="820">

    <!-- The profile shown, the one set in every drawing on OK, and its variables: -->
    <GroupBox Header="Profile" Margin="0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <ComboBox x:Name="pro" Width="260" Margin="0,0,8,0" dyl:Win.Close="2"/>
          <Button x:Name="pnw" Margin="0" Content="New..." dyl:Win.Close="3"/>
          <Button x:Name="pcp" Content="Copy..." dyl:Win.Close="4"/>
          <Button x:Name="prn" Content="Rename..." dyl:Win.Close="5"/>
          <Button x:Name="pdl" Content="Delete" dyl:Win.Close="6"/>
        </StackPanel>
        <Grid Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColVar}"/>
            <ColumnDefinition Width="{StaticResource ColVal}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Variable"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Preferred value"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Current value"/>
        </Grid>
        <ListBox x:Name="lst" Height="280" SelectionMode="Extended" dyl:Win.Fills="var:0,val:1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColVar}"/>
                  <ColumnDefinition Width="{StaticResource ColVal}"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
                <TextBlock Grid.Column="2" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,10,0,3">
          <TextBox x:Name="var" DockPanel.Dock="Right" Width="320" MaxLength="64"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Variable"/>
        </DockPanel>
        <DockPanel Margin="0,3">
          <TextBox x:Name="val" DockPanel.Dock="Right" Width="320" MaxLength="255"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Preferred value"/>
        </DockPanel>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="rst" DockPanel.Dock="Right" Content="Reset all" dyl:Win.Close="11"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="add" Margin="0" Content="_Add" dyl:Win.Close="7"/>
            <Button x:Name="cur" Content="Use current" dyl:Win.Close="8"/>
            <Button x:Name="brw" Content="_List..." dyl:Win.Close="9"/>
            <Button x:Name="del" Content="_Remove" dyl:Win.Close="10" dyl:Win.EnabledBy="lst!="/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </GroupBox>

    <!-- The protected variables (Res\SysVarsProtected.csv): set in every drawing whatever the
         profile, never changed by a profile (no value: protected only): -->
    <GroupBox Header="Protected variables">
      <StackPanel>
        <Grid Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColVar}"/>
            <ColumnDefinition Width="{StaticResource ColVal}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Variable"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Preferred value"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Current value"/>
        </Grid>
        <ListBox x:Name="kls" Height="150" SelectionMode="Extended" dyl:Win.Fills="kvr:0,kvl:1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColVar}"/>
                  <ColumnDefinition Width="{StaticResource ColVal}"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
                <TextBlock Grid.Column="2" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,10,0,3">
          <TextBox x:Name="kvr" DockPanel.Dock="Right" Width="320" MaxLength="64"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Variable"/>
        </DockPanel>
        <DockPanel Margin="0,3">
          <TextBox x:Name="kvl" DockPanel.Dock="Right" Width="320" MaxLength="255"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Preferred value"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="kad" Margin="0" Content="Add" dyl:Win.Close="12"/>
          <Button x:Name="kcu" Content="Use current" dyl:Win.Close="13"/>
          <Button x:Name="kbr" Content="List..." dyl:Win.Close="14"/>
          <Button x:Name="kdl" Content="Remove" dyl:Win.Close="15" dyl:Win.EnabledBy="kls!="/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <TextBlock x:Name="msg" Foreground="{DynamicResource Dyl.Accent}" TextWrapping="Wrap" Margin="2,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
