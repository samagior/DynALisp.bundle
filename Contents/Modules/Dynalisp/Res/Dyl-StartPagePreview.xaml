  Shown by the Start page (Installer\Windows\StartPage.cs, Choose preview picture...) when the
  picture chosen for a drawing is not of the shape of its frames: frm is the file of the
  picture, the frame placed on it (Engine\Frame.cs, of the shape StartUi.PreviewAspect) gives
  back the part kept as frm/crop ("x y width height", its pixels) on OK.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Preview Picture"
        dyl:Win.Docs="Core\Dyl-StartPagePreview.htm">
  <StackPanel Margin="14">
    <GroupBox Header="Frame the preview" Margin="0">
      <StackPanel>
        <dyl:PictureFrame x:Name="frm" Aspect="1.6" Width="640" Height="440"/>
        <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="0,8,0,0" Text="Drag the frame, or its corner to size it."/>
      </StackPanel>
    </GroupBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
