  Opened by the open button of Band settings in the Quick Draw window (it closes with 3, the
  Lisp shows this one: Dyl:QuickDrawBandDialog of Apps\Draw\Dyl-QuickDraw.lsp), on the
  behaviors of the preset shown. OK gives them to every preset selected. The keys are the
  tiles of *mt:bandwindows* (Remote\Dyl-Materials.lsp): mht what the hatch is aligned to (a
  layer: Line its middle, Edge its border nearer to the line of the band, or Origin), men the ends, mex the extension (Extended), mea the end angle
  (Angled), mco the corners, mml the miter limit (Mitered), mlt the segment through a lap
  (Lapped), mjo the joints, msw and mfc the hatch scale from the width, mor, moa and mof the
  hatch origin on the line (Pick... closes the window with 4: the Lisp picks the origin on a
  sample band and opens it again; greyed out for a layer, whose window cannot close for the
  Lisp); a list gets the keys of its items (key/vals). mth, with
  no control, is the method of the preset (Linear, Offset, "": asked when drawn; Layer: a
  layer of an assembly, opened by the Assembly Presets window), mjs, with no control, the
  justification of the preset (the line drawn, set in the Quick Draw window), solid "1" for a
  SOLID hatch: the scale and the origin of the hatch are for a preset that is not SOLID (a
  layer sets its own: its hatch scaled by its thickness, its origin moved from the line of the
  layer). A value is greyed out unless what
  is picked uses it, or Ask when drawn.
  Under the ends and the corners, the sketch of the item picked, drawn as in
  Docs\Draw\Dyl-QuickDraw.htm#endscorners: one Canvas each, shown by its rule; inside, the
  line drawn and its points in the middle of the band or on its border (Edge, Offset, or a
  layer on its edge),
  the hatch of the next segment along it or as the first one (Drawing origin), and the joint
  drawn, dashed (Uninterrupted) or gone (Uninterrupted, from the drawing origin).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Band Settings" dyl:Win.Docs="Draw\Dyl-QuickDrawBandSettings.htm">
  <Window.Resources>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="14" Width="780">
    <GroupBox Header="Band" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="mht" DockPanel.Dock="Right" Width="180"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Hatch aligned to"/>
          </DockPanel>
          <!-- The hatch scale from the width of the band (a layer: from its thickness): -->
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="!solid">
            <TextBox x:Name="mfc" DockPanel.Dock="Right" Width="180" dyl:Win.EnabledBy="msw"
                     dyl:Win.Check="positive" dyl:Win.CheckMessage="The width factor must be a number greater than 0."/>
            <CheckBox x:Name="msw" Content="Scale by width"/>
          </DockPanel>
        </StackPanel>
        <!-- The hatch origin on the line, X along it and Y across it (Pick...: on a sample band,
             the window closes with 4 and opens again on the origin picked): -->
        <StackPanel Grid.Column="2">
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="!solid,mht!=Origin">
            <Button x:Name="mop" DockPanel.Dock="Right" Width="180" MinWidth="0" Margin="0" Content="Pick..." dyl:Win.Close="4"
                    dyl:Win.EnabledBy="mth!=Layer"/>
            <CheckBox x:Name="mor" Content="Origin on line"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mor,!solid,mht!=Origin">
            <TextBox x:Name="moa" DockPanel.Dock="Right" Width="180"
                     dyl:Win.Check="number" dyl:Win.CheckMessage="The origin X offset must be a number (0: at the start of the segment)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Offset X"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mor,!solid,mht!=Origin">
            <TextBox x:Name="mof" DockPanel.Dock="Right" Width="180"
                     dyl:Win.Check="number" dyl:Win.CheckMessage="The origin Y offset must be a number (0: on the line)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Offset Y"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </GroupBox>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Header="Ends" Margin="0">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="men" DockPanel.Dock="Right" Width="180"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Ends"/>
          </DockPanel>
          <Border Style="{DynamicResource Dyl.Sketch}">
            <Viewbox>
              <Grid Width="240" Height="120">
                  <Canvas dyl:Win.VisibleBy="men=Square">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,60 L215,60"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,80 L215,80"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,80 A3,3 0 1 0 43,80 A3,3 0 1 0 37,80 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,80 A3,3 0 1 0 203,80 A3,3 0 1 0 197,80 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="men=Open">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 L200,40 200,80 40,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 L200,40"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,80 L200,80"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M40,40 L40,80"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M200,40 L200,80"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,60 L215,60"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M25,80 L215,80"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,80 A3,3 0 1 0 43,80 A3,3 0 1 0 37,80 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,80 A3,3 0 1 0 203,80 A3,3 0 1 0 197,80 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="men=Extended">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M18,40 L222,40 222,80 18,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M18,40 L222,40 222,80 18,80 Z"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,60 L230,60"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,80 L230,80"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,80 A3,3 0 1 0 43,80 A3,3 0 1 0 37,80 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,80 A3,3 0 1 0 203,80 A3,3 0 1 0 197,80 Z"/>
                    </Canvas>
                    <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M200,96 L222,96"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M200,90 L200,102"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Dim}" Data="M222,90 L222,102"/>
                    <TextBlock Style="{DynamicResource Dyl.Sketch.Text}" Text="ext" Canvas.Left="198" Canvas.Top="104"/>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="men=Round">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M40,40 H200 A20,20 0 0 1 200,80 H40 A20,20 0 0 1 40,40 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M40,40 H200 A20,20 0 0 1 200,80 H40 A20,20 0 0 1 40,40 Z"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,60 L230,60"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M10,80 L230,80"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,80 A3,3 0 1 0 43,80 A3,3 0 1 0 37,80 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,80 A3,3 0 1 0 203,80 A3,3 0 1 0 197,80 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="men=Angled">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset" Data="M52,40 L212,40 188,80 28,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset" Data="M52,40 L212,40 188,80 28,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset" Data="M64,40 L224,40 200,80 40,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset" Data="M64,40 L224,40 200,80 40,80 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M200,40 L200,80"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Dim}" dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset" Data="M200,46 A14,14 0 0 1 207.2,48"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Dim}" dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset" Data="M200,66 A14,14 0 0 1 207.2,68"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,60 L230,60"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,60 A3,3 0 1 0 43,60 A3,3 0 1 0 37,60 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,60 A3,3 0 1 0 203,60 A3,3 0 1 0 197,60 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,80 L230,80"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M37,80 A3,3 0 1 0 43,80 A3,3 0 1 0 37,80 Z"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M197,80 A3,3 0 1 0 203,80 A3,3 0 1 0 197,80 Z"/>
                    </Canvas>
                    <TextBlock Style="{DynamicResource Dyl.Sketch.Text}" Text="angle" Canvas.Left="206" Canvas.Top="20"/>
                  </Canvas>
                  <TextBlock Style="{DynamicResource Dyl.Sketch.Ask}" dyl:Win.VisibleBy="men=Ask" FontSize="14" Text="Asked when drawn"/>
              </Grid>
            </Viewbox>
          </Border>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="men=Extended|Ask">
            <TextBox x:Name="mex" DockPanel.Dock="Right" Width="180"
                     dyl:Win.Check="empty;number;min=0"
                     dyl:Win.CheckMessage="The extension must be a number, 0 or more (empty: half the width)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Extension"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="men=Angled|Ask">
            <TextBox x:Name="mea" DockPanel.Dock="Right" Width="180"
                     dyl:Win.Check="number;min=-80;max=80"
                     dyl:Win.CheckMessage="The end angle must be a number from -80 to 80 (0: square)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Angle"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox Grid.Column="2" Header="Corners" Margin="0">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="mco" DockPanel.Dock="Right" Width="180"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Corners"/>
          </DockPanel>
          <Border Style="{DynamicResource Dyl.Sketch}">
            <Viewbox>
              <Grid Width="172" Height="137">
                  <Canvas dyl:Win.VisibleBy="mco=Mitered" Margin="-12,-4,0,0">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M30,105 L145,105 175,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchB}" dyl:Win.VisibleBy="mht!=Origin" Data="M145,105 L145,20 175,20 175,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mht=Origin" Data="M145,105 L145,20 175,20 175,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M30,105 L145,105 145,20 175,20 175,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjo=Interrupted" Data="M145,105 L175,135"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" dyl:Win.VisibleBy="mjo!=Interrupted,mht!=Origin" Data="M145,105 L175,135"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,120 L160,120 L160,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M157,120 A3,3 0 1 0 163,120 A3,3 0 1 0 157,120 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,105 L145,105 L145,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M142,105 A3,3 0 1 0 148,105 A3,3 0 1 0 142,105 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="mco=Beveled" Margin="-12,-4,0,0">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M30,105 L145,105 167.5,127.5 160,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchB}" dyl:Win.VisibleBy="mht!=Origin" Data="M145,105 L145,20 175,20 175,120 167.5,127.5 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mht=Origin" Data="M145,105 L145,20 175,20 175,120 167.5,127.5 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M30,105 L145,105 145,20 175,20 175,120 160,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" Data="M160,135 L175,135 175,120"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjo=Interrupted" Data="M145,105 L167.5,127.5"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" dyl:Win.VisibleBy="mjo!=Interrupted,mht!=Origin" Data="M145,105 L167.5,127.5"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,120 L160,120 L160,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M157,120 A3,3 0 1 0 163,120 A3,3 0 1 0 157,120 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,105 L145,105 L145,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M142,105 A3,3 0 1 0 148,105 A3,3 0 1 0 142,105 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="mco=Round" Margin="-12,-4,0,0">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M30,105 H145 L170.6,130.6 A15,15 0 0 1 160,135 H30 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchB}" dyl:Win.VisibleBy="mht!=Origin" Data="M145,105 V20 H175 V120 A15,15 0 0 1 170.6,130.6 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mht=Origin" Data="M145,105 V20 H175 V120 A15,15 0 0 1 170.6,130.6 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M30,105 H145 V20 H175 V120 A15,15 0 0 1 160,135 H30 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjo=Interrupted" Data="M145,105 L170.6,130.6"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" dyl:Win.VisibleBy="mjo!=Interrupted,mht!=Origin" Data="M145,105 L170.6,130.6"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,120 L160,120 L160,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M157,120 A3,3 0 1 0 163,120 A3,3 0 1 0 157,120 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,105 L145,105 L145,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M142,105 A3,3 0 1 0 148,105 A3,3 0 1 0 142,105 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="mco=Lapped,mlt=First" Margin="-12,-4,0,0">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M30,105 L175,105 175,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchB}" dyl:Win.VisibleBy="mht!=Origin" Data="M145,105 L145,20 175,20 175,105 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mht=Origin" Data="M145,105 L145,20 175,20 175,105 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M30,105 L145,105 145,20 175,20 175,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjo=Interrupted" Data="M145,105 L175,105"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" dyl:Win.VisibleBy="mjo!=Interrupted,mht!=Origin" Data="M145,105 L175,105"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,120 L160,120 L160,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M157,120 A3,3 0 1 0 163,120 A3,3 0 1 0 157,120 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,105 L145,105 L145,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M142,105 A3,3 0 1 0 148,105 A3,3 0 1 0 142,105 Z"/>
                    </Canvas>
                  </Canvas>
                  <Canvas dyl:Win.VisibleBy="mco=Lapped,mlt!=First" Margin="-12,-4,0,0">
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" Data="M30,105 L145,105 145,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchB}" dyl:Win.VisibleBy="mht!=Origin" Data="M145,20 L175,20 175,135 145,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.HatchA}" dyl:Win.VisibleBy="mht=Origin" Data="M145,20 L175,20 175,135 145,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" Data="M30,105 L145,105 145,20 175,20 175,135 30,135 Z"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Outline}" dyl:Win.VisibleBy="mjo=Interrupted" Data="M145,105 L145,135"/>
                    <Path Style="{DynamicResource Dyl.Sketch.Ghost}" dyl:Win.VisibleBy="mjo!=Interrupted,mht!=Origin" Data="M145,105 L145,135"/>
                    <Canvas dyl:Win.VisibleBy="mjs!=Edge,mht!=Edge,mth!=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,120 L160,120 L160,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M157,120 A3,3 0 1 0 163,120 A3,3 0 1 0 157,120 Z"/>
                    </Canvas>
                    <Canvas dyl:Win.VisibleBy="mjs=Edge;mht=Edge;mth=Offset">
                      <Path Style="{DynamicResource Dyl.Sketch.Center}" Data="M20,105 L145,105 L145,10"/>
                      <Path Style="{DynamicResource Dyl.Sketch.Point}" Data="M142,105 A3,3 0 1 0 148,105 A3,3 0 1 0 142,105 Z"/>
                    </Canvas>
                  </Canvas>
                  <TextBlock Style="{DynamicResource Dyl.Sketch.Ask}" dyl:Win.VisibleBy="mco=Ask" FontSize="14" Text="Asked when drawn"/>
              </Grid>
            </Viewbox>
          </Border>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mco=Mitered|Ask">
            <TextBox x:Name="mml" DockPanel.Dock="Right" Width="180"
                     dyl:Win.Check="number;min=1"
                     dyl:Win.CheckMessage="The miter limit must be a number, 1 or more (x the width)."/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Miter limit"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mco=Lapped|Ask">
            <ComboBox x:Name="mlt" DockPanel.Dock="Right" Width="180"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Lap"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox x:Name="mjo" DockPanel.Dock="Right" Width="180"/>
            <TextBlock Style="{DynamicResource Dyl.Label}" Text="Joints"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
    </Grid>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
