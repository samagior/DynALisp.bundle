  Opened over the Settings window by the open button of Display (dyl:Win.Open of
  Dyl-Settings.xaml), on its values: OK keeps them, saved with the other settings by Save.
  The display settings applied in every drawing while Display is on (Remote\Dyl-EnvColor.lsp):
  the model space background, the paper of the layouts, the theme of AutoCAD and the colours
  of its ribbon and palettes (DynALisp.Ribbon.dll, an experiment) and the band of colour of the
  file tabs by project or sheet set (the same plugin), first item of each: not set, the current
  value kept. More display settings go in this box, one row
  each (*dyl:setdisplay*, Dyl:SetDisplayVals, Dyl:SetWinGet).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Display" dyl:Win.Docs="Core\Dyl-Settings.htm">
  <StackPanel Margin="16,16,16,14" Width="380">
    <GroupBox Header="Display" Margin="0">
      <StackPanel>
        <TextBlock Style="{DynamicResource Dyl.Desc}" Text="Applied in every drawing."/>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="bkg" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Model space"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="lbk" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Layouts"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="thm" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Theme"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="rbn" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Ribbon"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
          <ComboBox x:Name="pal" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Palettes"/>
        </DockPanel>
        <DockPanel>
          <ComboBox x:Name="ftb" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="File tabs"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <DockPanel Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
      <TextBlock Style="{DynamicResource Dyl.Desc}" Margin="2,0,0,0" VerticalAlignment="Center" Text="Saved when Settings is saved."/>
    </DockPanel>
  </StackPanel>
</Window>
