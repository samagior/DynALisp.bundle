  Shown by c:Dyl-Dictionary (Apps\Utilities\Dyl-Dictionary.lsp): the words of a definitions file
  (Res\Dictionaries\<code>-def.csv) of the category, subcategory and type picked. Each line of
  lst: word, type, category, subcategory (shown), then the word and its forms, the same with
  its definition (searched), and what the Definition box shows (Win.Fills: the word, its
  forms, its definition, its class, its See also words). Words searches as it is typed, in
  the window (Win.Filter, accents and case ignored). The lists, Go to, Copy word (or a word
  double-clicked) and Clear close the window with their number and the Lisp shows it again:
  2 Dictionary, 3 Category, 4 Subcategory, 5 Type, 6 Go to, 7 Copy word, 9 Clear;
  8 Edit list... closes it and opens the file.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Dictionary" dyl:Win.Docs="Utilities\Dyl-Dictionary.htm">
  <Window.Resources>
    <GridLength x:Key="ColWord">260</GridLength>
    <GridLength x:Key="ColType">110</GridLength>
    <GridLength x:Key="ColCat">220</GridLength>
  </Window.Resources>
  <StackPanel Margin="14" Width="900">
    <GroupBox Header="Search" Margin="0">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <ComboBox x:Name="dic" DockPanel.Dock="Left" Width="110" Margin="0,0,12,0" dyl:Win.Close="2"/>
          <CheckBox x:Name="ind" DockPanel.Dock="Right" Content="Also in the definitions" Margin="16,4,0,4"/>
          <TextBox x:Name="src" Style="{DynamicResource Dyl.Search}" Tag="Words" MaxLength="128" dyl:Win.Filter="lst:4;ind:5"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="cat" Width="260" Margin="0,0,8,0" dyl:Win.Close="3"/>
          <ComboBox x:Name="sub" Width="300" Margin="0,0,8,0" dyl:Win.Close="4"/>
          <ComboBox x:Name="typ" Width="140" Margin="0,0,8,0" dyl:Win.Close="5"/>
          <Button x:Name="clr" Content="Clear" dyl:Win.Close="9"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Words">
      <StackPanel>
        <Grid Margin="6,0,24,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColWord}"/>
            <ColumnDefinition Width="{StaticResource ColType}"/>
            <ColumnDefinition Width="{StaticResource ColCat}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Word"/>
          <TextBlock Grid.Column="1" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Type"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Category"/>
          <TextBlock Grid.Column="3" Style="{DynamicResource Dyl.Sub}" Margin="0" Text="Subcategory"/>
        </Grid>
        <ListBox x:Name="lst" Height="320" dyl:Win.Close="7" dyl:Win.Fills="wrd:6,frm:7,def:8,cls:9,see:10">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColWord}"/>
                  <ColumnDefinition Width="{StaticResource ColType}"/>
                  <ColumnDefinition Width="{StaticResource ColCat}"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=0}"/>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=1}"/>
                <TextBlock Grid.Column="2" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=2}"/>
                <TextBlock Grid.Column="3" Foreground="{DynamicResource Dyl.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static dyl:Cell.Converter}, ConverterParameter=3}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="cnt" Style="{DynamicResource Dyl.Desc}" Margin="0,6,0,0"
                   dyl:Win.CountOf="lst" dyl:Win.CountText="{}{0} of {1} words"/>
      </StackPanel>
    </GroupBox>

    <!-- The word picked: its forms, its definition, its class, the words to see also: -->
    <GroupBox Header="Definition">
      <StackPanel>
        <TextBlock x:Name="wrd" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBlock x:Name="frm" Style="{DynamicResource Dyl.Desc}" Margin="0,0,0,6"/>
        <TextBlock x:Name="def" TextWrapping="Wrap" MinHeight="40" Margin="0,0,0,6"/>
        <TextBlock x:Name="cls" Style="{DynamicResource Dyl.Desc}" Margin="0,0,0,8"/>
        <DockPanel>
          <TextBlock x:Name="msg" DockPanel.Dock="Right" Foreground="{DynamicResource Dyl.Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="See also" Margin="0,0,12,0"/>
          <ComboBox x:Name="see" Width="300" Margin="0,0,8,0" dyl:Win.EnabledBy="see!=-1"/>
          <Button x:Name="jmp" Content="Go to" HorizontalAlignment="Left" dyl:Win.Close="6" dyl:Win.EnabledBy="see!=-1"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>

    <DockPanel Margin="0,12,0,0">
      <Button x:Name="cpy" DockPanel.Dock="Left" Margin="0" Content="_Copy word" dyl:Win.Close="7" dyl:Win.EnabledBy="lst!=-1"/>
      <Button x:Name="edt" DockPanel.Dock="Left" Content="_Edit list..." dyl:Win.Close="8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
        <Button Content="Close" IsCancel="True"/>
        <Button x:Name="docs" Content="Open Docs"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
