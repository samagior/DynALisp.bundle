<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dyl="clr-namespace:DynALisp.Windows"
        Title="DynALisp - Corners" dyl:Win.Docs="Draw\Dyl-QuickDrawEndsCorners.htm">
  <Window.Resources>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="14" Width="400">
    <GroupBox Header="Corners" Margin="0">
      <StackPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="mco" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Corners"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mco=Mitered|Ask">
          <TextBox x:Name="mml" DockPanel.Dock="Right" Width="180"
                   dyl:Win.Check="number;min=1"
                   dyl:Win.CheckMessage="The miter limit must be a number, 1 or more (x the width)."/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Miter limit"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}" dyl:Win.EnabledBy="mco=Lapped|Ask">
          <ComboBox x:Name="mlt" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Lap"/>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}">
          <ComboBox x:Name="mjo" DockPanel.Dock="Right" Width="180"/>
          <TextBlock Style="{DynamicResource Dyl.Label}" Text="Joints"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <TextBlock x:Name="error" Style="{DynamicResource Dyl.Error}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True"/>
      <Button Content="_Cancel" IsCancel="True"/>
      <Button x:Name="docs" Content="Open Docs"/>
    </StackPanel>
  </StackPanel>
</Window>
