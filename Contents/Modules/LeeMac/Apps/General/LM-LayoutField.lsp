;;  The commands above are child commands (Pst-*) of LM-LayoutField, run by their
;;  aliases or picked in its dialog (Dyl:ChildPicker, dynalisp.mnl).

;; Layout Field
;; Lists the Layout Field commands with their aliases and runs the one picked.

(defun c:LM-LayoutField ()
  (Dyl:ChildPicker "LM-LayoutField.lsp" "Layout Field" "Double-click a field (or OK)." '*lm-layoutfield:last*)
)
(princ)
