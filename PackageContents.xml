<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.0"
    ProductCode="[C481FFC8-87C5-4BB3-8529-5CA7B41EB8E6]"
>

    <!-- The live drop-downs of the ribbon (.NET 8: AutoCAD 2025 and later), loaded before
         the CUIx so that its MNL finds Dyl:RibbonPhase (Installer\Ribbon\Plugin): -->
    <Components Description="Ribbon drop-downs">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp ribbon drop-downs"
            ModuleName="./Contents/Resources/DynALisp.Ribbon.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <Components>
        <RuntimeRequirements
            OS="Win32|Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R18"
            SupportPath="./Contents/Resources"
        />
        <ComponentEntry
            AppName="DynALisp ribbon and startup"
            ModuleName="./Contents/Resources/DynALisp.cuix"
        />
    </Components>

</ApplicationPackage>