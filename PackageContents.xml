<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.1"
    ProductCode="[C481FFC8-87C5-4BB3-8529-5CA7B41EB8E6]"
>

    <!-- The live drop-downs and the translation of the ribbon (.NET 8: AutoCAD 2025 and
         later, Installer\Ribbon\Plugin), listed before the CUIx. It reads the settings it needs
         at startup itself and asks the Lisp side for the state of the drawing when AutoCAD is
         idle, so it never depends on a Lisp call made while DynALisp loads. -->

    <Components Description="Ribbon drop-downs">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp ribbon drop-downs"
            ModuleName="./Contents/Resources/DynALisp.Ribbon.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <!-- Clean startup of Dyl-Settings (Installer\Startup), the same code built for .NET 8
         (AutoCAD 2025 and later) and .NET Framework 4.8 (AutoCAD 2015 to 2024): -->
    <Components Description="Clean startup">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp clean startup"
            ModuleName="./Contents/Resources/DynALisp.Startup.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>
    <Components Description="Clean startup (.NET Framework)">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R20.0"
            SeriesMax="R24.3"
        />
        <ComponentEntry
            AppName="DynALisp clean startup (.NET Framework)"
            ModuleName="./Contents/Resources/Net48/DynALisp.Startup.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <Components>
        <RuntimeRequirements
            OS="Win32|Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R18"
            SupportPath="./Contents/Resources"
        />
        <ComponentEntry
            AppName="DynALisp ribbon and startup"
            ModuleName="./Contents/Resources/DynALisp.cuix"
        />
    </Components>

</ApplicationPackage>