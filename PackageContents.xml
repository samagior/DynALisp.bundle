<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.1"
    ProductCode="[C481FFC8-87C5-4BB3-8529-5CA7B41EB8E6]"
>

    <!-- The live drop-downs and the translation of the ribbon (.NET 8: AutoCAD 2025 and
         later, Installer\Ribbon\Plugin), listed before the CUIx. It reads the settings it needs
         at startup itself and asks the Lisp side for the state of the drawing when AutoCAD is
         idle, so it never depends on a Lisp call made while DynALisp loads. -->

    <Components Description="Ribbon drop-downs">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp ribbon drop-downs"
            ModuleName="./Contents/Resources/DynALisp.Ribbon.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <!-- Clean startup of Dyl-Settings (Installer\Startup), the same code built for .NET 8
         (AutoCAD 2025 and later) and .NET Framework 4.8 (AutoCAD 2015 to 2024): -->
    <Components Description="Clean startup">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp clean startup"
            ModuleName="./Contents/Resources/DynALisp.Startup.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>
    <Components Description="Clean startup (.NET Framework)">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R20.0"
            SeriesMax="R24.3"
        />
        <ComponentEntry
            AppName="DynALisp clean startup (.NET Framework)"
            ModuleName="./Contents/Resources/Net48/DynALisp.Startup.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <!-- The windows of DynALisp (Installer\Windows): WPF windows described by the .xaml files
         of the Res folders, shown from Lisp by (Dyl:Window file values). The same code built
         for .NET 8 (AutoCAD 2025 and later) and .NET Framework 4.8 (AutoCAD 2015 to 2024): -->
    <Components Description="Windows">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp windows"
            ModuleName="./Contents/Resources/DynALisp.Windows.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>
    <Components Description="Windows (.NET Framework)">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R20.0"
            SeriesMax="R24.3"
        />
        <ComponentEntry
            AppName="DynALisp windows (.NET Framework)"
            ModuleName="./Contents/Resources/Net48/DynALisp.Windows.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <!-- The simulation of a 2D detail (Installer\Simulation, Dyl-Simulation): reads the detail
         of a zone in the drawing and shows its grid, its problems and its results over it, from
         Lisp by (Dyl:SimulationRead ...). The same code built for .NET 8 (AutoCAD 2025 and
         later) and .NET Framework 4.8 (AutoCAD 2015 to 2024): -->
    <Components Description="Simulation">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R25.0"
        />
        <ComponentEntry
            AppName="DynALisp simulation"
            ModuleName="./Contents/Resources/DynALisp.Simulation.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>
    <Components Description="Simulation (.NET Framework)">
        <RuntimeRequirements
            OS="Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R20.0"
            SeriesMax="R24.3"
        />
        <ComponentEntry
            AppName="DynALisp simulation (.NET Framework)"
            ModuleName="./Contents/Resources/Net48/DynALisp.Simulation.dll"
            LoadOnAutoCADStartup="True"
        />
    </Components>

    <Components>
        <RuntimeRequirements
            OS="Win32|Win64"
            Platform="AutoCAD|AutoCAD*"
            SeriesMin="R20.0"
            SupportPath="./Contents/Resources"
        />
        <ComponentEntry
            AppName="DynALisp ribbon and startup"
            ModuleName="./Contents/Resources/DynALisp.cuix"
        />
    </Components>

</ApplicationPackage>