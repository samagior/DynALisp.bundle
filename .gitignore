# Personal and company tools module (MyTools, including JCA), never committed:
Contents/Modules/MyTools/

# User copies of the editable files (aliases, Startup Suite, presets...), see Dyl-UserFiles.
# Their defaults under Contents are the ones committed:
/User/

# AutoCAD backup files (.bak of a drawing, .bk1-.bk9 of a template or standards file):
*.bak
*.bk[1-9]

# AutoCAD temporary files: drawing locks, automatic saves, recovery and temp files,
# error, audit and plot reports:
*.dwl
*.dwl2
*.sv$
*.ac$
*.$a
*.$ac
*.adt
*.tmp
*.err
plot.log

# Lisp compilation files:
*.ob
*.pdb
*.prj

# Lisp application files:
*.fas
*.vlx

# Setups built by Installer\Build.ps1 (published as GitHub release assets):
/Releases/

# AutoCAD crash reports (Customer Error Reporting):
ErrorReports/

# Python bytecode of the ribbon scripts:
__pycache__/

# Build output of the ribbon plugin (Installer\Ribbon\Plugin) and the startup plugin
# (Installer\Startup): their DLLs are copied to Contents\Resources and committed there:
Installer/Ribbon/Plugin/bin/
Installer/Ribbon/Plugin/obj/
Installer/Startup/bin/
Installer/Startup/obj/
# Build output of the windows plugin (Installer\Windows, its DLLs committed in
# Contents\Resources) and of its pictures tool (Installer\Windows\Shots):
Installer/Windows/bin/
Installer/Windows/obj/
Installer/Windows/Shots/bin/
Installer/Windows/Shots/obj/
# Build output of the simulation plugin (Installer\Simulation, its DLLs committed in
# Contents\Resources), of its calculation library and of its tests:
Installer/Simulation/bin/
Installer/Simulation/obj/
Installer/Simulation/Core/bin/
Installer/Simulation/Core/obj/
Installer/Simulation/Tests/bin/
Installer/Simulation/Tests/obj/
