# Personal and company tools module (MyTools, including JCA), never committed:
Contents/Modules/MyTools/

# User copies of the editable files (aliases, Startup Suite, presets...), see Dyl-UserFiles.
# Their defaults under Contents are the ones committed:
/User/

# AutoCAD backup files (.bak of a drawing, .bk1-.bk9 of a template or standards file):
*.bak
*.bk[1-9]

# AutoCAD temporary files: drawing locks, automatic saves, recovery and temp files,
# error, audit and plot reports:
*.dwl
*.dwl2
*.sv$
*.ac$
*.$a
*.$ac
*.adt
*.tmp
*.err
plot.log

# Lisp compilation files:
*.ob
*.pdb
*.prj

# Lisp application files:
*.fas
*.vlx

# Setups built by Installer\Build.ps1 (published as GitHub release assets):
/Releases/
