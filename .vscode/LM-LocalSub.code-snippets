	// region Column Reference Functions
	"Number to Column": {
		"prefix": "Local>>LM:num->col",
		"body": [
			";; Number to Column  -  Lee Mac",
			";; Converts an integer into a column reference, e.g. 27 -> AA",
			";; n - [int] positive non-zero integer",
			"",
			"(defun Local>>LM:num->col (n) ",
			"  (if (< n 27) ",
			"    (chr (+ 64 n))",
			"    (strcat (Local>>LM:num->col (/ (1- n) 26)) (Local>>LM:num->col (1+ (rem (1- n) 26))))",
			"  )",
			")"
		],
		"description": "Converts an integer into a column reference, e.g. 27 -> AA\nn - [int] positive non-zero integer"
	},
	"Column to Number": {
		"prefix": "Local>>LM:col->num",
		"body": [
			";; Column to Number  -  Lee Mac",
			";; Converts a column reference into an integer, e.g. AA -> 27",
			";; c - [str] upper-case string representing column reference",
			"",
			"(defun Local>>LM:col->num (c / n) ",
			"  (if (= 1 (setq n (strlen c))) ",
			"    (- (ascii c) 64)",
			"    (+ (* 26 (Local>>LM:col->num (substr c 1 (1- n)))) (Local>>LM:col->num (substr c n)))",
			"  )",
			")"
		],
		"description": "Converts a column reference into an integer, e.g. AA -> 27\nc - [str] upper-case string representing column reference"
	},
