	"3-Point Arc": {
		"prefix": "Local>>LM:3PArc",
		"body": [
			";; 3-Point Arc  -  Lee Mac",
			";; Returns the center, start/end angle and radius of the arc defined by three supplied points.",
			"",
			"(defun Local>>LM:3PArc (p1 p2 p3 / cn m1 m2) ",
			"  (setq m1 (Local>>LM:mid p1 p2)",
			"        m2 (Local>>LM:mid p2 p3)",
			"  )",
			"  (if ",
			"    (setq cn (inters ",
			"               m1",
			"               (polar m1 (+ (angle p1 p2) (/ pi 2.)) 1.0)",
			"               m2",
			"               (polar m2 (+ (angle p2 p3) (/ pi 2.)) 1.0)",
			"               nil",
			"             )",
			"    )",
			"    (append (list cn) ",
			"            (if (Local>>LM:Clockwise-p p1 p2 p3) ",
			"              (list (angle cn p3) (angle cn p1))",
			"              (list (angle cn p1) (angle cn p3))",
			"            )",
			"            (list (distance cn p1))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the center, start/end angle and radius of the arc defined by three supplied points.\nRequires: Local>>LM:Clockwise-p, Local>>LM:mid"
	},
	"2-Circle Tangents": {
		"prefix": "Local>>LM:2CircleTangents",
		"body": [
			";; 2-Circle Tangents  -  Lee Mac",
			";; Returns the two groups of points for which a line from a point in",
			";; each group is tangent to both circles with centres c1,c2 and radii r1,r2",
			"",
			"(defun Local>>LM:2CircleTangents (c1 r1 c2 r2 / d1 d2 a1 a2) ",
			"  (if (< (abs (setq d1 (- r1 r2))) (setq d2 (distance c1 c2))) ",
			"    (progn ",
			"      (setq a1 (atan (sqrt (- (* d2 d2) (* d1 d1))) d1)",
			"            a2 (angle c1 c2)",
			"      )",
			"      (list ",
			"        (list (polar c1 (+ a2 a1) r1) (polar c1 (- a2 a1) r1))",
			"        (list (polar c2 (+ a2 a1) r2) (polar c2 (- a2 a1) r2))",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the two groups of points for which a line from a point in\neach group is tangent to both circles with centres c1,c2 and radii r1,r2"
	},
	"Point-Circle Tangents": {
		"prefix": "Local>>LM:PointCircleTangents",
		"body": [
			";; Point-Circle Tangents  -  Lee Mac",
			";; Returns the two points for which a line from 'pt' to each point returned",
			";; is tangent to the circle with centre c1 and radius r1",
			"",
			"(defun Local>>LM:PointCircleTangents (pt c1 r1 / a1 a2 d1) ",
			"  (if ",
			"    (< r1 ",
			"       (setq a1 (angle c1 pt)",
			"             d1 (distance pt c1)",
			"       )",
			"    )",
			"    (progn ",
			"      (setq a2 (atan (sqrt (- (* d1 d1) (* r1 r1))) r1))",
			"      (list ",
			"        (polar c1 (+ a1 a2) r1)",
			"        (polar c1 (- a1 a2) r1)",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the two points for which a line from 'pt' to each point returned\nis tangent to the circle with centre c1 and radius r1"
	},
	"Quadratic Solution": {
		"prefix": "Local>>LM:quad",
		"body": [
			";; Quadratic Solution  -  Lee Mac",
			";; Args: a,b,c - coefficients of ax^2 + bx + c = 0",
			"",
			"(defun Local>>LM:quad (a b c / d r) ",
			"  (cond ",
			"    ((equal 0.0 (setq d (- (* b b) (* 4.0 a c))) 1e-8)",
			"     (list (/ b (* -2.0 a)))",
			"    )",
			"    ((< 0 d)",
			"     (setq r (sqrt d))",
			"     (list (/ (- r b) (* 2.0 a)) (/ (- (- b) r) (* 2.0 a)))",
			"    )",
			"  )",
			")"
		],
		"description": "Args: a,b,c - coefficients of ax^2 + bx + c = 0"
	},
	"Least Common Multiple": {
