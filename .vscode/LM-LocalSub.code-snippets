	"Prime Factors": {
		"prefix": "Local>>LM:pf",
		"body": [
			";; Prime Factors  -  Lee Mac",
			";; Args: n - positive non-zero integer",
			"",
			"(defun Local>>LM:pf (n / m p r) ",
			"  (setq p 2)",
			"  (while (< 1 n) ",
			"    (while (zerop (rem n p)) ",
			"      (setq r (cons p r)",
			"            n (/ n p)",
			"      )",
			"    )",
			"    (if (< 1 (setq m (sqrt n)) (setq p (if (= p 2) 3 (+ 2 p)))) ",
			"      (setq r (cons n r)",
			"            n 0",
			"      )",
			"      (while (and (<= p m) (< 0 (rem n p))) ",
			"        (setq p (+ 2 p))",
			"      )",
			"    )",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Args: n - positive non-zero integer"
	},
	"Prime-p": {
		"prefix": "Local>>LM:prime-p",
		"body": [
			";; Prime-p  -  Lee Mac",
			";; Args: n - positive non-zero integer",
			"",
			"(defun Local>>LM:prime-p (n / m p) ",
			"  (or (= 2 n) ",
			"      (and ",
			"        (< 2 n)",
			"        (= 1 (rem n 2))",
			"        (progn ",
			"          (setq m (1+ (sqrt n))",
			"                p 3",
			"          )",
			"          (while (and (< p m) (< 0 (rem n p))) ",
			"            (setq p (+ 2 p))",
			"          )",
			"          (< m p)",
			"        )",
			"      )",
			"  )",
			")"
		],
		"description": "Args: n - positive non-zero integer"
	},
	"Factorial": {
		"prefix": "Local>>LM:n!",
		"body": [
			";; Factorial  -  Lee Mac",
			";; Args: n - positive integer",
			"",
			"(defun Local>>LM:n! (n / r) ",
			"  (setq r n)",
			"  (repeat (fix (- n 2)) (setq r (* r (setq n (1- n)))))",
			"  (if (< r 2) 1 r)",
			")"
		],
		"description": "Args: n - positive integer"
	},
	"Factorial (recursive version)": {
		"prefix": "Local>>LM:n!-rec",
		"body": [
			";; Factorial (recursive version)  -  Lee Mac",
			";; Args: n - positive integer",
			"",
			"(defun Local>>LM:n!-rec (n) ",
			"  (if (< n 2) 1 (* n (Local>>LM:n!-rec (1- n))))",
			")"
		],
		"description": "Args: n - positive integer"
	},
	"Factorial Division": {
		"prefix": "Local>>LM:n!/k!",
		"body": [
			";; Factorial Division  -  Lee Mac",
			";; Args: n,k - positive integers",
			"",
			"(defun Local>>LM:n!/k! (n k / m r) ",
			"  (cond ",
			"    ((= n k) 1)",
			"    ((setq r (max n k)",
			"           m r",
			"     )",
			"     (repeat (fix (1- (abs (- n k)))) (setq r (* r (setq m (1- m)))))",
			"     (if (< k n) r (/ 1.0 r))",
			"    )",
			"  )",
			")"
		],
		"description": "Args: n,k - positive integers\nRequires: Local>>LM:n!"
	},
	"Factorial Multiplication": {
		"prefix": "Local>>LM:n!k!",
		"body": [
			";; Factorial Multiplication  -  Lee Mac",
			";; Args: n,k - positive integers",
			"",
			"(defun Local>>LM:n!k! (n k / m) ",
			"  (setq m (n! (min n k)))",
			"  (* (Local>>LM:n!/k! (max n k) (min n k)) m m)",
			")"
		],
		"description": "Args: n,k - positive integers\nRequires: Local>>LM:n!"
	},
	"Complex Addition": {
