	"Least Common Multiple of List": {
		"prefix": "Local>>LM:lcml",
		"body": [
			";; Least Common Multiple of List  -  Lee Mac",
			";; Args: l - list of positive non-zero integers",
			"",
			"(defun Local>>LM:lcml (l) ",
