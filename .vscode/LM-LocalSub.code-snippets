			")"
		],
		"description": "Returns a list expressing the union of a set of lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl - a list of lists for which to return the union\nReturns:  A list of distinct items in the set of lists"
	},
	// region Load Linetypes
	"Load Linetypes": {
		"prefix": "Local>>LM:loadlinetypes",
		"body": [
			";; Load Linetypes  -  Lee Mac",
			";; Attempts to load a list of linetypes from any .lin files found in the support path.",
			";; Excludes known metric & imperial definition files based on the value of MEASUREMENT",
			";; lts - [lst] List of linetypes to load",
			";; rdf - [bol] If T, linetypes will be redefined from file if already loaded",
			";; Returns: [bol] T if all linetypes are loaded successfully, else nil",
			"",
			"(defun Local>>LM:loadlinetypes (lts rdf / com lst rtn val var) ",
			"  (cond ",
			"    ((not (or rdf (vl-some '(lambda (typ) (not (tblsearch \"ltype\" typ))) lts))))",
			"    ((if (zerop (getvar 'measurement)) ",
			"       (setq lst (mapcar 'strcase '(\"acadiso.lin\" \"iso.lin\"))) ;; Known metric .lin files",
			"       (setq lst (mapcar 'strcase '(\"acad.lin\" \"default.lin\"))) ;; Known imperial .lin files",
			"     )",
			"     (setq lst (vl-remove-if '(lambda (x) (member (strcase x) lst)) ",
			"                             (apply 'append ",
			"                                    (mapcar '(lambda (dir) (vl-directory-files dir \"*.lin\" 1)) ",
			"                                            (vl-remove \"\" (Local>>LM:str->lst (getenv \"ACAD\") \";\"))",
			"                                    )",
			"                             )",
			"               )",
			"     )",
			"     (if rdf ",
			"       (progn ",
			"         (setq var '(cmdecho expert)",
			"               val (mapcar 'getvar var)",
			"               com (cond (command-s) (vl-cmdf))",
			"         )",
			"         (mapcar 'setvar var '(0 5))",
			"       )",
			"     )",
			"     (setq rtn (apply 'and ",
			"                      (mapcar ",
			"                        '(lambda (typ) ",
			"                           (cond ",
			"                             ((not (tblsearch \"ltype\" typ))",
			"                              (vl-some ",
			"                                '(lambda (lin) ",
			"                                   (vl-catch-all-apply 'vla-load (list (Local>>LM:aclin) typ lin))",
			"                                   (tblsearch \"ltype\" typ)",
			"                                 )",
			"                                lst",
			"                              )",
			"                             )",
			"                             (rdf",
			"                              (vl-some ",
			"                                '(lambda (lin) ",
			"                                   (if (Local>>LM:ltdefined-p typ lin) ",
			"                                     (progn ",
			"                                       (com \"_.-linetype\" \"_L\" typ lin \"\")",
			"                                       (tblsearch \"ltype\" typ)",
			"                                     )",
			"                                   )",
			"                                 )",
			"                                lst",
			"                              )",
			"                             )",
			"                             (t)",
			"                           )",
			"                         )",
			"                        lts",
			"                      )",
			"               )",
			"     )",
			"     (mapcar 'setvar var val)",
			"     rtn",
			"    )",
			"  )",
			")"
		],
		"description": "Attempts to load a list of linetypes from any .lin files found in the support path.\nExcludes known metric & imperial definition files based on the value of MEASUREMENT\nlts - [lst] List of linetypes to load\nrdf - [bol] If T, linetypes will be redefined from file if already loaded\nReturns: [bol] T if all linetypes are loaded successfully, else nil\nRequires: Local>>LM:aclin, Local>>LM:ltdefined-p, Local>>LM:str->lst"
	},
	"Linetype Defined-p": {
		"prefix": "Local>>LM:ltdefined-p",
		"body": [
			";; Linetype Defined-p  -  Lee Mac",
			";; Returns T if the linetype is defined in the specified .lin file",
			";; ltp - [str] Linetype name",
			";; lin - [str] Filename of linetype definition file (.lin)",
			"",
			"(defun Local>>LM:ltdefined-p (ltp lin / str rtn) ",
			"  (if ",
			"    (and ",
			"      (setq lin (findfile lin))",
			"      (setq lin (open lin \"r\"))",
			"    )",
			"    (progn ",
			"      (setq ltp (strcat \"`*\" (strcase ltp) \"`,*\"))",
			"      (while ",
			"        (and (setq str (read-line lin)) ",
			"             (not (setq rtn (wcmatch (strcase str) ltp)))",
			"        )",
			"      )",
			"      (close lin)",
			"      rtn",
			"    )",
			"  )",
			")"
		],
		"description": "Returns T if the linetype is defined in the specified .lin file\nltp - [str] Linetype name\nlin - [str] Filename of linetype definition file (.lin)"
	},
	// region Mathematical Functions
	"Matrix Determinant (Laplace Formula)": {
		"prefix": "Local>>LM:detm",
		"body": [
			";; Matrix Determinant (Laplace Formula)  -  Lee Mac",
			";; Args: m - nxn matrix",
			"",
			"(defun Local>>LM:detm (m / i j) ",
			"  (setq i -1",
			"        j 0",
			"  )",
			"  (cond ",
			"    ((null (cdr m)) (caar m))",
			"    ((null (cddr m)) (- (* (caar m) (cadadr m)) (* (cadar m) (caadr m))))",
			"    ((apply '+ ",
			"            (mapcar ",
			"              '(lambda (c) ",
			"                 (setq j (1+ j))",
			"                 (* c ",
			"                    (setq i (- i))",
			"                    (Local>>LM:detm ",
			"                      (mapcar ",
			"                        '(lambda (x / k) ",
			"                           (setq k 0)",
			"                           (vl-remove-if '(lambda (y) (= j (setq k (1+ k)))) x)",
			"                         )",
			"                        (cdr m)",
			"                      )",
			"                    )",
			"                 )",
			"               )",
			"              (car m)",
			"            )",
			"     )",
			"    )",
			"  )",
			")"
		],
		"description": "Args: m - nxn matrix"
	},
	"Matrix Inverse": {
		"prefix": "Local>>LM:invm",
		"body": [
			";; Matrix Inverse  -  gile & Lee Mac",
			";; Uses Gauss-Jordan Elimination to return the inverse of a non-singular nxn matrix.",
			";; Args: m - nxn matrix",
			"",
			"(defun Local>>LM:invm (m / c f p r) ",
			"",
			"  (defun f (p m) ",
			"    (mapcar '(lambda (x) (mapcar '(lambda (a b) (- a (* (car x) b))) (cdr x) p)) m)",
			"  )",
			"  (setq m (mapcar 'append m (imat (length m))))",
			"  (while m ",
			"    (setq c (mapcar '(lambda (x) (abs (car x))) m))",
			"    (repeat (vl-position (apply 'max c) c) ",
			"      (setq m (append (cdr m) (list (car m))))",
			"    )",
			"    (if (equal 0.0 (caar m) 1e-14) ",
			"      (setq m nil",
			"            r nil",
			"      )",
			"      (setq p (mapcar '(lambda (x) (/ (float x) (caar m))) (cdar m))",
			"            m (f p (cdr m))",
			"            r (cons p (f p r))",
			"      )",
			"    )",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Uses Gauss-Jordan Elimination to return the inverse of a non-singular nxn matrix.\nArgs: m - nxn matrix"
	},
	"Identity Matrix": {
		"prefix": "Local>>LM:imat",
		"body": [
			";; Identity Matrix  -  Lee Mac",
			";; Args: n - matrix dimension",
			"",
			"(defun Local>>LM:imat (n / i j l m) ",
			"  (repeat (setq i n) ",
			"    (repeat (setq j n) ",
			"      (setq l (cons (if (= i j) 1.0 0.0) l)",
			"            j (1- j)",
			"      )",
			"    )",
			"    (setq m (cons l m)",
			"          l nil",
			"          i (1- i)",
			"    )",
			"  )",
			"  m",
			")"
		],
		"description": "Args: n - matrix dimension"
	},
	"Matrix Transpose": {
		"prefix": "Local>>LM:trp",
		"body": [
			";; Matrix Transpose  -  Doug Wilson",
			";; Args: m - nxn matrix",
			"",
			"(defun Local>>LM:trp (m) ",
			"  (apply 'mapcar (cons 'list m))",
			")"
		],
		"description": "Args: m - nxn matrix"
	},
	"Matrix Trace": {
		"prefix": "Local>>LM:trc",
		"body": [
			";; Matrix Trace  -  Lee Mac",
			";; Args: m - nxn matrix",
			"",
			"(defun Local>>LM:trc (m) ",
			"  (if m (+ (caar m) (Local>>LM:trc (mapcar 'cdr (cdr m)))) 0)",
			")"
		],
		"description": "Args: m - nxn matrix"
	},
	"Matrix x Matrix": {
		"prefix": "Local>>LM:mxm",
		"body": [
			";; Matrix x Matrix  -  Vladimir Nesterovsky",
			";; Args: m,n - nxn matrices",
			"",
			"(defun Local>>LM:mxm (m n) ",
			"  ((lambda (a) (mapcar '(lambda (r) (Local>>LM:mxv a r)) m)) (Local>>LM:trp n))",
			")"
		],
		"description": "Args: m,n - nxn matrices\nRequires: Local>>LM:mxv, Local>>LM:trp"
	},
	"Matrix + Matrix": {
		"prefix": "Local>>LM:m+m",
		"body": [
			";; Matrix + Matrix  -  Lee Mac",
			";; Args: m,n - nxn matrices",
			"",
			"(defun Local>>LM:m+m (m n) ",
			"  (mapcar '(lambda (r s) (mapcar '+ r s)) m n)",
			")"
		],
		"description": "Args: m,n - nxn matrices"
	},
	"Matrix x Scalar": {
		"prefix": "Local>>LM:mxs",
		"body": [
			";; Matrix x Scalar  -  Lee Mac",
			";; Args: m - nxn matrix, n - real scalar",
			"",
			"(defun Local>>LM:mxs (m s) ",
			"  (mapcar '(lambda (r) (mapcar '(lambda (n) (* n s)) r)) m)",
			")"
		],
		"description": "Args: m - nxn matrix, n - real scalar"
	},
	"Matrix x Vector": {
		"prefix": "Local>>LM:mxv",
		"body": [
			";; Matrix x Vector  -  Vladimir Nesterovsky",
			";; Args: m - nxn matrix, v - vector in R^n",
			"",
			"(defun Local>>LM:mxv (m v) ",
			"  (mapcar '(lambda (r) (apply '+ (mapcar '* r v))) m)",
			")"
		],
		"description": "Args: m - nxn matrix, v - vector in R^n"
	},
	"Vector x Scalar": {
		"prefix": "Local>>LM:vxs",
		"body": [
			";; Vector x Scalar  -  Lee Mac",
			";; Args: v - vector in R^n, s - real scalar",
			"",
			"(defun Local>>LM:vxs (v s) ",
			"  (mapcar '(lambda (n) (* n s)) v)",
			")"
		],
		"description": "Args: v - vector in R^n, s - real scalar"
	},
	"Vector Dot Product": {
		"prefix": "Local>>LM:vxv",
		"body": [
			";; Vector Dot Product  -  Lee Mac",
			";; Args: u,v - vectors in R^n",
			"",
			"(defun Local>>LM:vxv (u v) ",
			"  (apply '+ (mapcar '* u v))",
			")"
		],
		"description": "Args: u,v - vectors in R^n"
	},
	"Vector Cross Product": {
		"prefix": "Local>>LM:v^v",
		"body": [
			";; Vector Cross Product  -  Lee Mac",
			";; Args: u,v - vectors in R^3",
			"",
			"(defun Local>>LM:v^v (u v) ",
			"  (list ",
			"    (- (* (cadr u) (caddr v)) (* (cadr v) (caddr u)))",
			"    (- (* (car v) (caddr u)) (* (car u) (caddr v)))",
			"    (- (* (car u) (cadr v)) (* (car v) (cadr u)))",
			"  )",
			")"
		],
		"description": "Args: u,v - vectors in R^3"
	},
	"Unit Vector": {
		"prefix": "Local>>LM:vx1",
		"body": [
			";; Unit Vector  -  Lee Mac",
			";; Args: v - vector in R^2 or R^3",
			"",
			"(defun Local>>LM:vx1 (v) ",
			"  ((lambda (n) (if (equal 0.0 n 1e-10) nil (mapcar '/ v (list n n n)))) ",
			"    (distance '(0.0 0.0 0.0) v)",
			"  )",
			")"
		],
		"description": "Args: v - vector in R^2 or R^3"
	},
	"Vector Norm (R^n)": {
		"prefix": "Local>>LM:|v|",
		"body": [
			";; Vector Norm (R^n)  -  Lee Mac",
			";; Args: v - vector in R^n",
			"",
			"(defun Local>>LM:|v| (v) ",
			"  (sqrt (apply '+ (mapcar '* v v)))",
			")"
		],
		"description": "Args: v - vector in R^n"
	},
	"Unit Vector (R^n)": {
		"prefix": "Local>>LM:unit",
		"body": [
			";; Unit Vector (R^n)  -  Lee Mac",
			";; Args: v - vector in R^n",
			"",
			"(defun Local>>LM:unit (v) ",
			"  ((lambda (n) (if (equal 0.0 n 1e-10) nil (Local>>LM:vxs v (/ 1.0 n)))) (|v| v))",
			")"
		],
		"description": "Args: v - vector in R^n\nRequires: Local>>LM:vxs"
	},
	"Tangent": {
		"prefix": "Local>>LM:tan",
		"body": [
			";; Tangent  -  Lee Mac",
			";; Args: x - real",
			"",
			"(defun Local>>LM:tan (x) ",
			"  (if (not (equal 0.0 (cos x) 1e-10)) ",
			"    (/ (sin x) (cos x))",
			"  )",
			")"
		],
		"description": "Args: x - real"
	},
	"ArcSine": {
		"prefix": "Local>>LM:asin",
		"body": [
			";; ArcSine  -  Lee Mac",
			";; Args: -1 <= x <= 1",
			"",
			"(defun Local>>LM:asin (x) ",
			"  (if (<= -1.0 x 1.0) ",
			"    (atan x (sqrt (- 1.0 (* x x))))",
			"  )",
			")"
		],
		"description": "Args: -1 <= x <= 1"
	},
	"ArcCosine": {
		"prefix": "Local>>LM:acos",
		"body": [
			";; ArcCosine  -  Lee Mac",
			";; Args: -1 <= x <= 1",
			"",
			"(defun Local>>LM:acos (x) ",
			"  (if (<= -1.0 x 1.0) ",
			"    (atan (sqrt (- 1.0 (* x x))) x)",
			"  )",
			")"
		],
		"description": "Args: -1 <= x <= 1"
	},
	"Hyperbolic Sine": {
		"prefix": "Local>>LM:sinh",
		"body": [
			";; Hyperbolic Sine  -  Lee Mac",
			";; Args: x - real",
			"",
			"(defun Local>>LM:sinh (x) ",
			"  (/ (- (exp x) (exp (- x))) 2.0)",
			")"
		],
		"description": "Args: x - real"
	},
	"Hyperbolic Cosine": {
		"prefix": "Local>>LM:cosh",
		"body": [
			";; Hyperbolic Cosine  -  Lee Mac",
			";; Args: x - real",
			"",
			"(defun Local>>LM:cosh (x) ",
			"  (/ (+ (exp x) (exp (- x))) 2.0)",
			")"
		],
		"description": "Args: x - real"
	},
	"Hyperbolic Tangent": {
		"prefix": "Local>>LM:tanh",
		"body": [
			";; Hyperbolic Tangent  -  Lee Mac",
			";; Args: x - real",
			"",
			"(defun Local>>LM:tanh (x) ",
			"  (/ (sinh x) (cosh x))",
			")"
		],
		"description": "Args: x - real"
	},
	"Area Hyperbolic Sine": {
		"prefix": "Local>>LM:asinh",
		"body": [
			";; Area Hyperbolic Sine  -  Lee Mac",
			";; Args: x - real",
			"",
			"(defun Local>>LM:asinh (x) ",
			"  (log (+ x (sqrt (1+ (* x x)))))",
			")"
		],
		"description": "Args: x - real"
	},
	"Area Hyperbolic Cosine": {
		"prefix": "Local>>LM:acosh",
		"body": [
			";; Area Hyperbolic Cosine  -  Lee Mac",
			";; Args: 1 <= x",
			"",
			"(defun Local>>LM:acosh (x) ",
			"  (if (<= 1.0 x) ",
