		],
		"description": "Displays a DCL list box allowing the user to make a selection from the supplied data.\nmsg - [str] Dialog label\nlst - [lst] List of strings to display\nbit - [int] 1=allow multiple; 2=return indexes\nReturns: [lst] List of selected items/indexes, else nil"
	},
	// region List Box Functions
	"List Box: List Up": {
		"prefix": "Local>>LM:listup",
		"body": [
			";; List Box: List Up  -  Lee Mac",
			";; Shifts the items at the supplied indexes by one position to a lower index",
			";; idx - [lst] List of zero-based indexes",
			";; lst - [lst] List of items",
			";; Returns: [lst] List of ((idx) (lst)) following operation",
			"",
			"(defun Local>>LM:listup (idx lst / foo) ",
			"  (defun foo (cnt idx lst idx-out lst-out) ",
			"    (cond ",
			"      ((not (and idx lst))",
			"       (list (reverse idx-out) (append (reverse lst-out) lst))",
			"      )",
			"      ((= 0 (car idx))",
			"       (foo (1+ cnt) (mapcar '1- (cdr idx)) (cdr lst) (cons cnt idx-out) (cons (car lst) lst-out))",
			"      )",
			"      ((= 1 (car idx))",
			"       (foo (1+ cnt) (mapcar '1- (cdr idx)) (cons (car lst) (cddr lst)) (cons cnt idx-out) (cons (cadr lst) lst-out))",
			"      )",
			"      ((foo (1+ cnt) (mapcar '1- idx) (cdr lst) idx-out (cons (car lst) lst-out)))",
			"    )",
			"  )",
			"  (foo 0 idx lst nil nil)",
			")"
		],
		"description": "Shifts the items at the supplied indexes by one position to a lower index\nidx - [lst] List of zero-based indexes\nlst - [lst] List of items\nReturns: [lst] List of ((idx) (lst)) following operation"
	},
	"List Box: List Down": {
		"prefix": "Local>>LM:listdown",
		"body": [
			";; List Box: List Down  -  Lee Mac",
			";; Shifts the items at the supplied indexes by one position to a higher index",
			";; idx - [lst] List of zero-based indexes",
			";; lst - [lst] List of items",
			";; Returns: [lst] List of ((idx) (lst)) following operation",
			"",
			"(defun Local>>LM:listdown (idx lst / bar foo len) ",
			"  (setq len (length lst)",
			"        foo (lambda (x) (- len x 1))",
			"        bar (lambda (a b) (list (reverse (mapcar 'foo a)) (reverse b)))",
			"  )",
			"  (apply 'bar (apply 'Local>>LM:listup (bar idx lst)))",
			")"
		],
		"description": "Shifts the items at the supplied indexes by one position to a higher index\nidx - [lst] List of zero-based indexes\nlst - [lst] List of items\nReturns: [lst] List of ((idx) (lst)) following operation\nRequires: Local>>LM:listup"
	},
	"List Box: List Top": {
		"prefix": "Local>>LM:listtop",
		"body": [
			";; List Box: List Top  -  Lee Mac",
			";; Shifts the items at the supplied indexes to the lowest index",
			";; idx - [lst] List of zero-based indexes",
			";; lst - [lst] List of items",
			";; Returns: [lst] List of ((idx) (lst)) following operation",
			"",
			"(defun Local>>LM:listtop (idx lst / i) ",
			"  (setq i -1)",
			"  (list ",
			"    (mapcar '(lambda (x) (setq i (1+ i))) idx)",
			"    (append (mapcar '(lambda (x) (nth x lst)) idx) (Local>>LM:removeitems idx lst))",
			"  )",
			")"
		],
		"description": "Shifts the items at the supplied indexes to the lowest index\nidx - [lst] List of zero-based indexes\nlst - [lst] List of items\nReturns: [lst] List of ((idx) (lst)) following operation\nRequires: Local>>LM:removeitems"
	},
	"List Box: List Bottom": {
		"prefix": "Local>>LM:listbottom",
		"body": [
			";; List Box: List Bottom -  Lee Mac",
			";; Shifts the items at the supplied indexes to the highest index",
			";; idx - [lst] List of zero-based indexes",
			";; lst - [lst] List of items",
			";; Returns: [lst] List of ((idx) (lst)) following operation",
			"",
			"(defun Local>>LM:listbottom (idx lst / i) ",
			"  (setq i (length lst))",
			"  (list ",
			"    (reverse (mapcar '(lambda (x) (setq i (1- i))) idx))",
			"    (append (Local>>LM:removeitems idx lst) (mapcar '(lambda (x) (nth x lst)) idx))",
			"  )",
			")"
		],
		"description": "Shifts the items at the supplied indexes to the highest index\nidx - [lst] List of zero-based indexes\nlst - [lst] List of items\nReturns: [lst] List of ((idx) (lst)) following operation\nRequires: Local>>LM:removeitems"
	},
	"Remove Items": {
		"prefix": "Local>>LM:removeitems",
		"body": [
			";; Remove Items  -  Lee Mac",
			";; Removes the items at the supplied indexes from a given list",
			";; idx - [lst] List of zero-based indexes",
			";; lst - [lst] List from which items are to be removed",
			";; Returns: [lst] List with items at the supplied indexes removed",
			"",
			"(defun Local>>LM:removeitems (idx lst / i) ",
			"  (setq i -1)",
			"  (vl-remove-if '(lambda (x) (member (setq i (1+ i)) idx)) lst)",
			")"
		],
		"description": "Removes the items at the supplied indexes from a given list\nidx - [lst] List of zero-based indexes\nlst - [lst] List from which items are to be removed\nReturns: [lst] List with items at the supplied indexes removed"
	},
	// region List Box with Filter
	"Filtered List Box": {
		"prefix": "Local>>LM:filtlistbox",
		"body": [
			";; Filtered List Box  -  Lee Mac",
			";; Displays a list box interface from which the user may select one or more items.",
			";; Includes an edit box filter to enable the user to filter the displayed list of items.",
			";; msg - [str] List box dialog title",
			";; lst - [lst] List of strings to display in the list box",
			";; mtp - [bol] T=Allow multiple items; nil=Single item selection",
			";; Returns: [lst] List of selected items, else nil",
			"",
			"(defun Local>>LM:filtlistbox (msg lst mtp / _addlist dch dcl des rtn sel tmp) ",
			"",
			"  (defun _addlist (key lst) ",
			"    (start_list key)",
			"    (foreach x lst (add_list x))",
			"    (end_list)",
			"    lst",
			"  )",
			"",
			"  (if ",
			"    (and ",
			"      (setq dcl (vl-filename-mktemp nil nil \".dcl\"))",
			"      (setq des (open dcl \"w\"))",
			"      (write-line ",
			"        (strcat ",
			"          \"filtlistbox : dialog { label = \\\"\"",
			"          msg",
			"          \"\\\"; spacer;\"",
			"          \": list_box { key = \\\"lst\\\"; width = 50; fixed_width = true; height = 15; fixed_height = true; allow_accept = true; \"",
			"          \"multiple_select = \"",
			"          (if mtp \"true\" \"false\")",
			"          \"; }\"",
			"          \": edit_box { key = \\\"flt\\\"; width = 50; fixed_width = true; label = \\\"Filter:\\\"; }\"",
			"          \"spacer; ok_cancel; }\"",
			"        )",
			"        des",
			"      )",
			"      (not (close des))",
			"      (< 0 (setq dch (load_dialog dcl)))",
			"      (new_dialog \"filtlistbox\" dch)",
			"    )",
			"    (progn ",
			"      (_addlist \"lst\" (setq tmp lst))",
			"      (set_tile \"lst\" (setq rtn \"0\"))",
			"      (set_tile \"flt\" \"*\")",
			"      (action_tile \"lst\" \"(setq rtn \\$value)\")",
			"      (action_tile \"flt\" ",
			"                   (vl-prin1-to-string ",
			"                     '(progn",
			"                       (setq flt (strcat \"*\" (strcase \\$value) \"*\")",
			"                             sel (mapcar '(lambda (n) (nth n tmp)) (read (strcat \"(\" rtn \")\")))",
			"                       )",
			"                       (_addlist \"lst\" (setq tmp (vl-remove-if-not '(lambda (x) (wcmatch (strcase x) flt)) lst)))",
			"                       (set_tile \"lst\" ",
			"                                 (setq rtn (vl-string-trim \"()\" ",
			"                                                           (vl-princ-to-string ",
			"                                                             (cond ",
			"                                                               ((vl-sort ",
			"                                                                  (vl-remove nil ",
			"                                                                             (mapcar '(lambda (x) (vl-position x tmp)) ",
			"                                                                                     sel",
			"                                                                             )",
			"                                                                  )",
			"                                                                  '<",
			"                                                                )",
			"                                                               )",
			"                                                               ('(0))",
			"                                                             )",
			"                                                           )",
			"                                           )",
			"                                 )",
			"                       )",
			"                      )",
			"                   )",
			"      )",
			"      (setq rtn (if (= 1 (start_dialog)) ",
			"                  (mapcar '(lambda (x) (nth x tmp)) (read (strcat \"(\" rtn \")\")))",
			"                )",
			"      )",
			"    )",
			"  )",
			"  (if (< 0 dch) ",
			"    (setq dch (unload_dialog dch))",
			"  )",
			"  (if (and (= 'str (type dcl)) (findfile dcl)) ",
			"    (vl-file-delete dcl)",
			"  )",
			"  rtn",
			")"
		],
		"description": "Displays a list box interface from which the user may select one or more items.\nIncludes an edit box filter to enable the user to filter the displayed list of items.\nmsg - [str] List box dialog title\nlst - [lst] List of strings to display in the list box\nmtp - [bol] T=Allow multiple items; nil=Single item selection\nReturns: [lst] List of selected items, else nil"
	},
	// region List Difference
	"List Difference": {
		"prefix": "Local>>LM:ListDifference-r",
		"body": [
			";;-------------------=={ List Difference }==------------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in one list but not   ;;",
			";;  another, i.e. the relative complement: l1 \\ l2            ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - lists for which to return the difference          ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of items appearing exclusively in list l1  ;;",
			";;------------------------------------------------------------;;",
			";;  Recursive",
			"",
			"(defun Local>>LM:ListDifference-r (l1 l2) ",
			"  (if l1 ",
			"    (if (member (car l1) l2) ",
			"      (Local>>LM:ListDifference (cdr l1) l2)",
			"      (cons (car l1) (Local>>LM:ListDifference (cdr l1) l2))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns items appearing exclusively in one list but not\nanother, i.e. the relative complement: l1 \\ l2\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - lists for which to return the difference\nReturns:  List of items appearing exclusively in list l1\nRecursive\nRequires: Local>>LM:ListDifference"
	},
	"List Difference (2)": {
		"prefix": "Local>>LM:ListDifference",
		"body": [
			";;-------------------=={ List Difference }==------------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in one list but not   ;;",
			";;  another, i.e. the relative complement: l1 \\ l2            ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - lists for which to return the difference          ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of items appearing exclusively in list l1  ;;",
			";;------------------------------------------------------------;;",
			";;  Iterative",
			"",
			"(defun Local>>LM:ListDifference (l1 l2) ",
			"  (vl-remove-if '(lambda (x) (member x l2)) l1)",
			")"
		],
		"description": "Returns items appearing exclusively in one list but not\nanother, i.e. the relative complement: l1 \\ l2\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - lists for which to return the difference\nReturns:  List of items appearing exclusively in list l1\nIterative"
	},
	// region List Intersection
	"List Intersection": {
		"prefix": "Local>>LM:ListIntersection-r",
		"body": [
			";;-----------------=={ List Intersection }==------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the intersection of two lists   ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - Lists for which to return the intersection        ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of all items common to both lists        ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListIntersection-r (l1 l2) ",
			"  (if l1 ",
			"    (if (member (car l1) l2) ",
			"      (cons (car l1) (Local>>LM:ListIntersection (cdr l1) l2))",
			"      (Local>>LM:ListIntersection (cdr l1) l2)",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list expressing the intersection of two lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - Lists for which to return the intersection\nReturns:  A list of all items common to both lists\nRequires: Local>>LM:ListIntersection"
	},
	"List Intersection (2)": {
		"prefix": "Local>>LM:ListIntersection",
		"body": [
			";;-----------------=={ List Intersection }==------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the intersection of two lists   ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - Lists for which to return the intersection        ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of all items common to both lists        ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListIntersection (l1 l2) ",
			"  (vl-remove-if-not '(lambda (x) (member x l2)) l1)",
			")"
		],
		"description": "Returns a list expressing the intersection of two lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - Lists for which to return the intersection\nReturns:  A list of all items common to both lists"
	},
	// region List Symmetric Difference
	"List Symmetric Difference": {
		"prefix": "Local>>LM:ListSymDifference-r",
		"body": [
			";;--------------=={ List Symmetric Difference }==-------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in each list and not  ;;",
			";;  in their intersection.                                    ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - lists for which to return symmetric difference    ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of items in the set (l1\\l2)U(l2\\l1)        ;;",
			";;------------------------------------------------------------;;",
			";;  Recursive",
			"",
			"(defun Local>>LM:ListSymDifference-r (l1 l2 / sub) ",
			"  (defun sub (a b) ",
			"    (if a ",
			"      (if (member (car a) b) ",
			"        (sub (cdr a) b)",
			"        (cons (car a) (sub (cdr a) b))",
			"      )",
			"    )",
			"  )",
			"  (append (sub l1 l2) (sub l2 l1))",
			")"
		],
		"description": "Returns items appearing exclusively in each list and not\nin their intersection.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - lists for which to return symmetric difference\nReturns:  List of items in the set (l1\\l2)U(l2\\l1)\nRecursive"
	},
	"List Symmetric Difference (2)": {
		"prefix": "Local>>LM:ListSymDifference",
		"body": [
			";;--------------=={ List Symmetric Difference }==-------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in each list and not  ;;",
			";;  in their intersection.                                    ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - lists for which to return symmetric difference    ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of items in the set (l1\\l2)U(l2\\l1)        ;;",
			";;------------------------------------------------------------;;",
			";;  Iterative",
			"",
			"(defun Local>>LM:ListSymDifference (l1 l2) ",
			"  (append ",
			"    (vl-remove-if '(lambda (x) (member x l2)) l1)",
			"    (vl-remove-if '(lambda (x) (member x l1)) l2)",
			"  )",
			")"
		],
		"description": "Returns items appearing exclusively in each list and not\nin their intersection.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - lists for which to return symmetric difference\nReturns:  List of items in the set (l1\\l2)U(l2\\l1)\nIterative"
	},
	"Lists Symmetric Difference": {
		"prefix": "Local>>LM:ListsSymDifference-r",
		"body": [
			";;--------------=={ Lists Symmetric Difference }==------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in each list and not  ;;",
			";;  in the intersection of any pair of lists.                 ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l - list of lists for which to return the sym difference  ;;",
			";;------------------------------------------------------------;;",
			";;  Returns: List of (l1\\(l2Ul3U..UlN)U(l2\\(l1Ul3..UlN)U...   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListsSymDifference-r (l / sub) ",
			"  (defun sub (a b) ",
			"    (if a ",
			"      (if (vl-some '(lambda (x) (member (car a) x)) b) ",
			"        (sub (cdr a) b)",
			"        (cons (car a) (sub (cdr a) b))",
			"      )",
			"    )",
			"  )",
			"  (apply 'append ",
			"         (mapcar ",
			"           '(lambda (a / x) ",
			"              (setq x (sub a (cdr l))",
			"                    l (append (cdr l) (list a))",
			"              )",
			"              x",
			"            )",
			"           l",
			"         )",
			"  )",
			")"
		],
		"description": "Returns items appearing exclusively in each list and not\nin the intersection of any pair of lists.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl - list of lists for which to return the sym difference\nReturns: List of (l1\\(l2Ul3U..UlN)U(l2\\(l1Ul3..UlN)U..."
	},
	"Lists Symmetric Difference (2)": {
		"prefix": "Local>>LM:ListsSymDifference",
		"body": [
			";;--------------=={ Lists Symmetric Difference }==------------;;",
			";;                                                            ;;",
			";;  Returns items appearing exclusively in each list and not  ;;",
			";;  in the intersection of any pair of lists.                 ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l - list of lists for which to return the sym difference  ;;",
			";;------------------------------------------------------------;;",
			";;  Returns: List of (l1\\(l2Ul3U..UlN)U(l2\\(l1Ul3..UlN)U...   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListsSymDifference (l) ",
			"  (apply 'append ",
			"         (mapcar ",
			"           '(lambda (a / x) ",
			"              (setq x (vl-remove-if ",
			"                        '(lambda (b) (vl-some '(lambda (c) (member b c)) (cdr l)))",
			"                        a",
			"                      )",
			"              )",
			"              (setq l (append (cdr l) (list a)))",
			"              x",
			"            )",
			"           l",
			"         )",
			"  )",
			")"
		],
		"description": "Returns items appearing exclusively in each list and not\nin the intersection of any pair of lists.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl - list of lists for which to return the sym difference\nReturns: List of (l1\\(l2Ul3U..UlN)U(l2\\(l1Ul3..UlN)U..."
	},
	"ListsSymDifference-so": {
		"prefix": "Local>>LM:ListsSymDifference-so",
		"body": [
			"",
			"(defun Local>>LM:ListsSymDifference-so (l) ",
			"  (Local>>LM:ListDifference ",
			"    (Local>>LM:ListsUnion l)",
			"    (Local>>LM:ListsUnion ",
			"      (mapcar ",
			"        '(lambda (a) ",
			"           (apply 'append ",
			"                  (mapcar '(lambda (b) (Local>>LM:ListIntersection a b)) (setq l (cdr l)))",
			"           )",
			"         )",
			"        l",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:ListDifference, Local>>LM:ListIntersection, Local>>LM:ListsUnion"
	},
	// region List to String
	"List to String (Recursive)": {
		"prefix": "Local>>LM:lst->str",
		"body": [
			";; List to String (Recursive) -  Lee Mac",
			";; Concatenates each string in a supplied list, separated by a given delimiter",
			";; lst - [lst] List of strings to concatenate",
			";; del - [str] Delimiter string to separate each item",
			"",
			"(defun Local>>LM:lst->str (lst del) ",
			"  (if (cdr lst) ",
			"    (strcat (car lst) del (Local>>LM:lst->str (cdr lst) del))",
			"    (car lst)",
			"  )",
			")"
		],
		"description": "Concatenates each string in a supplied list, separated by a given delimiter\nlst - [lst] List of strings to concatenate\ndel - [str] Delimiter string to separate each item"
	},
	"List to String (Iterative)": {
		"prefix": "Local>>LM:lst->str~",
		"body": [
			";; List to String (Iterative) -  Lee Mac",
			";; Concatenates each string in a supplied list, separated by a given delimiter",
			";; lst - [lst] List of strings to concatenate",
			";; del - [str] Delimiter string to separate each item",
			"",
			"(defun Local>>LM:lst->str~ (lst del / str) ",
			"  (setq str (car lst))",
			"  (foreach itm (cdr lst) (setq str (strcat str del itm)))",
			"  str",
			")"
		],
		"description": "Concatenates each string in a supplied list, separated by a given delimiter\nlst - [lst] List of strings to concatenate\ndel - [str] Delimiter string to separate each item"
	},
	// region List Union
	"List Union": {
		"prefix": "Local>>LM:ListUnion-r",
		"body": [
			";;---------------------=={ List Union }==---------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the union of two lists          ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - Lists for which to return the union               ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of all distinct items in the two lists   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListUnion-r (l1 l2) ",
			"  ((lambda (f) (f (append l1 l2))) ",
			"    (lambda (l) (if l (cons (car l) (f (vl-remove (car l) (cdr l))))))",
			"  )",
			")"
		],
		"description": "Returns a list expressing the union of two lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - Lists for which to return the union\nReturns:  A list of all distinct items in the two lists"
	},
	"List Union (2)": {
		"prefix": "Local>>LM:ListUnion",
		"body": [
			";;---------------------=={ List Union }==---------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the union of two lists          ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l1,l2 - Lists for which to return the union               ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of all distinct items in the two lists   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListUnion (l1 l2 / x l) ",
			"  (setq l1 (append l1 l2))",
			"  (while (setq x (car l1)) ",
			"    (setq l  (cons x l)",
			"          l1 (vl-remove x l1)",
			"    )",
			"  )",
			"  (reverse l)",
			")"
		],
		"description": "Returns a list expressing the union of two lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl1,l2 - Lists for which to return the union\nReturns:  A list of all distinct items in the two lists"
	},
	"Lists Union": {
		"prefix": "Local>>LM:ListsUnion-r",
		"body": [
			";;---------------------=={ Lists Union }==--------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the union of a set of lists     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l - a list of lists for which to return the union         ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of distinct items in the set of lists    ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListsUnion-r (l) ",
			"  ((lambda (f) (f (apply 'append l))) ",
			"    (lambda (l) (if l (cons (car l) (f (vl-remove (car l) (cdr l))))))",
			"  )",
			")"
		],
		"description": "Returns a list expressing the union of a set of lists\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl - a list of lists for which to return the union\nReturns:  A list of distinct items in the set of lists"
	},
	"Lists Union (2)": {
		"prefix": "Local>>LM:ListsUnion",
		"body": [
			";;---------------------=={ Lists Union }==--------------------;;",
			";;                                                            ;;",
			";;  Returns a list expressing the union of a set of lists     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l - a list of lists for which to return the union         ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  A list of distinct items in the set of lists    ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ListsUnion (l / x u) ",
