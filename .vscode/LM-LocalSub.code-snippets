	// region Drawing Version
	"Drawing Version": {
		"prefix": "Local>>LM:dwgversion",
		"body": [
			";; Drawing Version  -  Lee Mac",
			";; Returns the version of the supplied filename (dwg/dws/dwt/dxf)",
			";; dwg - [str] Drawing filename",
			"",
			"(defun Local>>LM:dwgversion (dwg / des vrs) ",
			"  (cond ",
			"    ((not ",
			"       (and ",
			"         (setq dwg (findfile dwg))",
			"         (setq des (open dwg \"r\"))",
			"       )",
			"     )",
			"    )",
			"    ((wcmatch (strcase dwg t) \"*`.dw[gst]\")",
			"     (setq vrs (strcase (substr (read-line des) 1 6)))",
			"    )",
			"    ((wcmatch (strcase dwg t) \"*`.dxf\")",
			"     (repeat 7 (read-line des))",
			"     (setq vrs (strcase (read-line des)))",
			"    )",
			"  )",
			"  (if (= 'file (type des)) (close des))",
			"  (cdr ",
			"    (assoc vrs ",
			"           '((\"AC1032\" . \"2018\")",
			"             (\"AC1027\" . \"2013-2015\")",
			"             (\"AC1024\" . \"2010-2012\")",
			"             (\"AC1021\" . \"2007-2009\")",
			"             (\"AC1018\" . \"2004-2006\")",
			"             (\"AC1015\" . \"2000-2002\")",
			"             (\"AC1014\" . \"Release 14\")",
			"             (\"AC1012\" . \"Release 13\")",
			"             (\"AC1009\" . \"Release 11/12\")",
			"             (\"AC1006\" . \"Release 10\")",
			"             (\"AC1004\" . \"Release 9\")",
			"             (\"AC1003\" . \"Release 2.60\")",
			"             (\"AC1002\" . \"Release 2.50\")",
			"             (\"AC1001\" . \"Release 2.22\")",
			"             (\"AC2.22\" . \"Release 2.22\")",
			"             (\"AC2.21\" . \"Release 2.21\")",
			"             (\"AC2.10\" . \"Release 2.10\")",
			"             (\"AC1.50\" . \"Release 2.05\")",
			"             (\"AC1.40\" . \"Release 1.40\")",
			"             (\"AC1.2\" . \"Release 1.2\")",
			"             (\"MC0.0\" . \"Release 1.0\")",
			"            )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the version of the supplied filename (dwg/dws/dwt/dxf)\ndwg - [str] Drawing filename"
	},
	// region Dynamic Block Functions
	"Get Dynamic Block Property Value": {
		"prefix": "Local>>LM:getdynpropvalue",
		"body": [
			";; Get Dynamic Block Property Value  -  Lee Mac",
			";; Returns the value of a Dynamic Block property (if present)",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; prp - [str] Dynamic Block property name (case-insensitive)",
			"",
			"(defun Local>>LM:getdynpropvalue (blk prp) ",
			"  (setq prp (strcase prp))",
			"  (vl-some '(lambda (x) (if (= prp (strcase (vla-get-propertyname x))) (vlax-get x 'value))) ",
			"           (vlax-invoke blk 'getdynamicblockproperties)",
			"  )",
			")"
		],
		"description": "Returns the value of a Dynamic Block property (if present)\nblk - [vla] VLA Dynamic Block Reference object\nprp - [str] Dynamic Block property name (case-insensitive)"
	},
	"Set Dynamic Block Property Value": {
		"prefix": "Local>>LM:setdynpropvalue",
		"body": [
			";; Set Dynamic Block Property Value  -  Lee Mac",
			";; Modifies the value of a Dynamic Block property (if present)",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; prp - [str] Dynamic Block property name (case-insensitive)",
			";; val - [any] New value for property",
			";; Returns: [any] New value if successful, else nil",
			"",
			"(defun Local>>LM:setdynpropvalue (blk prp val) ",
			"  (setq prp (strcase prp))",
			"  (vl-some ",
			"    '(lambda (x) ",
			"       (if (= prp (strcase (vla-get-propertyname x))) ",
			"         (progn ",
			"           (vla-put-value x ",
			"                          (vlax-make-variant val (vlax-variant-type (vla-get-value x)))",
			"           )",
			"           (cond (val) (t))",
			"         )",
			"       )",
			"     )",
			"    (vlax-invoke blk 'getdynamicblockproperties)",
			"  )",
			")"
		],
		"description": "Modifies the value of a Dynamic Block property (if present)\nblk - [vla] VLA Dynamic Block Reference object\nprp - [str] Dynamic Block property name (case-insensitive)\nval - [any] New value for property\nReturns: [any] New value if successful, else nil"
	},
	"Set Dynamic Block Properties": {
		"prefix": "Local>>LM:setdynprops",
		"body": [
			";; Set Dynamic Block Properties  -  Lee Mac",
			";; Modifies values of Dynamic Block properties using a supplied association list.",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; lst - [lst] Association list of ((<Property> . <Value>) ... )",
			";; Returns: nil",
			"",
			"(defun Local>>LM:setdynprops (blk lst / itm) ",
			"  (setq lst (mapcar '(lambda (x) (cons (strcase (car x)) (cdr x))) lst))",
			"  (foreach x (vlax-invoke blk 'getdynamicblockproperties) ",
			"    (if (setq itm (assoc (strcase (vla-get-propertyname x)) lst)) ",
			"      (vla-put-value x (vlax-make-variant (cdr itm) (vlax-variant-type (vla-get-value x))))",
			"    )",
			"  )",
			")"
		],
		"description": "Modifies values of Dynamic Block properties using a supplied association list.\nblk - [vla] VLA Dynamic Block Reference object\nlst - [lst] Association list of ((<Property> . <Value>) ... )\nReturns: nil"
	},
	"Get Dynamic Block Property Allowed Values": {
		"prefix": "Local>>LM:getdynpropallowedvalues",
		"body": [
			";; Get Dynamic Block Property Allowed Values  -  Lee Mac",
			";; Returns the allowed values for a specific Dynamic Block property.",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; prp - [str] Dynamic Block property name (case-insensitive)",
			";; Returns: [lst] List of allowed values for property, else nil if no restrictions",
			"",
			"(defun Local>>LM:getdynpropallowedvalues (blk prp) ",
			"  (setq prp (strcase prp))",
			"  (vl-some ",
			"    '(lambda (x) (if (= prp (strcase (vla-get-propertyname x))) (vlax-get x 'allowedvalues)))",
			"    (vlax-invoke blk 'getdynamicblockproperties)",
			"  )",
			")"
		],
		"description": "Returns the allowed values for a specific Dynamic Block property.\nblk - [vla] VLA Dynamic Block Reference object\nprp - [str] Dynamic Block property name (case-insensitive)\nReturns: [lst] List of allowed values for property, else nil if no restrictions"
	},
	"Get Visibility Parameter Name": {
		"prefix": "Local>>LM:getvisibilityparametername",
		"body": [
			";; Get Visibility Parameter Name  -  Lee Mac",
			";; Returns the name of the Visibility Parameter of a Dynamic Block (if present)",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; Returns: [str] Name of Visibility Parameter, else nil",
			"",
			"(defun Local>>LM:getvisibilityparametername (blk / vis) ",
			"  (if ",
			"    (and ",
			"      (vlax-property-available-p blk 'effectivename)",
			"      (setq blk (vla-item ",
			"                  (vla-get-blocks (vla-get-document blk))",
			"                  (vla-get-effectivename blk)",
			"                )",
			"      )",
			"      (= :vlax-true (vla-get-isdynamicblock blk))",
			"      (= :vlax-true (vla-get-hasextensiondictionary blk))",
			"      (setq vis (vl-some ",
			"                  '(lambda (pair) ",
			"                     (if ",
			"                       (and ",
			"                         (= 360 (car pair))",
			"                         (= \"BLOCKVISIBILITYPARAMETER\" ",
			"                            (cdr (assoc 0 (entget (cdr pair))))",
			"                         )",
			"                       )",
			"                       (cdr pair)",
			"                     )",
			"                   )",
			"                  (dictsearch ",
			"                    (vlax-vla-object->ename (vla-getextensiondictionary blk))",
			"                    \"ACAD_ENHANCEDBLOCK\"",
			"                  )",
			"                )",
			"      )",
			"    )",
			"    (cdr (assoc 301 (entget vis)))",
			"  )",
			")"
		],
		"description": "Returns the name of the Visibility Parameter of a Dynamic Block (if present)\nblk - [vla] VLA Dynamic Block Reference object\nReturns: [str] Name of Visibility Parameter, else nil"
	},
	"Get Dynamic Block Visibility State": {
		"prefix": "Local>>LM:getvisibilitystate",
		"body": [
			";; Get Dynamic Block Visibility State  -  Lee Mac",
			";; Returns the value of the Visibility Parameter of a Dynamic Block (if present)",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; Returns: [str] Value of Visibility Parameter, else nil",
			"",
			"(defun Local>>LM:getvisibilitystate (blk / vis) ",
			"  (if (setq vis (Local>>LM:getvisibilityparametername blk)) ",
			"    (Local>>LM:getdynpropvalue blk vis)",
			"  )",
			")"
		],
		"description": "Returns the value of the Visibility Parameter of a Dynamic Block (if present)\nblk - [vla] VLA Dynamic Block Reference object\nReturns: [str] Value of Visibility Parameter, else nil\nRequires: Local>>LM:getdynpropvalue, Local>>LM:getvisibilityparametername"
	},
	"Set Dynamic Block Visibility State": {
		"prefix": "Local>>LM:SetVisibilityState",
		"body": [
			";; Set Dynamic Block Visibility State  -  Lee Mac",
			";; Sets the Visibility Parameter of a Dynamic Block (if present) to a specific value (if allowed)",
			";; blk - [vla] VLA Dynamic Block Reference object",
			";; val - [str] Visibility State Parameter value",
			";; Returns: [str] New value of Visibility Parameter, else nil",
			"",
			"(defun Local>>LM:SetVisibilityState (blk val / vis) ",
			"  (if ",
			"    (and ",
			"      (setq vis (Local>>LM:getvisibilityparametername blk))",
			"      (member (strcase val) (mapcar 'strcase (Local>>LM:getdynpropallowedvalues blk vis)))",
			"    )",
			"    (Local>>LM:setdynpropvalue blk vis val)",
			"  )",
			")"
		],
		"description": "Sets the Visibility Parameter of a Dynamic Block (if present) to a specific value (if allowed)\nblk - [vla] VLA Dynamic Block Reference object\nval - [str] Visibility State Parameter value\nReturns: [str] New value of Visibility Parameter, else nil\nRequires: Local>>LM:getdynpropallowedvalues, Local>>LM:getvisibilityparametername, Local>>LM:setdynpropvalue"
	},
	// region Edit Box
	"Edit Box": {
		"prefix": "Local>>LM:editbox",
		"body": [
			";; Edit Box  -  Lee Mac",
			";; Displays a DCL Edit Box to obtain a string from the user",
			";; str - [str] Initial value to display (\"\" for none)",
