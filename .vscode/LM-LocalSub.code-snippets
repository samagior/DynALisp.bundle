	},
	// region Add & Remove Support File Search Paths
	"Add Support File Search Paths": {
		"prefix": "Local>>LM:sfsp+",
		"body": [
			";; Add Support File Search Paths  -  Lee Mac",
			";; Adds a list of Support File Search Paths, excluding duplicates and invalid paths.",
			";; lst - [lst] list of paths to add, e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )",
			";; Returns: [str] \"ACAD\" Environment String following modification",
			"",
			"(defun Local>>LM:sfsp+ (lst) ",
			"  ((lambda (str lst) ",
			"     (if ",
			"       (setq lst (vl-remove-if ",
			"                   '(lambda (x) ",
			"                      (or (vl-string-search (strcase x) (strcase str)) ",
			"                          (not (findfile x))",
			"                      )",
			"                    )",
			"                   lst",
			"                 )",
			"       )",
			"       (setenv \"ACAD\" ",
			"               (strcat str \";\" (apply 'strcat (mapcar '(lambda (x) (strcat x \";\")) lst)))",
			"       )",
			"     )",
			"   ) ",
			"    (vl-string-right-trim \";\" (getenv \"ACAD\"))",
			"    (mapcar '(lambda (x) (vl-string-right-trim \"\\\\\" (vl-string-translate \"/\" \"\\\\\" x))) lst)",
			"  )",
			")"
		],
		"description": "Adds a list of Support File Search Paths, excluding duplicates and invalid paths.\nlst - [lst] list of paths to add, e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )\nReturns: [str] \"ACAD\" Environment String following modification"
	},
	"Add Support File Search Paths at 'n'": {
		"prefix": "Local>>LM:sfsp+n",
		"body": [
			";;  Add Support File Search Paths at 'n'  -  Lee Mac",
			";;  Adds a list of Support File Search Paths, excluding duplicates and invalid paths.",
			";;  lst - [lst] list of paths to add, e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )",
			";;  idx - [int] [optional] zero-based index at which to add new paths",
			";;  Returns: [str] \"ACAD\" Environment String following modification",
			"",
			"(defun Local>>LM:sfsp+n (lst idx / add) ",
			"",
			"  (defun add (str new idx / pos) ",
			"    (if (< 0 idx) ",
			"      (if (setq pos (vl-string-position 59 str)) ",
			"        (strcat (substr str 1 (1+ pos)) (add (substr str (+ pos 2)) new (1- idx)))",
			"        (strcat \";\" new)",
			"      )",
			"      (strcat new str \";\")",
			"    )",
			"  )",
			"  ((lambda (str lst) ",
			"     (if ",
			"       (setq lst (vl-remove-if ",
			"                   '(lambda (x) ",
			"                      (or (vl-string-search (strcase x) (strcase str)) ",
			"                          (not (findfile x))",
			"                      )",
			"                    )",
			"                   lst",
			"                 )",
			"       )",
			"       (setenv \"ACAD\" ",
			"               (add str (apply 'strcat (mapcar '(lambda (x) (strcat x \";\")) lst)) idx)",
			"       )",
			"     )",
			"   ) ",
			"    (vl-string-right-trim \";\" (getenv \"ACAD\"))",
			"    (mapcar '(lambda (x) (vl-string-right-trim \"\\\\\" (vl-string-translate \"/\" \"\\\\\" x))) lst)",
			"  )",
			")"
		],
		"description": "Adds a list of Support File Search Paths, excluding duplicates and invalid paths.\nlst - [lst] list of paths to add, e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )\nidx - [int] [optional] zero-based index at which to add new paths\nReturns: [str] \"ACAD\" Environment String following modification"
	},
	"Remove Support File Search Paths": {
		"prefix": "Local>>LM:sfsp-",
		"body": [
			";; Remove Support File Search Paths  -  Lee Mac",
			";; Removes a list of Support File Search Paths if present.",
			";; lst - [lst] list of paths to remove (case-insensitive), e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )",
			";; Returns: [str] \"ACAD\" Environment String following modification",
			"",
			"(defun Local>>LM:sfsp- (lst / pos str tmp) ",
			"  (setq str (strcat (vl-string-right-trim \";\" (getenv \"ACAD\")) \";\")",
			"        tmp str",
			"  )",
			"  (foreach pth lst ",
			"    (if (/= \"\" pth) ",
			"      (while (setq pos (vl-string-search (strcase (strcat pth \";\")) (strcase str))) ",
			"        (setq str (strcat (substr str 1 pos) (substr str (+ pos (strlen pth) 2))))",
			"      )",
			"    )",
			"  )",
			"  (if (/= tmp str) (setenv \"ACAD\" str))",
			")"
		],
		"description": "Removes a list of Support File Search Paths if present.\nlst - [lst] list of paths to remove (case-insensitive), e.g. '(\"C:\\\\Folder1\" \"C:\\\\Folder2\" ... )\nReturns: [str] \"ACAD\" Environment String following modification"
	},
	"Wildcard Remove Support File Search Paths": {
		"prefix": "Local>>LM:wcsfsp-",
		"body": [
			";; Wildcard Remove Support File Search Paths  -  Lee Mac",
			";; Removes all Support File Search Paths matching a supplied wildcard pattern.",
			";; pat - [str] Wildcard pattern (case-insensitive)",
			";; Returns: [str] \"ACAD\" Environment String following modification, else nil if unchanged",
			"",
			"(defun Local>>LM:wcsfsp- (pat / wcsfsp- str tmp) ",
			"",
			"  (defun wcsfsp- (str pat / pos) ",
			"    (cond ",
			"      ((or (= \"\" str) (not (setq pos (vl-string-position 59 str))))",
			"       str",
			"      )",
			"      ((wcmatch (strcase (substr str 1 pos)) (strcase pat))",
			"       (wcsfsp- (substr str (+ pos 2)) pat)",
			"      )",
			"      ((strcat (substr str 1 (+ 1 pos)) (wcsfsp- (substr str (+ pos 2)) pat)))",
			"    )",
			"  )",
			"",
			"  (setq tmp (strcat (vl-string-right-trim \";\" (getenv \"ACAD\")) \";\")",
			"        str (wcsfsp- tmp pat)",
			"  )",
			"  (if (/= tmp str) (setenv \"ACAD\" str))",
			")"
		],
		"description": "Removes all Support File Search Paths matching a supplied wildcard pattern.\npat - [str] Wildcard pattern (case-insensitive)\nReturns: [str] \"ACAD\" Environment String following modification, else nil if unchanged"
	},
	// region Apply to Block Objects
	"Apply to Block Objects": {
		"prefix": "Local>>LM:ApplytoBlockObjects",
		"body": [
			";; Apply to Block Objects  -  Lee Mac",
			";; Evaluates a supplied function on all objects in a block definition.",
			";; Arguments:",
			";; blks - VLA Block Collection in which block resides",
			";; name - Block name",
			";; func - function to apply to all objects in block",
			";; Returns a list of results of evaluating the function, else nil.",
			"",
			"(defun Local>>LM:ApplytoBlockObjects (blks name func / def result) ",
			"  (setq func (eval func))",
			"  (if (not (vl-catch-all-error-p (setq def (vl-catch-all-apply 'vla-item (list blks name))))) ",
			"    (vlax-for obj def (setq result (cons (func obj) result)))",
			"  )",
			"  (reverse result)",
			")"
		],
		"description": "Evaluates a supplied function on all objects in a block definition.\nArguments:\nblks - VLA Block Collection in which block resides\nname - Block name\nfunc - function to apply to all objects in block\nReturns a list of results of evaluating the function, else nil."
	},
	// region Assoc++ Functions
	"Assoc++": {
		"prefix": "Local>>LM:assoc++",
		"body": [
			";; Assoc++  -  Lee Mac",
			";; Increments the value of a key in an association list if present, else adds key to the list.",
			";; key - [any] Key of an element in the list",
			";; lst - [lst] Association list (may be nil)",
			"",
			"(defun Local>>LM:assoc++ (key lst / itm) ",
			"  (if (setq itm (assoc key lst)) ",
			"    (subst (cons key (1+ (cdr itm))) itm lst)",
			"    (cons (cons key 1) lst)",
			"  )",
			")"
		],
		"description": "Increments the value of a key in an association list if present, else adds key to the list.\nkey - [any] Key of an element in the list\nlst - [lst] Association list (may be nil)"
	},
	"Nested Assoc++": {
		"prefix": "Local>>LM:nassoc++",
		"body": [
			";; Nested Assoc++  -  Lee Mac",
			";; Increments the value of a key in an association list with possible nested structure,",
			";; or adds the set of keys to the list if not present.",
			";; key - [lst] List of keys & subkeys",
			";; lst - [lst] Association list (may be nil)",
			"",
			"(defun Local>>LM:nassoc++ (key lst / itm) ",
			"  (if key ",
			"    (if (setq itm (assoc (car key) lst)) ",
			"      (subst (cons (car key) (Local>>LM:nassoc++ (cdr key) (cdr itm))) itm lst)",
			"      (cons (cons (car key) (Local>>LM:nassoc++ (cdr key) nil)) lst)",
			"    )",
			"    (if lst (list (1+ (car lst))) '(1))",
			"  )",
			")"
		],
		"description": "Increments the value of a key in an association list with possible nested structure,\nor adds the set of keys to the list if not present.\nkey - [lst] List of keys & subkeys\nlst - [lst] Association list (may be nil)"
	},
	// region Attribute Functions
	"Get Attribute Value": {
		"prefix": "Local>>LM:vl-getattributevalue",
		"body": [
			";; Get Attribute Value  -  Lee Mac",
			";; Returns the value held by the specified tag within the supplied block, if present.",
			";; blk - [vla] VLA Block Reference Object",
			";; tag - [str] Attribute TagString",
			";; Returns: [str] Attribute value, else nil if tag is not found.",
			"",
			"(defun Local>>LM:vl-getattributevalue (blk tag) ",
			"  (setq tag (strcase tag))",
			"  (vl-some ",
			"    '(lambda (att) (if (= tag (strcase (vla-get-tagstring att))) (vla-get-textstring att)))",
			"    (vlax-invoke blk 'getattributes)",
			"  )",
			")"
		],
		"description": "Returns the value held by the specified tag within the supplied block, if present.\nblk - [vla] VLA Block Reference Object\ntag - [str] Attribute TagString\nReturns: [str] Attribute value, else nil if tag is not found."
	},
	"Set Attribute Value": {
		"prefix": "Local>>LM:vl-setattributevalue",
		"body": [
			";; Set Attribute Value  -  Lee Mac",
			";; Sets the value of the first attribute with the given tag found within the block, if present.",
			";; blk - [vla] VLA Block Reference Object",
			";; tag - [str] Attribute TagString",
			";; val - [str] Attribute Value",
			";; Returns: [str] Attribute value if successful, else nil.",
			"",
			"(defun Local>>LM:vl-setattributevalue (blk tag val) ",
			"  (setq tag (strcase tag))",
			"  (vl-some ",
			"    '(lambda (att) ",
			"       (if (= tag (strcase (vla-get-tagstring att))) ",
			"         (progn (vla-put-textstring att val) val)",
			"       )",
			"     )",
			"    (vlax-invoke blk 'getattributes)",
			"  )",
			")"
		],
		"description": "Sets the value of the first attribute with the given tag found within the block, if present.\nblk - [vla] VLA Block Reference Object\ntag - [str] Attribute TagString\nval - [str] Attribute Value\nReturns: [str] Attribute value if successful, else nil."
	},
	"Get Attribute Values": {
		"prefix": "Local>>LM:vl-getattributevalues",
		"body": [
			";; Get Attribute Values  -  Lee Mac",
			";; Returns an association list of attributes present in the supplied block.",
			";; blk - [vla] VLA Block Reference Object",
			";; Returns: [lst] Association list of ((<tag> . <value>) ... )",
			"",
			"(defun Local>>LM:vl-getattributevalues (blk) ",
			"  (mapcar '(lambda (att) (cons (vla-get-tagstring att) (vla-get-textstring att))) ",
			"          (vlax-invoke blk 'getattributes)",
			"  )",
			")"
		],
		"description": "Returns an association list of attributes present in the supplied block.\nblk - [vla] VLA Block Reference Object\nReturns: [lst] Association list of ((<tag> . <value>) ... )"
	},
	"Set Attribute Values": {
		"prefix": "Local>>LM:vl-setattributevalues",
		"body": [
			";; Set Attribute Values  -  Lee Mac",
			";; Sets attributes with tags found in the association list to their associated values.",
			";; blk - [vla] VLA Block Reference Object",
			";; lst - [lst] Association list of ((<tag> . <value>) ... )",
			";; Returns: nil",
			"",
			"(defun Local>>LM:vl-setattributevalues (blk lst / itm) ",
			"  (foreach att (vlax-invoke blk 'getattributes) ",
			"    (if (setq itm (assoc (vla-get-tagstring att) lst)) ",
			"      (vla-put-textstring att (cdr itm))",
			"    )",
			"  )",
			")"
		],
		"description": "Sets attributes with tags found in the association list to their associated values.\nblk - [vla] VLA Block Reference Object\nlst - [lst] Association list of ((<tag> . <value>) ... )\nReturns: nil"
	},
	"Get Attribute Value (2)": {
		"prefix": "Local>>LM:getattributevalue-r",
		"body": [
			";; Get Attribute Value  -  Lee Mac",
			";; Returns the value held by the specified tag within the supplied block, if present.",
			";; blk - [ent] Block (Insert) Entity Name",
			";; tag - [str] Attribute TagString",
			";; Returns: [str] Attribute value, else nil if tag is not found.",
			"",
			"(defun Local>>LM:getattributevalue-r (blk tag / enx) ",
			"  (if (and (setq blk (entnext blk)) (= \"ATTRIB\" (cdr (assoc 0 (setq enx (entget blk)))))) ",
			"    (if (= (strcase tag) (strcase (cdr (assoc 2 enx)))) ",
			"      (cdr (assoc 1 (reverse enx)))",
			"      (Local>>LM:getattributevalue-r blk tag)",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the value held by the specified tag within the supplied block, if present.\nblk - [ent] Block (Insert) Entity Name\ntag - [str] Attribute TagString\nReturns: [str] Attribute value, else nil if tag is not found."
	},
	"Get Attribute Value (3)": {
		"prefix": "Local>>LM:getattributevalue",
		"body": [
			";; Get Attribute Value  -  Lee Mac",
			";; Returns the value held by the specified tag within the supplied block, if present.",
			";; blk - [ent] Block (Insert) Entity Name",
			";; tag - [str] Attribute TagString",
			";; Returns: [str] Attribute value, else nil if tag is not found.",
			"",
			"(defun Local>>LM:getattributevalue (blk tag / val enx) ",
			"  (while ",
			"    (and ",
			"      (null val)",
			"      (setq blk (entnext blk))",
			"      (= \"ATTRIB\" (cdr (assoc 0 (setq enx (entget blk)))))",
			"    )",
			"    (if (= (strcase tag) (strcase (cdr (assoc 2 enx)))) ",
			"      (setq val (cdr (assoc 1 (reverse enx))))",
			"    )",
			"  )",
			")"
		],
