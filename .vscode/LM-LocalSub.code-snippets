	"List Clockwise-p": {
		"prefix": "Local>>LM:ListClockwise-p",
		"body": [
			";; List Clockwise-p - Lee Mac",
			";; Returns T if the point list is clockwise oriented",
			"",
			"(defun Local>>LM:ListClockwise-p (lst) ",
			"  (minusp ",
			"    (apply '+ ",
