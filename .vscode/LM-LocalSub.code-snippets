	},
	// region Get Layer Status
	"GetLayerStatus": {
		"prefix": "Local>>LM:GetLayerStatus",
		"body": [
			";;  GetLayerStatus  -  Lee Mac",
			";;  Returns a list of dotted pairs detailing the status of each layer in a drawing.",
			";;  Returns: [str] Full filename of file if found, else nil.",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com",
			"",
			"(defun Local>>LM:GetLayerStatus (/ FindBits List->String cAssoc IterateLayers) ",
			"",
			"  (defun FindBits (n / b) ",
			"    (if (< 0 n) ",
			"      (cons ",
			"        (setq b (expt 2 ",
			"                      (fix (/ (log n) (log 2)))",
			"                )",
			"        )",
			"        (FindBits (- n b))",
			"      )",
			"    )",
			"  )",
			"",
			"  (defun List->String (lst del) ",
			"    (if (cdr lst) ",
			"      (strcat (car lst) del (List->String (cdr lst) del))",
			"      (car lst)",
			"    )",
			"  )",
			"",
			"  (defun cAssoc (key lst) (cdr (assoc key lst)))",
			"",
			"  (defun IterateLayers (def) ",
			"    ((lambda (status) ",
			"       (if def ",
			"         (cons ",
			"           (cons (cAssoc 2 def) ",
			"                 (List->String ",
			"                   (apply 'append ",
			"                          (cons (list (if (minusp (cAssoc 62 def)) \"Off\" \"On\")) ",
			"                                (mapcar ",
			"                                  (function ",
			"                                    (lambda (c) (list (cAssoc c status)))",
			"                                  )",
			"                                  (FindBits (logand (cAssoc 70 def) (~ 112)))",
			"                                )",
			"                          )",
			"                   )",
			"                   \",\"",
			"                 )",
			"           )",
			"           (IterateLayers (tblnext \"LAYER\"))",
			"         )",
			"       )",
			"     ) ",
			"      '((1 . \"Frozen\")",
			"        (2 . \"Frozen in VP\")",
			"        (4 . \"Locked\")",
			"       )",
			"    )",
			"  )",
			"",
			"  (foreach x (IterateLayers (tblnext \"LAYER\" T)) ",
			"    (if (cdr x) (print x))",
			"  )",
			"  (princ)",
			")"
		],
		"description": "Returns a list of dotted pairs detailing the status of each layer in a drawing.\nReturns: [str] Full filename of file if found, else nil.\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com"
	},
	// region Get Syntax
	"Get Syntax": {
		"prefix": "Local>>LM:GetSyntax",
		"body": [
			";;--------------------=={ Get Syntax }==----------------------;;",
			";;                                                            ;;",
			";;  Returns a list of syntax for all defined commands in a    ;;",
			";;  supplied LISP file.                                       ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  file - filename of LISP file to read                      ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of defined commands in supplied LISP file  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:GetSyntax (file / _GetSyntax line syntax) ",
			"",
			"  (defun _GetSyntax (p s / x) ",
			"    (if (setq x (vl-string-search p s)) ",
			"      (cons ",
			"        (substr (setq s (substr s (+ x 1 (strlen p)))) ",
			"                1",
			"                (setq x (car ",
			"                          (vl-sort ",
			"                            (vl-remove 'nil ",
			"                                       (mapcar ",
			"                                         (function ",
			"                                           (lambda (d) (vl-string-position d s))",
			"                                         )",
			"                                         '(32 9 40 41)",
			"                                       )",
			"                            )",
			"                            '<",
			"                          )",
			"                        )",
			"                )",
			"        )",
			"        (if x (_GetSyntax p (substr s (1+ x))))",
			"      )",
			"    )",
			"  )",
			"",
			"  (if (setq file (open file \"r\")) ",
			"    (apply 'append ",
			"           (progn ",
			"             (while (setq line (read-line file)) ",
			"               (setq syntax (cons (_GetSyntax \"(DEFUN C:\" (strcase line)) syntax))",
			"             )",
			"             (setq file (close file))",
			"             (reverse syntax)",
			"           )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list of syntax for all defined commands in a\nsupplied LISP file.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nfile - filename of LISP file to read\nReturns:  List of defined commands in supplied LISP file"
	},
	// region Get True Content
	"Get True Content": {
		"prefix": "Local>>LM:GetTrueContent",
		"body": [
			";;------------------=={ Get True Content }==------------------;;",
			";;                                                            ;;",
			";;  Returns the unformatted string associated with the        ;;",
			";;  supplied entity, in formats compatible with Text & MText  ;;",
			";;  objects.                                                  ;;",
			";;                                                            ;;",
			";;  The arguments *dtextstring & *mtextstring should be       ;;",
			";;  supplied with quoted symbols (other than those symbols    ;;",
			";;  used by the arguments themselves). The unformatted        ;;",
			";;  strings suitable for Text & MText objects will henceforth ;;",
			";;  be bound to the supplied symbol arguments respectively.   ;;",
			";;                                                            ;;",
			";;  Note that it is the caller's responsibility to create and ;;",
			";;  release the RegularExpressions (Local>>gc:RegExp) object. This      ;;",
			";;  object may be created using the                           ;;",
			";;  Programmatic Identifier: \"VBScript.RegExp\".               ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  RegExp       - RegularExpressions (Local>>gc:RegExp) Object         ;;",
			";;  entity       - Ename whose text content is to be returned ;;",
			";;  *dtextstring - (output) Unformatted string compatible     ;;",
			";;                 with Text entities                         ;;",
			";;  *mtextstring - (output) Unformatted string compatible     ;;",
			";;                 with MText entities                        ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:    This function always returns nil              ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:GetTrueContent (Local>>gc:RegExp entity *dtextstring *mtextstring / _Replace _AllowsFormatting ",
			"                                  _GetTextString",
			"                                 ) ",
			"",
			"  (defun _Replace (new old string) ",
			"    (vlax-put-property RegExp 'pattern old)",
			"    (vlax-invoke RegExp 'replace string new)",
			"  )",
			"",
			"  (defun _AllowsFormatting (entity / object) ",
			"    (or (wcmatch (cdr (assoc 0 (entget entity))) \"MTEXT,MULTILEADER\") ",
			"        (and ",
			"          (eq \"ATTRIB\" (cdr (assoc 0 (entget entity))))",
			"          (vlax-property-available-p (setq object (vlax-ename->vla-object entity)) 'MTextAttribute)",
			"          (eq :vlax-true (vla-get-MTextAttribute object))",
			"        )",
			"    )",
			"  )",
			"",
			"  (defun _GetTextString (entity) ",
			"    ((lambda (entity / _type elist) ",
			"       (cond ",
			"         ((wcmatch (setq _type (cdr (assoc 0 (setq elist (entget entity))))) \"TEXT,*DIMENSION\")",
			"",
			"          (cdr (assoc 1 (reverse elist)))",
			"         )",
			"         ((eq \"MULTILEADER\" _type)",
			"",
			"          (cdr (assoc 304 elist))",
			"         )",
			"         ((wcmatch _type \"ATTRIB,MTEXT\")",
			"",
			"          ((lambda (string) ",
			"             (mapcar ",
			"               (function ",
			"                 (lambda (pair) ",
			"                   (if (member (car pair) '(1 3)) ",
			"                     (setq string (strcat string (cdr pair)))",
			"                   )",
			"                 )",
			"               )",
			"               elist",
			"             )",
			"             string",
			"           ) ",
			"            \"\"",
			"          )",
			"         )",
			"       )",
			"     ) ",
			"      (if (eq 'VLA-OBJECT (type entity)) ",
			"        (vlax-vla-object->ename entity)",
			"        entity",
			"      )",
			"    )",
			"  )",
			"",
			"  ((lambda (string) ",
			"     (if string ",
			"       (progn ",
			"         (mapcar ",
			"           (function ",
			"             (lambda (x) (vlax-put-property RegExp (car x) (cdr x)))",
			"           )",
			"           (list (cons 'global actrue) (cons 'ignorecase acfalse) (cons 'multiline actrue))",
			"         )",
			"         (if (_AllowsFormatting entity) ",
			"           (mapcar ",
			"             (function ",
			"               (lambda (x) (setq string (_Replace (car x) (cdr x) string)))",
			"             )",
			"             '((\"Ð\" . \"\\\\\\\\\\\\\\\\\")",
			"               (\" \" . \"\\\\\\\\P|\\\\n|\\\\t\")",
			"               (\"\\$1\" . \"\\\\\\\\(\\\\\\\\[ACcFfHLlOopQTW])|\\\\\\\\[ACcFfHLlOopQTW][^\\\\\\\\;]*;|\\\\\\\\[ACcFfHLlOopQTW]\")",
			"               (\"\\$1\\$2/\\$3\" . \"([^\\\\\\\\])\\\\\\\\S([^;]*)[/#\\\\^]([^;]*);\")",
			"               (\"\\$1\\$2\" . \"\\\\\\\\(\\\\\\\\S)|[\\\\\\\\](})|}\")",
			"               (\"\\$1\" . \"[\\\\\\\\]({)|{\")",
			"              )",
			"           )",
			"           (setq string (_Replace \"\" \"%%[OoUu]\" (_Replace \"Ð\" \"\\\\\\\\\" string)))",
			"         )",
			"         (set *mtextstring (_Replace \"\\\\\\\\\" \"Ð\" (_Replace \"\\\\\\$1\\$2\\$3\" \"(\\\\\\\\[ACcFfHLlOoPpQSTW])|({)|(})\" string)))",
			"         (set *dtextstring (_Replace \"\\\\\" \"Ð\" string))",
			"       )",
			"     )",
			"   ) ",
			"    (_GetTextString entity)",
			"  )",
			"  nil",
			")"
		],
		"description": "Returns the unformatted string associated with the\nsupplied entity, in formats compatible with Text & MText\nobjects.\nThe arguments *dtextstring & *mtextstring should be\nsupplied with quoted symbols (other than those symbols\nused by the arguments themselves). The unformatted\nstrings suitable for Text & MText objects will henceforth\nbe bound to the supplied symbol arguments respectively.\nNote that it is the caller's responsibility to create and\nrelease the RegularExpressions (Local>>gc:RegExp) object. This\nobject may be created using the\nProgrammatic Identifier: \"VBScript.RegExp\".\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\nRegExp       - RegularExpressions (Local>>gc:RegExp) Object\nentity       - Ename whose text content is to be returned\n*dtextstring - (output) Unformatted string compatible\nwith Text entities\n*mtextstring - (output) Unformatted string compatible\nwith MText entities\nReturns:    This function always returns nil"
	},
	// region Group List by Number
	"Group by Number (Recursive)": {
		"prefix": "Local>>LM:group<n-r",
		"body": [
			";; Group by Number (Recursive)  -  Lee Mac",
			";; Groups a list 'l' into a list of lists, each of max length 'n'",
			"",
			"(defun Local>>LM:group<n-r (l n) ",
			"  (if l (Local>>LM:group<n-sub (cons nil l) n n))",
			")"
		],
		"description": "Groups a list 'l' into a list of lists, each of max length 'n'\nRequires: Local>>LM:group<n-sub"
	},
	"group<n-sub": {
		"prefix": "Local>>LM:group<n-sub",
		"body": [
			"",
			"(defun Local>>LM:group<n-sub (l m n) ",
			"  (if (and (cdr l) (< 0 n)) ",
			"    (Local>>LM:group<n-sub (cons (cons (cadr l) (car l)) (cddr l)) m (1- n))",
			"    (cons (reverse (car l)) (Local>>LM:group<n (cdr l) m))",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:group<n"
	},
	"Group by Number": {
		"prefix": "Local>>LM:group<n",
		"body": [
			";; Group by Number  -  Lee Mac",
			";; Groups a list 'l' into a list of lists, each of max length 'n'",
			"",
			"(defun Local>>LM:group<n (l n / a b m) ",
			"  (while l ",
			"    (setq m n)",
			"    (while (and l (< 0 m)) ",
			"      (setq a (cons (car l) a)",
			"            l (cdr l)",
			"            m (1- m)",
			"      )",
			"    )",
			"    (setq b (cons (reverse a) b)",
			"          a nil",
			"    )",
			"  )",
			"  (reverse b)",
			")"
		],
		"description": "Groups a list 'l' into a list of lists, each of max length 'n'"
	},
	"Group by Number (Recursive) (2)": {
		"prefix": "Local>>LM:group-n-r",
		"body": [
			";; Group by Number (Recursive)  -  Lee Mac",
			";; Groups a list 'l' into a list of lists, each of length 'n'",
			"",
			"(defun Local>>LM:group-n-r (l n / r) ",
			"  (if l ",
			"    (cons ",
			"      (reverse ",
			"        (repeat n ",
			"          (setq r (cons (car l) r)",
			"                l (cdr l)",
			"          )",
			"          r",
			"        )",
			"      )",
