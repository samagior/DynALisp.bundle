	// region Colour Conversion Functions
	"RGB -> OLE": {
		"prefix": "Local>>LM:RGB->OLE",
		"body": [
			";; RGB -> OLE  -  Lee Mac",
			";; Args: r,g,b - [int] Red, Green, Blue values",
			"",
			"(defun Local>>LM:RGB->OLE (r g b) ",
			"  (logior (fix r) (lsh (fix g) 8) (lsh (fix b) 16))",
			")"
		],
		"description": "Args: r,g,b - [int] Red, Green, Blue values"
	},
	"OLE -> RGB": {
		"prefix": "Local>>LM:OLE->RGB",
		"body": [
			";; OLE -> RGB  -  Lee Mac",
			";; Args: c - [int] OLE Colour",
			"",
			"(defun Local>>LM:OLE->RGB (c) ",
			"  (mapcar '(lambda (x) (lsh (lsh (fix c) x) -24)) '(24 16 8))",
			")"
		],
		"description": "Args: c - [int] OLE Colour"
	},
	"RGB -> True": {
