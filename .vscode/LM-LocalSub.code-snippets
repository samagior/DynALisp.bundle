		"prefix": "Local>>LM:CopyBlockDefinition",
		"body": [
			";; Copy Block Definition  -  Lee Mac",
			";; Duplicates a block definition, with the copied definition assigned the name provided.",
			";; blk - [str] name of block definition to be duplicated",
			";; new - [str] name to be assigned to copied block definition",
			";; Returns the copied VLA Block Definition Object, else nil",
			"",
			"(defun Local>>LM:CopyBlockDefinition (blk new / abc app dbc dbx def doc rtn vrs) ",
			"  (setq dbx (vl-catch-all-apply 'vla-getinterfaceobject ",
			"                                (list (setq app (vlax-get-acad-object)) ",
			"                                      (if (< (setq vrs (atoi (getvar 'acadver))) 16) ",
			"                                        \"objectdbx.axdbdocument\"",
			"                                        (strcat \"objectdbx.axdbdocument.\" (itoa vrs))",
			"                                      )",
			"                                )",
			"            )",
			"  )",
			"  (cond ",
			"    ((or (null dbx) (vl-catch-all-error-p dbx))",
			"     (prompt \"\\nUnable to interface with ObjectDBX.\")",
			"    )",
			"    ((and ",
			"       (setq doc (vla-get-activedocument app)",
			"             abc (vla-get-blocks doc)",
			"             dbc (vla-get-blocks dbx)",
			"             def (Local>>LM:getitem abc blk)",
			"       )",
			"       (not (Local>>LM:getitem abc new))",
			"     )",
			"     (vlax-invoke doc 'copyobjects (list def) dbc)",
			"     (vla-put-name (setq def (Local>>LM:getitem dbc blk)) new)",
			"     (vlax-invoke dbx 'copyobjects (list def) abc)",
			"     (setq rtn (Local>>LM:getitem abc new))",
			"    )",
			"  )",
			"  (if (= 'vla-object (type dbx)) ",
			"    (vlax-release-object dbx)",
			"  )",
			"  rtn",
			")"
		],
		"description": "Duplicates a block definition, with the copied definition assigned the name provided.\nblk - [str] name of block definition to be duplicated\nnew - [str] name to be assigned to copied block definition\nReturns the copied VLA Block Definition Object, else nil\nRequires: Local>>LM:getitem"
	},
	// region Copy Folder
	"Copy Folder": {
		"prefix": "Local>>LM:copyfolder",
		"body": [
			";; Copy Folder  -  Lee Mac",
			";; Uses the CopyFolder method of the FileSystemObject (FSO) to recursively",
			";; copy a folder from one location to another.",
			";; src - [str] Directory to be copied",
			";; des - [str] Destination directory",
			";; ovr - [bol] T=overwrite existing files, nil=do not overwrite",
			";; Returns T if copy was successful, else nil",
			"",
			"(defun Local>>LM:copyfolder (src des ovr / fso rtn) ",
			"  (if (setq fso (vlax-create-object \"scripting.filesystemobject\")) ",
			"    (progn ",
			"      (setq rtn (not ",
			"                  (or (zerop (vlax-invoke fso 'folderexists src)) ",
			"                      (vl-catch-all-error-p ",
			"                        (vl-catch-all-apply 'vlax-invoke ",
			"                                            (list fso ",
			"                                                  'copyfolder",
			"                                                  src",
			"                                                  des",
			"                                                  (if ovr :vlax-true :vlax-false)",
			"                                            )",
			"                        )",
			"                      )",
			"                  )",
			"                )",
			"      )",
			"      (vlax-release-object fso)",
			"      rtn",
			"    )",
			"  )",
			")"
		],
		"description": "Uses the CopyFolder method of the FileSystemObject (FSO) to recursively\ncopy a folder from one location to another.\nsrc - [str] Directory to be copied\ndes - [str] Destination directory\novr - [bol] T=overwrite existing files, nil=do not overwrite\nReturns T if copy was successful, else nil"
	},
	"Copy Folder (2)": {
		"prefix": "Local>>LM:copyfolder~",
		"body": [
			";; Copy Folder  -  Lee Mac",
			";; Recursively copies the contents of a folder and the contents of any",
			";; subfolders to a destination directory; will not overwrite existing files.",
			";; src - [str] Directory to be copied",
			";; des - [str] Destination directory",
			";; Returns T if all files were copied successfully, else nil",
			";;  alternative to the above function",
			"",
			"(defun Local>>LM:copyfolder~ (src des) ",
			"  (vl-mkdir des)",
			"  (apply 'and ",
			"         (append ",
			"           (mapcar ",
			"             (function ",
			"               (lambda (file) ",
			"                 (vl-file-copy (strcat src \"\\\\\" file) (strcat des \"\\\\\" file))",
			"               )",
			"             )",
			"             (vl-directory-files src nil 1)",
			"           )",
			"           (mapcar ",
			"             (function ",
			"               (lambda (dir) ",
			"                 (Local>>LM:copyfolder (strcat src \"\\\\\" dir) (strcat des \"\\\\\" dir))",
			"               )",
			"             )",
			"             (vl-remove \".\" (vl-remove \"..\" (vl-directory-files src nil -1)))",
			"           )",
			"         )",
			"  )",
			")"
		],
		"description": "Recursively copies the contents of a folder and the contents of any\nsubfolders to a destination directory; will not overwrite existing files.\nsrc - [str] Directory to be copied\ndes - [str] Destination directory\nReturns T if all files were copied successfully, else nil\nalternative to the above function\nRequires: Local>>LM:copyfolder"
	},
	// region Create Directory
	"Create Directory": {
		"prefix": "Local>>LM:createdirectory",
		"body": [
			";; Create Directory  -  Lee Mac",
			";; dir - [str] directory to create (\"C:\\\\Folder1\\\\Folder2\")",
			";; Returns:  T if directory creation is successful, else nil",
			"",
			"(defun Local>>LM:createdirectory (dir) ",
			"  ((lambda (fun) ",
			"     ((lambda (lst) (fun (car lst) (cdr lst))) ",
			"       (vl-remove \"\" (Local>>LM:str->lst (vl-string-translate \"/\" \"\\\\\" dir) \"\\\\\"))",
			"     )",
			"   ) ",
			"    (lambda (root lst / dir) ",
			"      (if lst ",
			"        (if ",
			"          (or (vl-file-directory-p (setq dir (strcat root \"\\\\\" (car lst)))) ",
			"              (vl-mkdir dir)",
			"          )",
			"          (fun dir (cdr lst))",
			"        )",
			"      )",
			"    )",
			"  )",
			"  (vl-file-directory-p dir)",
			")"
		],
		"description": "dir - [str] directory to create (\"C:\\\\Folder1\\\\Folder2\")\nReturns:  T if directory creation is successful, else nil\nRequires: Local>>LM:str->lst"
	},
	// region DCL List Tile Dependency
	"DCL List-Tile Dependency": {
		"prefix": "Local>>LM:dcld:action",
		"body": [
			";; DCL List-Tile Dependency  -  Lee Mac",
			";; Configures action_tile statements for the list of keys to enabled dependency between the DCL tiles.",
			";; key     - [lst] List of DCL tile keys in order of dependency",
			";; lst-sym - [sym] Quoted variable containing list data",
			";; rtn-sym - [sym] Quoted variable containing initial selection indexes",
			"",
			"(defun Local>>LM:dcld:action (key lst-sym rtn-sym) ",
			"",
			"  (defun Local>>LM:dcld:addlist (key lst) ",
			"    (start_list key)",
			"    (foreach itm lst (add_list itm))",
			"    (end_list)",
			"  )",
			"  (defun Local>>LM:dcld:getlists (idx lst) ",
			"    (if (cdr idx) ",
			"      (cons (mapcar 'car lst) (Local>>LM:dcld:getlists (cdr idx) (cdr (nth (car idx) lst))))",
			"      lst",
			"    )",
			"  )",
			"  (defun Local>>LM:substnth (itm idx lst) ",
			"    (if lst ",
			"      (if (zerop idx) ",
			"        (cons itm (mapcar '(lambda (x) 0) (cdr lst)))",
			"        (cons (car lst) (Local>>LM:substnth itm (1- idx) (cdr lst)))",
			"      )",
			"    )",
			"  )",
			"  (defun Local>>LM:dcld:actions (key lst-sym rtn-sym lvl / fun) ",
			"    (setq fun (if (cdr key) ",
			"                (list 'lambda ",
			"                      '(val lst)",
			"                      (list 'setq rtn-sym (list 'Local>>LM:substnth '(atoi val) lvl rtn-sym))",
			"                      (list 'Local>>LM:dcld:addlist ",
			"                            (cadr key)",
			"                            (list 'nth (1+ lvl) (list 'Local>>LM:dcld:getlists rtn-sym 'lst))",
			"                      )",
			"                      (list ",
			"                        (Local>>LM:dcld:actions (cdr key) lst-sym rtn-sym (1+ lvl))",
			"                        (list 'set_tile (cadr key) \"0\")",
			"                        'lst",
			"                      )",
			"                )",
			"                (list 'lambda ",
			"                      '(val lst)",
			"                      (list 'setq rtn-sym (list 'Local>>LM:substnth '(atoi val) lvl rtn-sym))",
			"                )",
			"              )",
			"    )",
			"    (action_tile (car key) (vl-prin1-to-string (list fun '\\$value lst-sym)))",
			"    fun",
			"  )",
			"  (mapcar 'Local>>LM:dcld:addlist key (Local>>LM:dcld:getlists (eval rtn-sym) (eval lst-sym)))",
			"  ((eval (Local>>LM:dcld:actions key lst-sym rtn-sym 0)) ",
			"    (set_tile (car key) (itoa (car (eval rtn-sym))))",
			"    (eval lst-sym)",
			"  )",
			"  (princ)",
			")"
		],
		"description": "Configures action_tile statements for the list of keys to enabled dependency between the DCL tiles.\nkey     - [lst] List of DCL tile keys in order of dependency\nlst-sym - [sym] Quoted variable containing list data\nrtn-sym - [sym] Quoted variable containing initial selection indexes"
	},
	"DCL List-Tile Dependency (2)": {
		"prefix": "Local>>LM:dcld:getitems",
		"body": [
			";; DCL List-Tile Dependency  -  Get Items  -  Lee Mac",
			";; Returns a list of the items selected from each dependent list tile.",
			";; idx - [lst] List of selection indexes",
			";; lst - [lst] List data",
			"",
			"(defun Local>>LM:dcld:getitems (idx lst / tmp) ",
			"  (if (cdr idx) ",
			"    (cons (car (setq tmp (nth (car idx) lst))) (Local>>LM:dcld:getitems (cdr idx) (cdr tmp)))",
			"    (list (nth (car idx) (car lst)))",
			"  )",
			")"
		],
		"description": "Returns a list of the items selected from each dependent list tile.\nidx - [lst] List of selection indexes\nlst - [lst] List data"
	},
	// region Directory Files
	"Directory Files": {
		"prefix": "Local>>LM:directoryfiles",
		"body": [
			";; Directory Files  -  Lee Mac",
			";; Retrieves all files of a specified filetype residing in a directory (and subdirectories)",
			";; dir - [str] Root directory for which to return filenames",
			";; typ - [str] Optional filetype filter (DOS pattern)",
			";; sub - [bol] If T, subdirectories of the root directory are included",
			";; Returns: [lst] List of files matching the filetype criteria, else nil if none are found",
			"",
			"(defun Local>>LM:directoryfiles (dir typ sub) ",
			"  (setq dir (vl-string-right-trim \"\\\\\" (vl-string-translate \"/\" \"\\\\\" dir)))",
			"  (append (mapcar '(lambda (x) (strcat dir \"\\\\\" x)) (vl-directory-files dir typ 1)) ",
			"          (if sub ",
			"            (apply 'append ",
			"                   (mapcar ",
			"                     '(lambda (x) ",
			"                        (if (not (wcmatch x \"`.,`.`.\")) ",
			"                          (Local>>LM:directoryfiles (strcat dir \"\\\\\" x) typ sub)",
			"                        )",
			"                      )",
			"                     (vl-directory-files dir nil -1)",
			"                   )",
			"            )",
			"          )",
			"  )",
			")"
		],
		"description": "Retrieves all files of a specified filetype residing in a directory (and subdirectories)\ndir - [str] Root directory for which to return filenames\ntyp - [str] Optional filetype filter (DOS pattern)\nsub - [bol] If T, subdirectories of the root directory are included\nReturns: [lst] List of files matching the filetype criteria, else nil if none are found"
	},
