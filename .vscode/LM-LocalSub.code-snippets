	"Get Owner": {
		"prefix": "Local>>LM:getowner",
		"body": [
			";; Get Owner -  Lee Mac",
			";; A wrapper for the objectidtoobject method & ownerid property to enable",
			";; compatibility with 32-bit & 64-bit systems",
			"",
			"(defun Local>>LM:getowner (obj) ",
			"  (eval ",
			"    (list 'defun ",
			"          'Local>>LM:getowner",
			"          '(obj)",
			"          (if (vlax-method-applicable-p obj 'ownerid32) ",
			"            (list 'vla-objectidtoobject32 (Local>>LM:acdoc) '(vla-get-ownerid32 obj))",
			"            (list 'vla-objectidtoobject (Local>>LM:acdoc) '(vla-get-ownerid obj))",
			"          )",
			"    )",
			"  )",
			"  (Local>>LM:getowner obj)",
			")"
		],
		"description": "A wrapper for the objectidtoobject method & ownerid property to enable\ncompatibility with 32-bit & 64-bit systems\nRequires: Local>>LM:acdoc"
	},
	"Catch Apply": {
		"prefix": "Local>>LM:catchapply",
		"body": [
			";; Catch Apply  -  Lee Mac",
			";; Applies a function to a list of parameters and catches any exceptions.",
			"",
			"(defun Local>>LM:catchapply (fnc prm / rtn) ",
			"  (if (not (vl-catch-all-error-p (setq rtn (vl-catch-all-apply fnc prm)))) ",
			"    rtn",
			"  )",
			")"
		],
		"description": "Applies a function to a list of parameters and catches any exceptions."
	},
	"Sortents Table": {
		"prefix": "Local>>LM:sortentstable",
		"body": [
			";; Sortents Table  -  Lee Mac",
			";; Retrieves the Sortents Table object.",
			";; obj - [vla] Block Container Object",
			"",
			"(defun Local>>LM:sortentstable (obj / dic) ",
			"  (cond ",
			"    ((Local>>LM:catchapply ",
			"       'vla-item",
			"       (list (setq dic (vla-getextensiondictionary obj)) \"acad_sortents\")",
			"     )",
			"    )",
			"    ((Local>>LM:catchapply 'vla-addobject (list dic \"acad_sortents\" \"AcDbSortentsTable\")))",
			"  )",
			")"
		],
		"description": "Retrieves the Sortents Table object.\nobj - [vla] Block Container Object\nRequires: Local>>LM:catchapply"
	},
	"Safearray Variant": {
		"prefix": "Local>>LM:safearrayvariant",
		"body": [
			";; Safearray Variant  -  Lee Mac",
			";; Returns a populated safearray variant of a specified data type",
			";; typ - [int] Variant type enum (e.g. vlax-vbdouble)",
			";; lst - [lst] List of static type data",
			"",
			"(defun Local>>LM:safearrayvariant (typ lst) ",
			"  (vlax-make-variant ",
			"    (vlax-safearray-fill ",
			"      (vlax-make-safearray typ (cons 0 (1- (length lst))))",
			"      lst",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a populated safearray variant of a specified data type\ntyp - [int] Variant type enum (e.g. vlax-vbdouble)\nlst - [lst] List of static type data"
	},
	"Active Document": {
		"prefix": "Local>>LM:acdoc",
		"body": [
			";; Active Document  -  Lee Mac",
			";; Returns the VLA Active Document Object",
			"",
			"(defun Local>>LM:acdoc nil ",
			"  (eval (list 'defun 'Local>>LM:acdoc 'nil (vla-get-activedocument (vlax-get-acad-object))))",
			"  (Local>>LM:acdoc)",
			")"
		],
		"description": "Returns the VLA Active Document Object"
	},
	"ObjectID": {
		"prefix": "Local>>LM:ObjectID",
		"body": [
			";; ObjectID  -  Lee Mac",
			";; Returns a string containing the ObjectID of a supplied VLA-Object",
			";; Compatible with 32-bit & 64-bit systems",
			"",
			"(defun Local>>LM:ObjectID (obj) ",
			"  (eval ",
			"    (list 'defun ",
			"          'Local>>LM:ObjectID",
			"          '(obj)",
			"          (if ",
			"            (and ",
			"              (vl-string-search \"64\" (getenv \"PROCESSOR_ARCHITECTURE\"))",
			"              (vlax-method-applicable-p (vla-get-utility (Local>>LM:acdoc)) 'getobjectidstring)",
			"            )",
			"            (list 'vla-getobjectidstring (vla-get-utility (Local>>LM:acdoc)) 'obj ':vlax-false)",
			"            '(itoa (vla-get-objectid obj))",
			"          )",
			"    )",
			"  )",
			"  (Local>>LM:ObjectID obj)",
			")"
		],
		"description": "Returns a string containing the ObjectID of a supplied VLA-Object\nCompatible with 32-bit & 64-bit systems\nRequires: Local>>LM:acdoc"
	},
	"Linetypes Collection": {
		"prefix": "Local>>LM:aclin",
		"body": [
			";; Linetypes Collection  -  Lee Mac",
			";; Returns the VLA Linetypes Collection for the Active Document",
			"",
			"(defun Local>>LM:aclin nil ",
			"  (eval (list 'defun 'Local>>LM:aclin 'nil (vla-get-linetypes (vla-get-activedocument (vlax-get-acad-object)))))",
			"  (Local>>LM:aclin)",
			")"
		],
		"description": "Returns the VLA Linetypes Collection for the Active Document"
	},
	"Object List Bounding Box": {
		"prefix": "Local>>LM:objlstboundingbox",
		"body": [
			";; Object List Bounding Box  -  Lee Mac",
			";; Returns the lower-left and upper-right points of a rectangle bounding a list of objects",
			"",
			"(defun Local>>LM:objlstboundingbox (lst / llp ls1 ls2 urp) ",
			"  (foreach obj lst ",
			"    (vla-getboundingbox obj 'llp 'urp)",
			"    (setq ls1 (cons (vlax-safearray->list llp) ls1)",
			"          ls2 (cons (vlax-safearray->list urp) ls2)",
			"    )",
			"  )",
			"  (mapcar '(lambda (a b) (apply 'mapcar (cons a b))) '(min max) (list ls1 ls2))",
			")"
		],
		"description": "Returns the lower-left and upper-right points of a rectangle bounding a list of objects"
	},
	"Rotate Points": {
		"prefix": "Local>>LM:rotatepoints",
		"body": [
			";; Rotate Points  -  Lee Mac",
			";; Rotates a list of points about a supplied point by a given angle",
			"",
			"(defun Local>>LM:rotatepoints (lst bpt ang / mat vec) ",
			"  (setq mat (list ",
			"              (list (cos ang) (sin (- ang)) 0.0)",
			"              (list (sin ang) (cos ang) 0.0)",
			"              '(0.0 0.0 1.0)",
			"            )",
			"  )",
			"  (setq vec (mapcar '- bpt (Local>>gc:mxv mat bpt)))",
			"  (mapcar '(lambda (x) (mapcar '+ (Local>>gc:mxv mat x) vec)) lst)",
			")"
		],
		"description": "Rotates a list of points about a supplied point by a given angle"
	},
	"Remove With Fuzz": {
		"prefix": "Local>>LM:RemoveWithFuzz",
		"body": [
			";; Remove With Fuzz  -  Lee Mac",
			";; Removes items from a list which are equal to a supplied tolerance",
			"",
			"(defun Local>>LM:RemoveWithFuzz (l1 l2 fz) ",
			"  (vl-remove-if ",
			"    (function ",
			"      (lambda (a) ",
			"        (vl-some ",
			"          (function (lambda (b) (equal a b fz)))",
			"          l1",
			"        )",
			"      )",
			"    )",
			"    l2",
			"  )",
			")"
		],
		"description": "Removes items from a list which are equal to a supplied tolerance"
	},
	"Get Inside Angle": {
		"prefix": "Local>>LM:GetInsideAngle",
		"body": [
			";; Get Inside Angle  -  Lee Mac",
			";; Returns the smaller angle subtended by three points with vertex at p2",
			"",
			"(defun Local>>LM:GetInsideAngle (p1 p2 p3) ",
			"  ((lambda (a) (min a (- (+ pi pi) a))) ",
			"    (rem (+ pi pi (- (angle p2 p1) (angle p2 p3))) (+ pi pi))",
			"  )",
			")"
		],
		"description": "Returns the smaller angle subtended by three points with vertex at p2"
	}
}
