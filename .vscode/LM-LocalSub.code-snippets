	"Increment Alpha": {
		"prefix": "Local>>LM:incalpha",
		"body": [
			";; Increment Alpha  -  Lee Mac",
			";; Increments an uppercase alphabetical string by a given number of units, e.g. AX + 4 = BB",
			";; a - [str] uppercase alphabetical string",
			";; i - [int] integer increment",
			"",
			"(defun Local>>LM:incalpha (a i / c n) ",
			"  (if (< 0 i) ",
			"    (if (zerop (setq n (strlen a))) ",
			"      (Local>>LM:incalpha \"A\" (1- i))",
			"      (if (= 90 (setq c (ascii (substr a n)))) ",
			"        (Local>>LM:incalpha (strcat (Local>>LM:incalpha (substr a 1 (1- n)) 1) \"A\") (1- i))",
			"        (strcat (Local>>LM:incalpha (substr a 1 (1- n)) (/ (+ i c -65) 26)) ",
			"                (chr (+ 65 (rem (+ i c -65) 26)))",
			"        )",
			"      )",
			"    )",
			"    a",
			"  )",
			")"
		],
		"description": "Increments an uppercase alphabetical string by a given number of units, e.g. AX + 4 = BB\na - [str] uppercase alphabetical string\ni - [int] integer increment"
	},
	"Increment Alpha (2)": {
		"prefix": "Local>>LM:incalpha~",
		"body": [
			";; Increment Alpha  -  Lee Mac",
			";; Increments an uppercase alphabetical string by a given number of units, e.g. AX + 4 = BB",
			";; a - [str] uppercase alphabetical string",
			";; i - [int] integer increment",
			"",
			"(defun Local>>LM:incalpha~ (a i) ",
			"  ((lambda (f) (vl-list->string (reverse (f (reverse (vl-string->list a)) i)))) ",
			"    (lambda (l i) ",
			"      (if (< 0 i) ",
			"        (if (car l) ",
			"          (if (= 90 (car l)) ",
			"            (f (cons 65 (f (cdr l) 1)) (1- i))",
			"            (cons (+ 65 (rem (+ i (car l) -65) 26)) ",
			"                  (f (cdr l) (/ (+ i (car l) -65) 26))",
			"            )",
			"          )",
			"          (f '(65) (1- i))",
			"        )",
			"        l",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Increments an uppercase alphabetical string by a given number of units, e.g. AX + 4 = BB\na - [str] uppercase alphabetical string\ni - [int] integer increment"
	},
