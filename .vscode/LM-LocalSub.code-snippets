	// region Base Conversion Functions
	"Decimal to Base": {
		"prefix": "Local>>LM:dec->base",
		"body": [
			";; Decimal to Base  -  Lee Mac",
			";; Converts a decimal number to another base.",
			";; n - [int] decimal integer",
			";; b - [int] non-zero positive integer base",
			";; Returns: [str] Representation of decimal in specified base",
			"",
			"(defun Local>>LM:dec->base (n b) ",
			"  (if (< n b) ",
			"    (chr (+ n (if (< n 10) 48 55)))",
			"    (strcat (Local>>LM:dec->base (/ n b) b) (Local>>LM:dec->base (rem n b) b))",
			"  )",
			")"
		],
		"description": "Converts a decimal number to another base.\nn - [int] decimal integer\nb - [int] non-zero positive integer base\nReturns: [str] Representation of decimal in specified base"
	},
	"Base to Decimal": {
		"prefix": "Local>>LM:base->dec",
		"body": [
			";; Base to Decimal  -  Lee Mac",
			";; Converts an number in an arbitrary base to decimal.",
			";; n - [str] string representing number to convert",
			";; b - [int] base of input string",
			";; Returns: [int] Decimal representation of supplied number",
			"",
			"(defun Local>>LM:base->dec (n b / l) ",
			"  (if (= 1 (setq l (strlen n))) ",
			"    (- (ascii n) (if (< (ascii n) 65) 48 55))",
			"    (+ (* b (Local>>LM:base->dec (substr n 1 (1- l)) b)) (Local>>LM:base->dec (substr n l) b))",
			"  )",
			")"
		],
		"description": "Converts an number in an arbitrary base to decimal.\nn - [str] string representing number to convert\nb - [int] base of input string\nReturns: [int] Decimal representation of supplied number"
	},
	"Base to Decimal (2)": {
		"prefix": "Local>>LM:vl-base->dec",
		"body": [
			";; Base to Decimal  -  Lee Mac",
			";; Converts an number in an arbitrary base to decimal.",
			";; n - [str] string representing number to convert",
			";; b - [int] base of input string",
			";; Returns: [int] Decimal representation of supplied number",
			"",
			"(defun Local>>LM:vl-base->dec (n b) ",
			"  ((lambda (f) ",
			"     (f (mapcar '(lambda (x) (- x (if (< x 65) 48 55))) (reverse (vl-string->list n))))",
			"   ) ",
			"    (lambda (c) (if c (+ (* b (f (cdr c))) (car c)) 0))",
			"  )",
			")"
		],
		"description": "Converts an number in an arbitrary base to decimal.\nn - [str] string representing number to convert\nb - [int] base of input string\nReturns: [int] Decimal representation of supplied number"
	},
	"Base to Base": {
		"prefix": "Local>>LM:base->base",
		"body": [
			";; Base to Base  -  Lee Mac",
			";; Converts an number from one base to another.",
			";; n  - [str] string representing number to convert",
			";; b1 - [int] input base",
			";; b2 - [int] output base",
			"",
			"(defun Local>>LM:base->base (n b1 b2) ",
			"  (Local>>LM:dec->base (Local>>LM:base->dec n b1) b2)",
			")"
		],
		"description": "Converts an number from one base to another.\nn  - [str] string representing number to convert\nb1 - [int] input base\nb2 - [int] output base\nRequires: Local>>LM:base->dec, Local>>LM:dec->base"
	},
	// region Bounding Box
	"Bounding Box": {
		"prefix": "Local>>LM:boundingbox",
		"body": [
			";; Bounding Box  -  Lee Mac",
			";; Returns the point list describing the rectangular frame bounding the supplied object.",
			";; obj - [vla] VLA-Object",
			"",
			"(defun Local>>LM:boundingbox (obj / a b lst) ",
			"  (if ",
			"    (and ",
			"      (vlax-method-applicable-p obj 'getboundingbox)",
			"      (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list obj 'a 'b))))",
			"      (setq lst (mapcar 'vlax-safearray->list (list a b)))",
			"    )",
			"    (mapcar '(lambda (a) (mapcar '(lambda (b) ((eval b) lst)) a)) ",
			"            '((caar cadar)",
			"              (caadr cadar)",
			"              (caadr cadadr)",
			"              (caar cadadr)",
			"             )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the point list describing the rectangular frame bounding the supplied object.\nobj - [vla] VLA-Object"
	},
	// region Browse for Folder
	"Browse for Folder": {
		"prefix": "Local>>LM:browseforfolder",
		"body": [
			";; Browse for Folder  -  Lee Mac",
			";; Displays a dialog prompting the user to select a folder.",
			";; msg - [str] message to display at top of dialog",
			";; dir - [str] [optional] root directory (or nil)",
			";; bit - [int] bit-coded flag specifying dialog display settings",
			";; Returns: [str] Selected folder filepath, else nil.",
			"",
			"(defun Local>>LM:browseforfolder (msg dir bit / err fld pth shl slf) ",
			"  (setq err (vl-catch-all-apply ",
			"              (function ",
			"                (lambda (/ app hwd) ",
			"                  (if ",
			"                    (setq app (vlax-get-acad-object)",
			"                          shl (vla-getinterfaceobject app \"shell.application\")",
			"                          hwd (vl-catch-all-apply 'vla-get-hwnd (list app))",
			"                          fld (vlax-invoke-method shl ",
			"                                                  'browseforfolder",
			"                                                  (if (vl-catch-all-error-p hwd) 0 hwd)",
			"                                                  msg",
			"                                                  bit",
			"                                                  dir",
			"                              )",
			"                    )",
			"                    (setq slf (vlax-get-property fld 'self)",
			"                          pth (vlax-get-property slf 'path)",
			"                          pth (vl-string-right-trim \"\\\\\" ",
			"                                                    (vl-string-translate \"/\" \"\\\\\" pth)",
			"                              )",
			"                    )",
			"                  )",
			"                )",
			"              )",
			"            )",
			"  )",
			"  (if slf (vlax-release-object slf))",
			"  (if fld (vlax-release-object fld))",
			"  (if shl (vlax-release-object shl))",
			"  (if (vl-catch-all-error-p err) ",
			"    (prompt (vl-catch-all-error-message err))",
			"    pth",
			"  )",
			")"
		],
		"description": "Displays a dialog prompting the user to select a folder.\nmsg - [str] message to display at top of dialog\ndir - [str] [optional] root directory (or nil)\nbit - [int] bit-coded flag specifying dialog display settings\nReturns: [str] Selected folder filepath, else nil."
	},
	// region Bulge Conversion Functions
	"Arc to Bulge": {
		"prefix": "Local>>LM:arc->bulge",
		"body": [
			";; Arc to Bulge  -  Lee Mac",
			";; c     - center",
			";; a1,a2 - start, end angle",
			";; r     - radius",
			";; Returns: (<vertex> <bulge> <vertex>)",
			"",
			"(defun Local>>LM:arc->bulge (c a1 a2 r) ",
			"  (list ",
			"    (polar c a1 r)",
			"    ((lambda (a) (/ (sin a) (cos a))) ",
			"      (/ (rem (+ pi pi (- a2 a1)) (+ pi pi)) 4.0)",
			"    )",
			"    (polar c a2 r)",
			"  )",
			")"
		],
		"description": "c     - center\na1,a2 - start, end angle\nr     - radius\nReturns: (<vertex> <bulge> <vertex>)"
	},
	"3-Points to Bulge": {
		"prefix": "Local>>LM:3p->bulge",
		"body": [
			";; 3-Points to Bulge  -  Lee Mac",
			"",
			"(defun Local>>LM:3p->bulge (pt1 pt2 pt3) ",
			"  ((lambda (a) (/ (sin a) (cos a))) (/ (+ (- pi (angle pt2 pt1)) (angle pt2 pt3)) 2))",
			")"
		],
		"description": ""
	},
	"Bulge to Arc": {
		"prefix": "Local>>LM:Bulge->Arc",
		"body": [
			";; Bulge to Arc  -  Lee Mac",
			";; p1 - start vertex",
			";; p2 - end vertex",
			";; b  - bulge",
			";; Returns: (<center> <start angle> <end angle> <radius>)",
			"",
			"(defun Local>>LM:Bulge->Arc (p1 p2 b / a c r) ",
			"  (setq a (* 2 (atan b))",
			"        r (/ (distance p1 p2) 2 (sin a))",
			"        c (polar p1 (+ (- (/ pi 2) a) (angle p1 p2)) r)",
			"  )",
			"  (if (minusp b) ",
			"    (list c (angle c p2) (angle c p1) (abs r))",
			"    (list c (angle c p1) (angle c p2) (abs r))",
			"  )",
			")"
		],
		"description": "p1 - start vertex\np2 - end vertex\nb  - bulge\nReturns: (<center> <start angle> <end angle> <radius>)"
	},
	"Bulge to Arc (2)": {
		"prefix": "Local>>LM:Bulge->Arc~",
		"body": [
			";; Bulge to Arc  -  Lee Mac",
			";; p1 - start vertex",
			";; p2 - end vertex",
			";; b  - bulge",
			";; Returns: (<center> <start angle> <end angle> <radius>)",
			"",
			"(defun Local>>LM:Bulge->Arc~ (p1 p2 b / c r) ",
			"  (setq r (/ (* (distance p1 p2) (1+ (* b b))) 4 b)",
			"        c (polar p1 (+ (angle p1 p2) (- (/ pi 2) (* 2 (atan b)))) r)",
			"  )",
			"  (if (minusp b) ",
			"    (list c (angle c p2) (angle c p1) (abs r))",
			"    (list c (angle c p1) (angle c p2) (abs r))",
			"  )",
			")"
		],
		"description": "p1 - start vertex\np2 - end vertex\nb  - bulge\nReturns: (<center> <start angle> <end angle> <radius>)"
	},
	"Bulge Center": {
		"prefix": "Local>>LM:BulgeCenter",
		"body": [
			";; Bulge Center  -  Lee Mac",
			";; p1 - start vertex",
			";; p2 - end vertex",
			";; b  - bulge",
			";; Returns the center of the arc described by the given bulge and vertices",
			"",
			"(defun Local>>LM:BulgeCenter (p1 p2 b) ",
			"  (polar p1 ",
			"         (+ (angle p1 p2) (- (/ pi 2) (* 2 (atan b))))",
			"         (/ (* (distance p1 p2) (1+ (* b b))) 4 b)",
			"  )",
			")"
		],
		"description": "p1 - start vertex\np2 - end vertex\nb  - bulge\nReturns the center of the arc described by the given bulge and vertices"
	},
	"Bulge Radius": {
		"prefix": "Local>>LM:BulgeRadius",
		"body": [
			";; Bulge Radius  -  Lee Mac",
			";; p1 - start vertex",
			";; p2 - end vertex",
			";; b  - bulge",
			";; Returns the radius of the arc described by the given bulge and vertices",
			"",
			"(defun Local>>LM:BulgeRadius (p1 p2 b) ",
			"  (/ (* (distance p1 p2) (1+ (* b b))) 4 (abs b))",
			")"
		],
		"description": "p1 - start vertex\np2 - end vertex\nb  - bulge\nReturns the radius of the arc described by the given bulge and vertices"
	},
	// region Clockwise-p
	"Clockwise-p (Standard": {
		"prefix": "Local>>LM:Clockwise-p",
		"body": [
			";; Clockwise-p (Standard - Version 1)  -  Lee Mac",
			";; Returns T if p1,p2,p3 are clockwise oriented",
			"",
			"(defun Local>>LM:Clockwise-p (p1 p2 p3) ",
			"  ((lambda (n) (< (car (trans p2 0 n)) (car (trans p1 0 n)))) (mapcar '- p1 p3))",
			")"
		],
		"description": "Returns T if p1,p2,p3 are clockwise oriented"
	},
	"Clockwise-p (Version 1)": {
		"prefix": "Local>>LM:Clockwise-p1",
		"body": [
			";; Clockwise-p (Version 1)  -  Lee Mac",
			";; Returns T if p1,p2,p3 are clockwise oriented",
			"",
			"(defun Local>>LM:Clockwise-p1 (p1 p2 p3) ",
			"  ((lambda (n) (< (car (trans p2 0 n)) (car (trans p1 0 n)))) (mapcar '- p1 p3))",
			")"
		],
		"description": "Returns T if p1,p2,p3 are clockwise oriented"
	},
	"Clockwise-p (Version 2)": {
		"prefix": "Local>>LM:Clockwise-p2",
		"body": [
			";; Clockwise-p (Version 2)  -  Lee Mac",
			";; Returns T if p1,p2,p3 are clockwise oriented",
			"",
			"(defun Local>>LM:Clockwise-p2 (p1 p2 p3) ",
			"  (< (* (- (car p2) (car p1)) (- (cadr p3) (cadr p1))) ",
			"     (* (- (cadr p2) (cadr p1)) (- (car p3) (car p1)))",
			"  )",
			")"
		],
		"description": "Returns T if p1,p2,p3 are clockwise oriented"
	},
	"Clockwise-p (Version 3)": {
		"prefix": "Local>>LM:clockwise-p3",
		"body": [
			";; Clockwise-p (Version 3)  -  gile",
			";; Returns T if p1,p2,p3 are clockwise oriented",
			"",
			"(defun Local>>LM:clockwise-p3 (p1 p2 p3) ",
			"  (< (sin (- (angle p1 p3) (angle p1 p2))) -1e-14)",
			")"
		],
		"description": "Returns T if p1,p2,p3 are clockwise oriented"
	},
