			"",
			"(defun Local>>LM:Collinear-p (p1 p2 p3) ",
			"  ((lambda (a b c) ",
			"     (or ",
			"       (equal (+ a b) c 1e-8)",
			"       (equal (+ b c) a 1e-8)",
			"       (equal (+ c a) b 1e-8)",
			"     )",
			"   ) ",
			"    (distance p1 p2)",
			"    (distance p2 p3)",
			"    (distance p1 p3)",
			"  )",
			")"
