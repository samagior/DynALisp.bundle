	"RGB -> HSL": {
		"prefix": "Local>>LM:RGB->HSL",
		"body": [
			";; RGB -> HSL  -  Lee Mac",
			";; Args: r,g,b - [int] Red, Green, Blue values",
			"",
			"(defun Local>>LM:RGB->HSL (r g b / d h l m n s) ",
			"  (setq r (/ r 255.0)",
			"        g (/ g 255.0)",
			"        b (/ b 255.0)",
			"        n (min r g b)",
			"        m (max r g b)",
			"  )",
			"  (if (zerop (setq d (- m n))) ",
			"    (list 0 0 (fix (+ 0.5 (* m 100))))",
			"    (progn ",
			"      (if (< (setq l (/ (+ m n) 2.0)) 0.5) ",
			"        (setq s (/ d (+ m n)))",
			"        (setq s (/ d (- 2.0 m n)))",
			"      )",
			"      (cond ",
			"        ((= g m) (setq h (+ (/ (- b r) d) 2)))",
			"        ((= b m) (setq h (+ (/ (- r g) d) 4)))",
			"        ((setq h (/ (- g b) d)))",
			"      )",
			"      (list ",
			"        (fix (+ 0.5 (rem (+ 360 (* h 60)) 360)))",
			"        (fix (+ 0.5 (* s 100)))",
			"        (fix (+ 0.5 (* l 100)))",
			"      )",
			"    )",
			"  )",
			")"
		],
