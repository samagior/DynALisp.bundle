	// region Insert Nth
	"Insert Nth (Recursive)": {
		"prefix": "Local>>LM:insertnth-r",
		"body": [
			";; Insert Nth (Recursive)  -  Lee Mac",
			";; Inserts an item at the nth position in a list.",
			";; x - [any] Item to be inserted",
			";; n - [int] Zero-based index at which to insert item",
			";; l - [lst] List in which item is to be inserted",
			"",
			"(defun Local>>LM:insertnth-r (x n l) ",
			"  (cond ",
			"    ((null l) nil)",
			"    ((< 0 n) (cons (car l) (Local>>LM:insertnth x (1- n) (cdr l))))",
			"    ((cons x l))",
			"  )",
			")"
		],
		"description": "Inserts an item at the nth position in a list.\nx - [any] Item to be inserted\nn - [int] Zero-based index at which to insert item\nl - [lst] List in which item is to be inserted\nRequires: Local>>LM:insertnth"
	},
	"Insert Nth (Iterative)": {
		"prefix": "Local>>LM:insertnth",
		"body": [
			";; Insert Nth (Iterative)  -  Lee Mac",
			";; Inserts an item at the nth position in a list.",
			";; x - [any] Item to be inserted",
			";; n - [int] Zero-based index at which to insert item",
			";; l - [lst] List in which item is to be inserted",
			"",
			"(defun Local>>LM:insertnth (x n l / i) ",
			"  (setq i -1)",
			"  (apply 'append (mapcar '(lambda (a) (if (= n (setq i (1+ i))) (list x a) (list a))) l))",
			")"
		],
		"description": "Inserts an item at the nth position in a list.\nx - [any] Item to be inserted\nn - [int] Zero-based index at which to insert item\nl - [lst] List in which item is to be inserted"
	},
	// region Intersection Functions
	"Intersections": {
		"prefix": "Local>>LM:intersections",
		"body": [
			";; Intersections  -  Lee Mac",
			";; Returns a list of all points of intersection between two objects",
			";; for the given intersection mode.",
			";; ob1,ob2 - [vla] VLA-Objects",
			";;     mod - [int] acextendoption enum of intersectwith method",
			"",
			"(defun Local>>LM:intersections (ob1 ob2 mod / lst rtn) ",
			"  (if ",
			"    (and (vlax-method-applicable-p ob1 'intersectwith) ",
			"         (vlax-method-applicable-p ob2 'intersectwith)",
			"         (setq lst (vlax-invoke ob1 'intersectwith ob2 mod))",
			"    )",
			"    (repeat (/ (length lst) 3) ",
			"      (setq rtn (cons (list (car lst) (cadr lst) (caddr lst)) rtn)",
			"            lst (cdddr lst)",
			"      )",
			"    )",
			"  )",
			"  (reverse rtn)",
			")"
		],
		"description": "Returns a list of all points of intersection between two objects\nfor the given intersection mode.\nob1,ob2 - [vla] VLA-Objects\nmod - [int] acextendoption enum of intersectwith method"
	},
	"Intersections in Set": {
		"prefix": "Local>>LM:intersectionsinset",
		"body": [
			";; Intersections in Set  -  Lee Mac",
			";; Returns a list of all points of intersection between all objects in a supplied selection set.",
			";; sel - [sel] Selection Set",
			"",
			"(defun Local>>LM:intersectionsinset (sel / id1 id2 ob1 ob2 rtn) ",
			"  (repeat (setq id1 (sslength sel)) ",
			"    (setq ob1 (vlax-ename->vla-object (ssname sel (setq id1 (1- id1)))))",
			"    (repeat (setq id2 id1) ",
			"      (setq ob2 (vlax-ename->vla-object (ssname sel (setq id2 (1- id2))))",
			"            rtn (cons (Local>>LM:intersections ob1 ob2 acextendnone) rtn)",
			"      )",
			"    )",
			"  )",
			"  (apply 'append (reverse rtn))",
			")"
		],
		"description": "Returns a list of all points of intersection between all objects in a supplied selection set.\nsel - [sel] Selection Set\nRequires: Local>>LM:intersections"
	},
	"Intersections in Object List": {
		"prefix": "Local>>LM:intersectionsinobjlist",
		"body": [
			";; Intersections in Object List  -  Lee Mac",
			";; Returns a list of all points of intersection between all objects in a list of VLA-Objects.",
			";; lst - [lst] List of VLA-Objects",
			"",
			"(defun Local>>LM:intersectionsinobjlist (lst / ob1 rtn) ",
			"  (while (setq ob1 (car lst)) ",
			"    (foreach ob2 (setq lst (cdr lst)) ",
			"      (setq rtn (cons (Local>>LM:intersections ob1 ob2 acextendnone) rtn))",
			"    )",
			"  )",
			"  (apply 'append (reverse rtn))",
			")"
		],
		"description": "Returns a list of all points of intersection between all objects in a list of VLA-Objects.\nlst - [lst] List of VLA-Objects\nRequires: Local>>LM:intersections"
	},
