	"HSL -> RGB": {
		"prefix": "Local>>LM:HSL->RGB",
		"body": [
			";; HSL -> RGB  -  Lee Mac",
			";; Args: [int] 0<=h<=360, 0<=s<=100, 0<=l<=100",
			"",
			"(defun Local>>LM:HSL->RGB (h s l / u v) ",
			"  (setq h (/ h 360.0)",
			"        s (/ s 100.0)",
			"        l (/ l 100.0)",
			"  )",
			"  (mapcar '(lambda (x) (fix (+ 0.5 (* 255 x)))) ",
			"          (cond ",
			"            ((zerop s) (list l l l))",
			"            ((zerop l) '(0 0 0))",
			"            ((setq v (if (< l 0.5) (* l (1+ s)) (- (+ l s) (* l s)))",
			"                   u (- (* 2.0 l) v)",
			"             )",
			"             (mapcar ",
			"               '(lambda (h) ",
			"                  (setq h (rem (1+ h) 1))",
			"                  (cond ",
			"                    ((< (* 6.0 h) 1.0) (+ u (* 6.0 h (- v u))))",
			"                    ((< (* 2.0 h) 1.0) v)",
			"                    ((< (* 3.0 h) 2.0) (+ u (* 6.0 (- (/ 2.0 3.0) h) (- v u))))",
			"                    (u)",
			"                  )",
			"                )",
			"               (list (+ h (/ 1.0 3.0)) h (- h (/ 1.0 3.0)))",
			"             )",
			"            )",
			"          )",
			"  )",
			")"
		],
		"description": "Args: [int] 0<=h<=360, 0<=s<=100, 0<=l<=100"
