		"body": [
			";; Active Space  -  Lee Mac",
			";; Retrieves pointers to the Active Document and Space.",
			";; *doc - quoted symbol (other than *doc)",
			";; *spc - quoted symbol (other than *spc)",
			"",
			"(defun Local>>LM:activespace (*doc *spc) ",
