	},
	// region Effective Block Name
	"Effective Block Name": {
		"prefix": "Local>>LM:effectivename",
		"body": [
			";; Effective Block Name  -  Lee Mac",
			";; obj - [vla] VLA Block Reference object",
			"",
			"(defun Local>>LM:effectivename (obj) ",
