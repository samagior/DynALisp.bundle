	"Line-Circle Intersection (vector version)": {
		"prefix": "Local>>LM:inters-line-circle",
		"body": [
			";; Line-Circle Intersection (vector version)  -  Lee Mac",
			";; Returns the point(s) of intersection between an infinite line defined by",
			";; points p,q and circle with centre c and radius r",
			"",
			"(defun Local>>LM:inters-line-circle (p q c r / v s) ",
			"  (setq v (mapcar '- q p)",
			"        s (mapcar '- p c)",
			"  )",
			"  (mapcar '(lambda (s) (mapcar '+ p (Local>>LM:vxs v s))) ",
			"          (quad (Local>>LM:vxv v v) (* 2 (Local>>LM:vxv v s)) (- (Local>>LM:vxv s s) (* r r)))",
			"  )",
			")"
		],
		"description": "Returns the point(s) of intersection between an infinite line defined by\npoints p,q and circle with centre c and radius r\nRequires: Local>>LM:vxs, Local>>LM:vxv"
	},
	"2-Circle Intersection (trans version)": {
		"prefix": "Local>>LM:inters-circle-circle",
		"body": [
			";; 2-Circle Intersection (trans version)  -  Lee Mac",
			";; Returns the point(s) of intersection between two circles",
			";; with centres c1,c2 and radii r1,r2",
			"",
			"(defun Local>>LM:inters-circle-circle (c1 r1 c2 r2 / n d1 x z) ",
			"  (if ",
			"    (and ",
			"      (< (setq d1 (distance c1 c2)) (+ r1 r2))",
			"      (< (abs (- r1 r2)) d1)",
			"    )",
			"    (progn ",
			"      (setq n  (mapcar '- c2 c1)",
			"            c1 (trans c1 0 n)",
			"            z  (/ (- (+ (* r1 r1) (* d1 d1)) (* r2 r2)) (+ d1 d1))",
			"      )",
			"      (if (equal z r1 1e-8) ",
			"        (list (trans (list (car c1) (cadr c1) (+ (caddr c1) z)) n 0))",
			"        (progn ",
			"          (setq x (sqrt (- (* r1 r1) (* z z))))",
			"          (list ",
			"            (trans (list (- (car c1) x) (cadr c1) (+ (caddr c1) z)) n 0)",
			"            (trans (list (+ (car c1) x) (cadr c1) (+ (caddr c1) z)) n 0)",
			"          )",
			"        )",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the point(s) of intersection between two circles\nwith centres c1,c2 and radii r1,r2"
	},
	"2-Arc Intersection": {
		"prefix": "Local>>LM:inters-arc-arc",
		"body": [
			";; 2-Arc Intersection  -  Lee Mac",
			";; Returns the point(s) of intersection between two arcs",
			";; with centres c1,c2 radii r1,r2, start angles s1,s2 & end angles e1,e2",
			"",
			"(defun Local>>LM:inters-arc-arc (c1 r1 s1 e1 c2 r2 s2 e2) ",
			"  (cond ",
			"    ((< e1 s1) (Local>>LM:inters-arc-arc c1 r1 s1 (+ e1 pi pi) c2 r2 s2 e2))",
			"    ((< e2 s2) (Local>>LM:inters-arc-arc c1 r1 s1 e1 c2 r2 s2 (+ e2 pi pi)))",
			"    ((vl-remove-if-not ",
			"       '(lambda (pt) (and (<= s1 (angle c1 pt) e1) (<= s2 (angle c2 pt) e2)))",
			"       (Local>>LM:inters-circle-circle c1 r1 c2 r2)",
			"     )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the point(s) of intersection between two arcs\nwith centres c1,c2 radii r1,r2, start angles s1,s2 & end angles e1,e2\nRequires: Local>>LM:inters-circle-circle"
	},
	"Midpoint": {
		"prefix": "Local>>LM:mid",
		"body": [
			";; Midpoint  -  Lee Mac",
			";; Returns the midpoint of two points",
			"",
			"(defun Local>>LM:mid (a b) ",
