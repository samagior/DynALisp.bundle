	"Complex Subtraction": {
		"prefix": "Local>>LM:c-c",
		"body": [
			";; Complex Subtraction  -  Lee Mac",
			";; Args: c1,c2 - complex numbers of the form a+bi = (a b)",
			"",
			"(defun Local>>LM:c-c (c1 c2) ",
			"  (mapcar '- c1 c2)",
			")"
		],
		"description": "Args: c1,c2 - complex numbers of the form a+bi = (a b)"
	},
	"Complex Multiplication": {
		"prefix": "Local>>LM:cxc",
		"body": [
			";; Complex Multiplication  -  Lee Mac",
			";; Args: c1,c2 - complex numbers of the form a+bi = (a b)",
			"",
			"(defun Local>>LM:cxc (c1 c2) ",
			"  (list ",
			"    (- (* (car c1) (car c2)) (* (cadr c1) (cadr c2)))",
			"    (+ (* (car c1) (cadr c2)) (* (cadr c1) (car c2)))",
			"  )",
			")"
		],
		"description": "Args: c1,c2 - complex numbers of the form a+bi = (a b)"
	},
	"Complex Conjugate": {
		"prefix": "Local>>LM:c_",
		"body": [
			";; Complex Conjugate  -  Lee Mac",
			";; Args: c1 - complex number of the form a+bi = (a b)",
			"",
			"(defun Local>>LM:c_ (c1) ",
			"  (list (car c1) (- (cadr c1)))",
			")"
		],
		"description": "Args: c1 - complex number of the form a+bi = (a b)"
	},
	"Complex Division": {
		"prefix": "Local>>LM:c/c",
		"body": [
			";; Complex Division  -  Lee Mac",
			";; Args: c1,c2 - complex numbers of the form a+bi = (a b)",
			"",
			"(defun Local>>LM:c/c (c1 c2 / d) ",
			"  ((lambda (d) (mapcar '(lambda (x) (/ x d)) (Local>>LM:cxc c1 (Local>>LM:c_ c2)))) ",
			"    (car (Local>>LM:cxc c2 (Local>>LM:c_ c2)))",
			"  )",
			")"
		],
		"description": "Args: c1,c2 - complex numbers of the form a+bi = (a b)\nRequires: Local>>LM:c_, Local>>LM:cxc"
	},
	"Complex Norm": {
		"prefix": "Local>>LM:/c/",
		"body": [
			";; Complex Norm  -  Lee Mac",
			";; Args: c1 - complex number of the form a+bi = (a b)",
			";; defun name change from  |c|  to  Local>>LM:/c/",
			"",
			"(defun Local>>LM:/c/ (c1) ",
			"  (sqrt (apply '+ (mapcar '* c1 c1)))",
			")"
		],
		"description": "Args: c1 - complex number of the form a+bi = (a b)\ndefun name change from  |c|  to  Local>>LM:/c/"
	},
	// region Matrix Transformation Functions
	"Scale by Matrix": {
		"prefix": "Local>>LM:ScaleByMatrix",
		"body": [
			";;------------------=={ Scale by Matrix }==-------------------;;",
			";;                                                            ;;",
			";;  Scales a VLA-Object or Point List using a                 ;;",
			";;  Transformation Matrix                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to transform            ;;",
			";;  p1     - Base Point for Scaling Transformation            ;;",
			";;  scale  - Scale Factor by which to scale object            ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ScaleByMatrix (Local>>LM:target p1 scale / m) ",
			"",
			"  (Local>>LM:ApplyMatrixTransformation ",
			"    Local>>LM:target",
			"    (setq m (list ",
			"              (list scale 0. 0.)",
			"              (list 0. scale 0.)",
			"              (list 0. 0. scale)",
			"            )",
			"    )",
			"    (mapcar '- p1 (Local>>LM:mxv m p1))",
			"  )",
			")"
		],
		"description": "Scales a VLA-Object or Point List using a\nTransformation Matrix\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to transform\np1     - Base Point for Scaling Transformation\nscale  - Scale Factor by which to scale object\nRequires: Local>>LM:ApplyMatrixTransformation, Local>>LM:mxv"
	},
	"Translate by Matrix": {
		"prefix": "Local>>LM:TranslateByMatrix",
		"body": [
			";;----------------=={ Translate by Matrix }==-----------------;;",
			";;                                                            ;;",
			";;  Translates a VLA-Object or Point List using a             ;;",
			";;  Transformation Matrix                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to transform            ;;",
			";;  p1, p2 - Points representing vector by which to translate ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:TranslateByMatrix (Local>>LM:target p1 p2) ",
			"",
			"  (Local>>LM:ApplyMatrixTransformation ",
			"    Local>>LM:target",
			"    (list ",
			"      (list 1. 0. 0.)",
			"      (list 0. 1. 0.)",
			"      (list 0. 0. 1.)",
			"    )",
			"    (mapcar '- p2 p1)",
			"  )",
			")"
		],
		"description": "Translates a VLA-Object or Point List using a\nTransformation Matrix\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to transform\np1, p2 - Points representing vector by which to translate\nRequires: Local>>LM:ApplyMatrixTransformation"
	},
	"Rotate by Matrix": {
		"prefix": "Local>>LM:RotateByMatrix",
		"body": [
			";;------------------=={ Rotate by Matrix }==------------------;;",
			";;                                                            ;;",
			";;  Rotates a VLA-Object or Point List using a                ;;",
			";;  Transformation Matrix                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to transform            ;;",
			";;  p1     - Base Point for Rotation Transformation           ;;",
			";;  ang    - Angle through which to rotate object             ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:RotateByMatrix (Local>>LM:target p1 ang) ",
			"",
			"  (Local>>LM:ApplyMatrixTransformation ",
			"    Local>>LM:target",
			"    (setq m (list ",
			"              (list (cos ang) (- (sin ang)) 0.)",
			"              (list (sin ang) (cos ang) 0.)",
			"              (list 0. 0. 1.)",
			"            )",
			"    )",
			"    (mapcar '- p1 (Local>>LM:mxv m p1))",
			"  )",
			")"
		],
		"description": "Rotates a VLA-Object or Point List using a\nTransformation Matrix\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to transform\np1     - Base Point for Rotation Transformation\nang    - Angle through which to rotate object\nRequires: Local>>LM:ApplyMatrixTransformation, Local>>LM:mxv"
	},
	"Reflect by Matrix": {
		"prefix": "Local>>LM:ReflectByMatrix",
		"body": [
			";;-----------------=={ Reflect by Matrix }==------------------;;",
			";;                                                            ;;",
			";;  Reflects a VLA-Object or Point List using a               ;;",
			";;  Transformation Matrix                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to transform            ;;",
			";;  p1, p2 - Points representing vector in which to reflect   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ReflectByMatrix (Local>>LM:target p1 p2) ",
			"  ((lambda (a / m) ",
			"     (Local>>LM:ApplyMatrixTransformation ",
			"       Local>>LM:target",
			"       (setq m (list ",
			"                 (list (cos a) (sin a) 0.)",
			"                 (list (sin a) (- (cos a)) 0.)",
			"                 (list 0. 0. 1.)",
			"               )",
			"       )",
			"       (mapcar '- p1 (Local>>LM:mxv m p1))",
			"     )",
			"   ) ",
			"    (* 2. (angle p1 p2))",
			"  )",
			")"
		],
		"description": "Reflects a VLA-Object or Point List using a\nTransformation Matrix\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to transform\np1, p2 - Points representing vector in which to reflect\nRequires: Local>>LM:ApplyMatrixTransformation, Local>>LM:mxv"
	},
	// region MD5 Cryptographic Hash Function
	"MD5 Cryptographic Hash Function": {
		"prefix": "Local>>LM:MD5",
		"body": [
			";; MD5 Cryptographic Hash Function  -  V1.1 2016-03-27  -  Lee Mac",
			";; AutoLISP implementation of the MD5 algorithm by Ronald Rivest",
			";; lst - [lst] List of bytes for which to generate hash",
			";; Returns 128-bit (16-byte) hash string.",
			"",
			"(defun Local>>LM:MD5 (lst / a b c d f g h i k l r w x y) ",
			"",
			"  ;; k[n] = floor(abs(sin(n+1)))*2^32 ; n:1-64",
			"  (setq k (mapcar '(lambda (x) (md5:int->bits x 32)) ",
			"                  '(3614090360 3905402710 0606105819 3250441966 4118548399 1200080426 2821735955 4249261313 1770035416 ",
			"                    2336552879 4294925233 2304563134 1804603682 4254626195 2792965006 1236535329 4129170786 3225465664 ",
			"                    0643717713 3921069994 3593408605 0038016083 3634488961 3889429448 0568446438 3275163606 4107603335 ",
			"                    1163531501 2850285829 4243563512 1735328473 2368359562 4294588738 2272392833 1839030562 4259657740 ",
			"                    2763975236 1272893353 4139469664 3200236656 0681279174 3936430074 3572445317 0076029189 3654602809 ",
			"                    3873151461 0530742520 3299628645 4096336452 1126891415 2878612391 4237533241 1700485571 2399980690 ",
			"                    4293915773 2240044497 1873313359 4264355552 2734768916 1309151649 4149444226 3174756917 0718787259 ",
			"                    3951481745",
			"                   )",
			"          )",
			"  )",
			"",
			"  ;; bit-shift values",
			"  (setq r '(07 12 17 22 07 12 17 22 07 12 17 22 07 12 17 22 05 09 14 20 05 09 14 20 05 09 14 20 05 09 14 20 04 11 16 23 ",
			"            04 11 16 23 04 11 16 23 04 11 16 23 06 10 15 21 06 10 15 21 06 10 15 21 06 10 15 21",
			"           )",
			"  )",
			"",
			"  ;; Initial hash values: forward/backward count in little-endian hex",
			"  (setq h (mapcar '(lambda (x) (md5:int->bits x 32)) ",
			"                  '(1732584193 ; 0x67452301 = 01234567",
			"                    4023233417 ; 0xefcdab89 = 89abcdef",
			"                    2562383102 ; 0x98badcfe = fedcda98",
			"                    0271733878 ; 0x10325476 = 76543210",
			"                   )",
			"          )",
			"  )",
			"",
			"  ;; Pre-processing:",
			"  ;; Append 0x80 to list of byte values",
			"  ;; Append 0x00 until list has length of 448 bits (mod 512)",
			"  ;; Append length of string in bytes (little-endian) mod(2^64)",
			"  (setq l (cons 128 (reverse lst)))",
			"  (repeat (rem (+ 64 (- 56 (rem (length l) 64))) 64) (setq l (cons 0 l)))",
			"  (setq l (append (reverse l) (md5:bits->bytes (md5:int->bits (* 8 (length lst)) 64))))",
			"",
			"  ;; Process list in 512-bit (64-byte) chunks",
			"  (repeat (/ (length l) 64) ",
			"",
			"    ;; Construct list of 16 32-bit (4-byte) words",
			"    (repeat 16 ",
			"      (setq w (cons (md5:bytes->bits (mapcar '+ l '(0 0 0 0))) w)",
			"            l (cddddr l)",
			"      )",
			"    )",
			"    (setq w (reverse w))",
			"",
			"    ;; Initialise variables to hash values",
			"    ;; Lists of bit values are used as AutoLISP does not support 32-bit unsigned integers",
			"    (mapcar 'set '(a b c d) h)",
			"",
			"    ;; Main MD5 algorithm:",
			"    (setq i 0)",
			"    (repeat 64 ",
			"      (cond ",
			"        ((< i 16)",
			"         (setq f (mapcar 'logior (mapcar 'logand b c) (mapcar 'logand (mapcar '(lambda (a) (+ 2 (~ a))) b) d))",
			"               g i",
			"         )",
			"        )",
			"        ((< i 32)",
			"         (setq f (mapcar 'logior (mapcar 'logand d b) (mapcar 'logand (mapcar '(lambda (a) (+ 2 (~ a))) d) c))",
			"               g (rem (1+ (* 5 i)) 16)",
			"         )",
			"        )",
			"        ((< i 48)",
			"         (setq f (mapcar '(lambda (a b c) (boole 6 a b c)) b c d)",
			"               g (rem (+ 5 (* 3 i)) 16)",
			"         )",
			"        )",
			"        ((setq f (mapcar '(lambda (a b) (boole 6 a b)) c (mapcar 'logior b (mapcar '(lambda (a) (+ 2 (~ a))) d)))",
			"               g (rem (* 7 i) 16)",
			"         )",
			"        )",
			"      )",
			"      (mapcar 'set ",
			"              '(d c a b i)",
			"              (list c ",
			"                    b",
			"                    d",
			"                    (md5:uint32_+ ",
			"                      b",
			"                      (md5:leftrotate ",
			"                        (md5:uint32_+ ",
			"                          (md5:uint32_+ ",
			"                            (md5:uint32_+ a f)",
			"                            (nth i k)",
			"                          )",
			"                          (nth g w)",
			"                        )",
			"                        (nth i r)",
			"                      )",
			"                    )",
			"                    (1+ i)",
			"              )",
			"      )",
			"    )",
			"",
			"    ;; Update hash values for this chunk",
			"    (setq h (mapcar 'md5:uint32_+ h (list a b c d))",
			"          w nil",
			"    )",
			"  )",
			"",
			"  ;; Convert the 4 32-bit integer values to 128-bit hash string of 32 hex digits",
			"  (apply 'strcat ",
			"         (mapcar 'md5:byte->hex ",
			"                 (apply 'append (mapcar 'md5:bits->bytes h))",
			"         )",
			"  )",
			")",
			"",
			"(defun md5:int->bits (n b / l x) ",
			"  (repeat b (setq l (cons 0 l)))",
			"  (foreach x (vl-string->list (rtos n 2 0)) ",
			"    (setq x (- x 48)",
			"          l (mapcar ",
			"              '(lambda (a) ",
			"                 (setq a (+ (* a 10) x)",
			"                       x (/ a 2)",
			"                 )",
			"                 (rem a 2)",
			"               )",
			"              l",
			"            )",
			"    )",
			"  )",
			"  (reverse l) ;; output is big-endian",
			")",
			"",
			"(defun md5:bits->int (l)  ;; input is big-endian",
			"  ((lambda (f) (f (reverse l))) ",
			"    (lambda (l) (if l (+ (* 2.0 (f (cdr l))) (car l)) 0))",
			"  )",
			")",
			"",
			"(defun md5:bits->bytes (l / b r)  ;; input is big-endian",
			"  (repeat (/ (length l) 8) ",
			"    (repeat 8 ",
			"      (setq b (cons (car l) b)",
			"            l (cdr l)",
			"      )",
			"    )",
			"    (setq r (cons (fix (+ 1e-8 (md5:bits->int (reverse b)))) r)",
			"          b nil",
			"    )",
			"  )",
			"  r ;; output is little-endian",
			")",
			"",
			"(defun md5:bytes->bits (l)  ;; input is little-endian",
			"  (apply 'append (mapcar '(lambda (b) (md5:int->bits b 8)) (reverse l))) ;; output is big-endian",
			")",
			"",
			"(defun md5:int->char (n) ",
			"  (chr (+ n (if (< n 10) 48 87)))",
			")",
			"",
			"(defun md5:byte->hex (x) ",
			"  (strcat (md5:int->char (/ x 16)) (md5:int->char (rem x 16)))",
			")",
			"",
			"(defun md5:leftrotate (l x) ",
			"  (repeat x (setq l (append (cdr l) (list (car l)))))",
			")",
			"",
			"(defun md5:uint32_+ (bl1 bl2 / r)  ;; input is big-endian",
			"  (setq r 0)",
			"  (reverse ",
			"    (mapcar ",
			"      '(lambda (a b c / x) ",
			"         (setq x (boole 6 (boole 6 a b) r)",
			"               r (boole 7 (boole 1 a b) (boole 1 a r) (boole 1 b r))",
			"         )",
			"         x",
			"       )",
			"      (append (reverse bl1) (md5:uint32_0))",
			"      (append (reverse bl2) (md5:uint32_0))",
			"      (md5:uint32_0)",
			"    )",
			"  ) ;; output is big-endian",
			")",
			"",
			"(defun md5:uint32_0 (/ l) ",
			"  (repeat 32 (setq l (cons 0 l)))",
			"  (eval (list 'defun 'md5:uint32_0 nil (list 'quote l)))",
			"  (md5:uint32_0)",
			")"
		],
		"description": "AutoLISP implementation of the MD5 algorithm by Ronald Rivest\nlst - [lst] List of bytes for which to generate hash\nReturns 128-bit (16-byte) hash string."
	},
	// region Minimum Bounding Box
	"Minimum Bounding Box": {
		"prefix": "Local>>LM:minboundingbox",
		"body": [
			";; Minimum Bounding Box  -  Lee Mac",
			";; Returns the WCS coordinates describing the minimum bounding rectangle",
			";; surrounding all objects in a supplied selection set.",
			";; sel - [sel] selection set to process",
			";; tol - [rea] precision of calculation, 0 < tol < 1",
			"",
			"(defun Local>>LM:minboundingbox (sel tol / ang box bx1 bx2 cen idx lst obj rtn) ",
			"  (if (and sel (< 0.0 tol 1.0)) ",
			"    (progn ",
			"      (repeat (setq idx (sslength sel)) ",
			"        (setq obj (vlax-ename->vla-object (ssname sel (setq idx (1- idx)))))",
			"        (if ",
			"          (and (vlax-method-applicable-p obj 'getboundingbox) ",
			"               (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list obj 'a 'b))))",
			"          )",
			"          (setq lst (cons (vla-copy obj) lst))",
			"        )",
			"      )",
			"      (if lst ",
			"        (progn ",
			"          (setq box (Local>>LM:objlstboundingbox lst)",
			"                tol (* tol pi)",
			"                cen (apply 'mapcar (cons '(lambda (a b) (/ (+ a b) 2.0)) box))",
			"                bx1 (* (- (caadr box) (caar box)) (- (cadadr box) (cadar box)))",
			"                rtn (list 0.0 box)",
			"                ang 0.0",
			"          )",
			"          (while (< (setq ang (+ ang tol)) pi) ",
			"            (foreach obj lst (vlax-invoke obj 'rotate cen tol))",
			"            (setq box (Local>>LM:objlstboundingbox lst)",
			"                  bx2 (* (- (caadr box) (caar box)) (- (cadadr box) (cadar box)))",
			"            )",
			"            (if (< bx2 bx1) ",
			"              (setq bx1 bx2",
			"                    rtn (list ang box)",
			"              )",
			"            )",
			"          )",
			"          (foreach obj lst (vla-delete obj))",
			"          (Local>>LM:rotatepoints ",
			"            (mapcar '(lambda (a) (mapcar '(lambda (b) (apply b (cdr rtn))) a)) ",
			"                    '((caar cadar)",
			"                      (caadr cadar)",
			"                      (caadr cadadr)",
			"                      (caar cadadr)",
			"                     )",
			"            )",
			"            cen",
			"            (- (car rtn))",
			"          )",
			"        )",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the WCS coordinates describing the minimum bounding rectangle\nsurrounding all objects in a supplied selection set.\nsel - [sel] selection set to process\ntol - [rea] precision of calculation, 0 < tol < 1\nRequires: Local>>LM:objlstboundingbox, Local>>LM:rotatepoints"
	},
	// region Minimum Enclosing Circle
	"Minimum Enclosing Circle": {
		"prefix": "Local>>LM:MinEncCircle",
		"body": [
			";; Minimum Enclosing Circle  -  Lee Mac",
			";; Implements the algorithm by Pr.Chrystal (1885) using the Convex Hull",
			";; to determine the Minimum Enclosing Circle of a point set.",
			"",
			"(defun Local>>LM:MinEncCircle (lst / _sub) ",
			"",
			"  (defun _sub (p1 p2 l1 / a1 a2 l2 p3 p4) ",
			"    (setq l2 (Local>>LM:RemoveWithFuzz (list p1 p2) l1 1e-8)",
			"          p3 (car l2)",
			"          a1 (Local>>LM:GetInsideAngle p1 p3 p2)",
			"    )",
			"    (foreach p4 (cdr l2) ",
			"      (if (< (setq a2 (Local>>LM:GetInsideAngle p1 p4 p2)) a1) ",
			"        (setq p3 p4",
			"              a1 a2",
			"        )",
			"      )",
			"    )",
			"    (cond ",
			"      ((<= (/ pi 2.0) a1)",
			"       (list (Local>>LM:mid p1 p2) (/ (distance p1 p2) 2.0))",
			"      )",
			"      ((vl-some ",
			"         (function ",
			"           (lambda (a b c) ",
			"             (if (< (/ pi 2.0) (Local>>LM:GetInsideAngle a b c)) (_sub a c l1))",
			"           )",
			"         )",
			"         (list p1 p1 p2)",
			"         (list p2 p3 p1)",
			"         (list p3 p2 p3)",
			"       )",
			"      )",
			"      ((Local>>LM:3PCircle p1 p2 p3))",
			"    )",
			"  )",
			"",
			"  ((lambda (lst) ",
			"     (cond ",
			"       ((< (length lst) 2)",
			"        nil",
			"       )",
			"       ((< (length lst) 3)",
			"        (list (apply 'Local>>LM:mid lst) (/ (apply 'distance lst) 2.0))",
			"       )",
			"       ((_sub (car lst) (cadr lst) lst))",
			"     )",
			"   ) ",
			"    (Local>>LM:ConvexHull lst)",
			"  )",
			")"
		],
		"description": "Implements the algorithm by Pr.Chrystal (1885) using the Convex Hull\nto determine the Minimum Enclosing Circle of a point set.\nRequires: Local>>LM:ConvexHull, Local>>LM:GetInsideAngle, Local>>LM:mid, Local>>LM:RemoveWithFuzz"
	},
	// region ObjectDBX Wrapper
	"ObjectDBX Wrapper": {
		"prefix": "Local>>LM:ODBX",
		"body": [
			";;-----------------------=={ ObjectDBX Wrapper }==----------------------;;",
			";;                                                                      ;;",
			";;  Evaluates a supplied function on all drawings in a given list or    ;;",
			";;  selected directory.                                                 ;;",
			";;----------------------------------------------------------------------;;",
			";;  Author:  Lee Mac, Copyright © 2013  -  www.lee-mac.com              ;;",
			";;----------------------------------------------------------------------;;",
			";;  Arguments:                                                          ;;",
			";;                                                                      ;;",
			";;  fun [SYM]                                                           ;;",
			";;  ---------------------------------                                   ;;",
			";;  A function requiring a single argument (the VLA Document object),   ;;",
			";;  and following the 'rules' of ObjectDBX:                             ;;",
			";;                                                                      ;;",
			";;  - No SelectionSets               (ssget, ssname, ssdel, etc)        ;;",
			";;  - No Command Calls               (command \"_.line\" ... etc)         ;;",
			";;  - No ent* methods                (entget, entmod, entupd, etc)      ;;",
			";;  - No Access to System Variables  (setvar, getvar, setvariable, etc) ;;",
			";;                                                                      ;;",
			";;  lst [LIST] [Optional]                                               ;;",
			";;  ---------------------------------                                   ;;",
			";;  List of DWG Filenames; if nil, BrowseForFolder Dialog is displayed. ;;",
			";;                                                                      ;;",
			";;  sav [SYM]                                                           ;;",
			";;  ---------------------------------                                   ;;",
			";;  Boolean flag determining whether drawings should be saved following ;;",
			";;  function evaluation (T=saved, nil=not saved).                       ;;",
			";;----------------------------------------------------------------------;;",
			";;  Returns:                                                            ;;",
			";;                                                                      ;;",
			";;  List of:                                                            ;;",
			";;  (                                                                   ;;",
			";;      (<Drawing Filename> . <Function Result>)                        ;;",
			";;      (<Drawing Filename> . <Function Result>)                        ;;",
			";;      ...                                                             ;;",
			";;      (<Drawing Filename> . <Function Result>)                        ;;",
			";;  )                                                                   ;;",
			";;                                                                      ;;",
			";;  Where:                                                              ;;",
			";;  <Drawing Filename>                                                  ;;",
			";;  is the filename of drawing that has been processed.                 ;;",
			";;                                                                      ;;",
			";;  <Function Result>                                                   ;;",
			";;  is the result of evaluating the supplied function on the Document   ;;",
			";;  Object representing the associated drawing filename.                ;;",
			";;                                                                      ;;",
			";;  If an error occurs when evaluating the supplied function the        ;;",
			";;  Function Result will be nil and the error message will be printed   ;;",
			";;  to the command-line.                                                ;;",
			";;----------------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ODBX (fun lst sav / *error* app dbx dir doc dwl err rtn vrs) ",
			"",
			"  (defun *error* (msg) ",
			"    (if (and (= 'vla-object (type dbx)) (not (vlax-object-released-p dbx))) ",
			"      (vlax-release-object dbx)",
			"    )",
			"    (if (not (wcmatch (strcase msg t) \"*break,*cancel*,*exit*\")) ",
			"      (princ (strcat \"\\nError: \" msg))",
			"    )",
			"    (princ)",
			"  )",
			"",
			"  (cond ",
			"    ((not ",
			"       (or lst ",
			"           (and (setq dir (Local>>LM:browseforfolder \"Select Folder of Drawings to Process\" nil 512)) ",
			"                (setq lst (mapcar '(lambda (x) (strcat dir \"\\\\\" x)) (vl-directory-files dir \"*.dwg\" 1)))",
			"           )",
			"       )",
			"     )",
			"     nil",
			"    )",
			"    ((progn ",
			"       (setq dbx (vl-catch-all-apply 'vla-getinterfaceobject ",
			"                                     (list (setq app (vlax-get-acad-object)) ",
			"                                           (if (< (setq vrs (atoi (getvar 'acadver))) 16) ",
			"                                             \"objectdbx.axdbdocument\"",
			"                                             (strcat \"objectdbx.axdbdocument.\" (itoa vrs))",
			"                                           )",
			"                                     )",
			"                 )",
			"       )",
			"       (or (null dbx) (vl-catch-all-error-p dbx))",
			"     )",
			"     (prompt \"\\nUnable to interface with ObjectDBX.\")",
			"    )",
			"    (t",
			"     (vlax-for doc (vla-get-documents app) ",
			"       (setq dwl (cons (cons (strcase (vla-get-fullname doc)) doc) dwl))",
			"     )",
			"     (foreach dwg lst ",
			"       (if ",
			"         (or (setq doc (cdr (assoc (strcase dwg) dwl))) ",
			"             (and (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-open (list dbx dwg)))) ",
			"                  (setq doc dbx)",
			"             )",
			"         )",
			"         (progn ",
			"           (setq rtn (cons ",
			"                       (cons dwg ",
			"                             (if (vl-catch-all-error-p (setq err (vl-catch-all-apply fun (list doc)))) ",
			"                               (prompt (strcat \"\\n\" dwg \"\\t\" (vl-catch-all-error-message err)))",
			"                               err",
			"                             )",
			"                       )",
			"                       rtn",
			"                     )",
			"           )",
			"           (if sav (vla-saveas doc dwg))",
			"         )",
			"         (princ (strcat \"\\nError opening file: \" (vl-filename-base dwg) \".dwg\"))",
			"       )",
			"     )",
			"     (if (= 'vla-object (type dbx)) ",
			"       (vlax-release-object dbx)",
			"     )",
			"     (reverse rtn)",
			"    )",
			"  )",
			")"
		],
		"description": "Evaluates a supplied function on all drawings in a given list or\nselected directory.\nAuthor:  Lee Mac, Copyright © 2013  -  www.lee-mac.com\nArguments:\nfun [SYM]\nA function requiring a single argument (the VLA Document object),\nand following the 'rules' of ObjectDBX:\n- No SelectionSets               (ssget, ssname, ssdel, etc)\n- No Command Calls               (command \"_.line\" ... etc)\n- No ent* methods                (entget, entmod, entupd, etc)\n- No Access to System Variables  (setvar, getvar, setvariable, etc)\nlst [LIST] [Optional]\nList of DWG Filenames; if nil, BrowseForFolder Dialog is displayed.\nsav [SYM]\nBoolean flag determining whether drawings should be saved following\nfunction evaluation (T=saved, nil=not saved).\nReturns:\nList of:\n(\n(<Drawing Filename> . <Function Result>)\n(<Drawing Filename> . <Function Result>)\n...\n(<Drawing Filename> . <Function Result>)\n)\nWhere:\n<Drawing Filename>\nis the filename of drawing that has been processed.\n<Function Result>\nis the result of evaluating the supplied function on the Document\nObject representing the associated drawing filename.\nIf an error occurs when evaluating the supplied function the\nFunction Result will be nil and the error message will be printed\nto the command-line.\nRequires: Local>>LM:browseforfolder"
	},
	// region Open
	"Open": {
		"prefix": "Local>>LM:open",
		"body": [
			";; Open  -  Lee Mac",
			";; A wrapper for the 'Open' method of the Shell Object",
			";; target - [int/str] File, folder or ShellSpecialFolderConstants enum",
			"",
			"(defun Local>>LM:open (target / rtn shl) ",
			"  (if ",
			"    (and (or (= 'int (type target)) (setq target (findfile target))) ",
			"         (setq shl (vla-getinterfaceobject (vlax-get-acad-object) \"shell.application\"))",
			"    )",
			"    (progn ",
			"      (setq rtn (vl-catch-all-apply 'vlax-invoke (list shl 'open target)))",
			"      (vlax-release-object shl)",
			"      (if (vl-catch-all-error-p rtn) ",
			"        (prompt (vl-catch-all-error-message rtn))",
			"        t",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "A wrapper for the 'Open' method of the Shell Object\ntarget - [int/str] File, folder or ShellSpecialFolderConstants enum"
	},
	// region Ortho Point
	"Ortho Point": {
		"prefix": "Local>>LM:OrthoPoint",
		"body": [
			";;---------------------=={ Ortho Point }==--------------------;;",
			";;                                                            ;;",
			";;  Returns a point transformed relative to a basepoint to    ;;",
			";;  account for activation of Orthomode in the current UCS.   ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  base  - basepoint for transformation (UCS)                ;;",
			";;  point - point to be transformed (UCS)                     ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Point (UCS) transformed to account for Ortho    ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:OrthoPoint (base point / dx dy vp vx vy) ",
			"  (if (zerop (getvar 'ORTHOMODE)) ",
			"    point",
			"    (progn ",
			"      (setq vx (trans (getvar 'UCSXDIR) 0 1 t)",
			"            vy (Local>>LM:v^v '(0.0 0.0 1.0) vx)",
			"            vp (mapcar '- point base)",
			"            dx (Local>>LM:vxv vx vp)",
			"            dy (Local>>LM:vxv vy vp)",
			"      )",
			"      (mapcar '+ ",
			"              base",
			"              (if (< (abs dx) (abs dy)) ",
			"                (Local>>LM:vxs vy dy)",
			"                (Local>>LM:vxs vx dx)",
			"              )",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a point transformed relative to a basepoint to\naccount for activation of Orthomode in the current UCS.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nbase  - basepoint for transformation (UCS)\npoint - point to be transformed (UCS)\nReturns:  Point (UCS) transformed to account for Ortho\nRequires: Local>>LM:vxs, Local>>LM:vxv"
	},
	"Ortho Point - Trans version": {
		"prefix": "Local>>LM:OrthoPoint-trans",
		"body": [
			";;-------------=={ Ortho Point - Trans version}==-------------;;",
			";;                                                            ;;",
			";;  Returns a point transformed relative to a basepoint to    ;;",
			";;  account for activation of Orthomode in the current UCS.   ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  base  - basepoint for transformation (UCS)                ;;",
			";;  point - point to be transformed (UCS)                     ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Point (UCS) transformed to account for Ortho    ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:OrthoPoint-trans (base point) ",
			"  (if (zerop (getvar 'ORTHOMODE)) ",
			"    point",
			"    (apply 'polar ",
			"           (cons base ",
			"                 ((lambda (n / a x z) ",
			"                    (setq x (- (car (trans point 0 n)) (car (trans base 0 n)))",
			"                          z (- (caddr (trans point 0 n)) (caddr (trans base 0 n)))",
			"                          a (angle '(0. 0. 0.) n)",
			"                    )",
			"                    (if (< (abs z) (abs x)) ",
			"                      (list (+ a (/ pi 2.)) x)",
			"                      (list a z)",
			"                    )",
			"                  ) ",
			"                   (trans (getvar 'UCSXDIR) 0 1)",
			"                 )",
			"           )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a point transformed relative to a basepoint to\naccount for activation of Orthomode in the current UCS.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nbase  - basepoint for transformation (UCS)\npoint - point to be transformed (UCS)\nReturns:  Point (UCS) transformed to account for Ortho"
	},
	// region Pad Between Strings
	"Pad Between recursive": {
		"prefix": "Local>>LM:PadBetween-r",
		"body": [
			";;----------------=={ Pad Between recursive }==---------------;;",
			";;                                                            ;;",
			";;  Returns a string of a minimum specified length which is   ;;",
			";;  the concatenation of two supplied strings padded to a     ;;",
			";;  desired length using a supplied character.                ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  s1,s2 - strings to be concatenated                        ;;",
			";;  ch    - character for padding                             ;;",
			";;  ln    - minimum length of returned string                 ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Concatenation of s1,s2 padded to a min length   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:PadBetween-r (s1 s2 ch ln) ",
			"  (if (< (+ (strlen s1) (strlen s2)) ln) ",
			"    (Local>>LM:PadBetween-r (strcat s1 ch) s2 ch ln)",
			"    (strcat s1 s2)",
			"  )",
			")"
		],
		"description": "Returns a string of a minimum specified length which is\nthe concatenation of two supplied strings padded to a\ndesired length using a supplied character.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ns1,s2 - strings to be concatenated\nch    - character for padding\nln    - minimum length of returned string\nReturns:  Concatenation of s1,s2 padded to a min length"
	},
	"Pad Between": {
		"prefix": "Local>>LM:PadBetween",
		"body": [
			";;---------------------=={ Pad Between }==--------------------;;",
			";;                                                            ;;",
			";;  Returns a string of a minimum specified length which is   ;;",
			";;  the concatenation of two supplied strings padded to a     ;;",
			";;  desired length using a supplied character.                ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  s1,s2 - strings to be concatenated                        ;;",
			";;  ch    - character for padding                             ;;",
			";;  ln    - minimum length of returned string                 ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Concatenation of s1,s2 padded to a min length   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:PadBetween (s1 s2 ch ln) ",
			"  ((lambda (a b c) ",
			"     (repeat (- ln (length b) (length c)) (setq c (cons a c)))",
			"     (vl-list->string (append b c))",
			"   ) ",
			"    (ascii ch)",
			"    (vl-string->list s1)",
			"    (vl-string->list s2)",
			"  )",
			")"
		],
		"description": "Returns a string of a minimum specified length which is\nthe concatenation of two supplied strings padded to a\ndesired length using a supplied character.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ns1,s2 - strings to be concatenated\nch    - character for padding\nln    - minimum length of returned string\nReturns:  Concatenation of s1,s2 padded to a min length"
	},
	// region Parse Numbers
	"Parse Numbers": {
		"prefix": "Local>>LM:parsenumbers",
		"body": [
			";; Parse Numbers  -  Lee Mac",
			";; Parses a list of numerical values from a supplied string.",
			"",
			"(defun Local>>LM:parsenumbers (str) ",
			"  ((lambda (l) ",
			"     (read ",
			"       (strcat \"(\" ",
			"               (vl-list->string ",
			"                 (mapcar ",
			"                   '(lambda (a b c) ",
			"                      (if ",
			"                        (or (< 47 b 58) ",
			"                            (and (= 45 b) (< 47 c 58) (not (< 47 a 58)))",
			"                            (and (= 46 b) (< 47 a 58) (< 47 c 58))",
			"                        )",
			"                        b",
			"                        32",
			"                      )",
			"                    )",
			"                   (cons nil l)",
			"                   l",
			"                   (append (cdr l) '(()))",
			"                 )",
			"               )",
			"               \")\"",
			"       )",
			"     )",
			"   ) ",
			"    (vl-string->list str)",
			"  )",
			")"
		],
		"description": "Parses a list of numerical values from a supplied string."
	},
	// region Permutations
	"Permutations": {
		"prefix": "Local>>LM:Permutations",
		"body": [
			";;---------------------=={ Permutations }==-------------------;;",
			";;                                                            ;;",
			";;  Returns a list of all permutations of elements in a list  ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  l - list to process                                       ;;",
			";;------------------------------------------------------------;;",
			";;  Returns: List of all permutations of elements in the list ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:Permutations (l) ",
			"  (if (cdr l) ",
			"    ((lambda (f) ",
			"       (f ",
			"         (apply 'append ",
			"                (mapcar ",
			"                  (function ",
			"                    (lambda (a) ",
			"                      (mapcar (function (lambda (b) (cons a b))) ",
			"                              (Local>>LM:Permutations ",
			"                                ((lambda (f) (f a l)) ",
			"                                  (lambda (a l) ",
			"                                    (if l ",
			"                                      (if (equal a (car l)) ",
			"                                        (cdr l)",
			"                                        (cons (car l) (f a (cdr l)))",
			"                                      )",
			"                                    )",
			"                                  )",
			"                                )",
			"                              )",
			"                      )",
			"                    )",
			"                  )",
			"                  l",
			"                )",
			"         )",
			"       )",
			"     ) ",
			"      (lambda (l) (if l (cons (car l) (f (vl-remove (car l) (cdr l))))))",
			"    )",
			"    (list l)",
			"  )",
			")"
		],
		"description": "Returns a list of all permutations of elements in a list\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nl - list to process\nReturns: List of all permutations of elements in the list"
	},
	// region Polygon Centroid
	"Polygon Centroid": {
		"prefix": "Local>>LM:PolyCentroid",
		"body": [
			";; Polygon Centroid  -  Lee Mac",
			";; Returns the WCS Centroid of an LWPolyline Polygon Entity",
			"",
			"(defun Local>>LM:PolyCentroid (e / l) ",
			"  (foreach x (setq e (entget e)) ",
			"    (if (= 10 (car x)) (setq l (cons (cdr x) l)))",
			"  )",
			"  ((lambda (a) ",
			"     (if (not (equal 0.0 a 1e-8)) ",
			"       (trans ",
			"         (mapcar '/ ",
			"                 (apply 'mapcar ",
			"                        (cons '+ ",
			"                              (mapcar ",
			"                                (function ",
			"                                  (lambda (a b) ",
			"                                    ((lambda (m) ",
			"                                       (mapcar ",
			"                                         (function ",
			"                                           (lambda (c d) (* (+ c d) m))",
			"                                         )",
			"                                         a",
			"                                         b",
			"                                       )",
			"                                     ) ",
			"                                      (- (* (car a) (cadr b)) (* (car b) (cadr a)))",
			"                                    )",
			"                                  )",
			"                                )",
			"                                l",
			"                                (cons (last l) l)",
			"                              )",
			"                        )",
			"                 )",
			"                 (list a a)",
			"         )",
			"         (cdr (assoc 210 e))",
			"         0",
			"       )",
			"     )",
			"   ) ",
			"    (* 3.0 ",
			"       (apply '+ ",
			"              (mapcar ",
			"                (function ",
			"                  (lambda (a b) ",
			"                    (- (* (car a) (cadr b)) (* (car b) (cadr a)))",
			"                  )",
			"                )",
			"                l",
			"                (cons (last l) l)",
			"              )",
			"       )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the WCS Centroid of an LWPolyline Polygon Entity"
	},
	// region Random Number Functions
	"Rand": {
		"prefix": "Local>>LM:rand",
		"body": [
			";; Rand  -  Lee Mac",
			";; PRNG implementing a linear congruential generator with",
			";; parameters derived from the book 'Numerical Recipes'",
			"",
			"(defun Local>>LM:rand (/ a c m) ",
			"  (setq m   4294967296.0",
			"        a   1664525.0",
			"        c   1013904223.0",
			"        \\$xn (rem (+ c (* a (cond (\\$xn) ((getvar 'date))))) m)",
			"  )",
			"  (/ \\$xn m)",
			")"
		],
		"description": "PRNG implementing a linear congruential generator with\nparameters derived from the book 'Numerical Recipes'"
	},
	"Random in Range": {
		"prefix": "Local>>LM:randrange",
		"body": [
			";; Random in Range  -  Lee Mac",
			";; Returns a pseudo-random integral number in a given range (inclusive)",
			"",
			"(defun Local>>LM:randrange (a b) ",
			"  (+ (min a b) (fix (* (Local>>LM:rand) (1+ (abs (- a b))))))",
			")"
		],
		"description": "Returns a pseudo-random integral number in a given range (inclusive)\nRequires: Local>>LM:rand"
	},
	// region Read CSV
	"Read CSV": {
		"prefix": "Local>>LM:readcsv",
		"body": [
			";; Read CSV  -  Lee Mac",
			";; Parses a CSV file into a matrix list of cell values.",
			";; csv - [str] filename of CSV file to read",
			"",
			"(defun Local>>LM:readcsv (csv / des lst sep str) ",
			"  (if (setq des (open csv \"r\")) ",
			"    (progn ",
			"      (setq sep (cond ((vl-registry-read \"HKEY_CURRENT_USER\\\\Control Panel\\\\International\" \"sList\")) (\",\")))",
			"      (while (setq str (read-line des)) ",
			"        (setq lst (cons (Local>>LM:csv->lst str sep 0) lst))",
			"      )",
			"      (close des)",
			"    )",
			"  )",
			"  (reverse lst)",
			")"
		],
		"description": "Parses a CSV file into a matrix list of cell values.\ncsv - [str] filename of CSV file to read\nRequires: Local>>LM:csv->lst"
	},
	"CSV -> List": {
		"prefix": "Local>>LM:csv->lst",
		"body": [
			";; CSV -> List  -  Lee Mac",
			";; Parses a line from a CSV file into a list of cell values.",
			";; str - [str] string read from CSV file",
			";; sep - [str] CSV separator token",
			";; pos - [int] initial position index (always zero)",
			"",
			"(defun Local>>LM:csv->lst (str sep pos / s) ",
			"  (cond ",
			"    ((not (setq pos (vl-string-search sep str pos)))",
			"     (if (wcmatch str \"\\\"*\\\"\") ",
			"       (list (Local>>LM:csv-replacequotes (substr str 2 (- (strlen str) 2))))",
			"       (list str)",
			"     )",
			"    )",
			"    ((or (wcmatch (setq s (substr str 1 pos)) \"\\\"*[~\\\"]\") ",
			"         (and (wcmatch s \"~*[~\\\"]*\") (= 1 (logand 1 pos)))",
			"     )",
			"     (Local>>LM:csv->lst str sep (+ pos 2))",
			"    )",
			"    ((wcmatch s \"\\\"*\\\"\")",
			"     (cons ",
			"       (Local>>LM:csv-replacequotes (substr str 2 (- pos 2)))",
			"       (Local>>LM:csv->lst (substr str (+ pos 2)) sep 0)",
			"     )",
			"    )",
			"    ((cons s (Local>>LM:csv->lst (substr str (+ pos 2)) sep 0)))",
			"  )",
			")"
		],
		"description": "Parses a line from a CSV file into a list of cell values.\nstr - [str] string read from CSV file\nsep - [str] CSV separator token\npos - [int] initial position index (always zero)\nRequires: Local>>LM:csv-replacequotes"
	},
	"csv-replacequotes": {
		"prefix": "Local>>LM:csv-replacequotes",
		"body": [
			"",
			"(defun Local>>LM:csv-replacequotes (str / pos) ",
			"  (setq pos 0)",
			"  (while (setq pos (vl-string-search \"\\\"\\\"\" str pos)) ",
			"    (setq str (vl-string-subst \"\\\"\" \"\\\"\\\"\" str pos)",
			"          pos (1+ pos)",
			"    )",
			"  )",
			"  str",
			")"
		],
		"description": ""
	},
	// region 3D Rotate by Matrix
	"3D Rotate by Matrix": {
		"prefix": "Local>>LM:Rotate3D",
		"body": [
			";;----------------=={ 3D Rotate by Matrix }==-----------------;;",
			";;                                                            ;;",
			";;  Rotates a VLA-Object or Point List about a 3D axis using  ;;",
			";;  a Transformation matrix.                                  ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to Rotate               ;;",
			";;  p1,p2  - Two 3D points defining the axis of rotation      ;;",
			";;  ang    - Rotation Angle                                   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:Rotate3D (Local>>LM:target p1 p2 ang / ux uy uz) ",
			"",
			"  (mapcar 'set '(ux uy uz) (setq u (Local>>LM:unit (mapcar '- p2 p1))))",
			"",
			"  (Local>>LM:ApplyMatrixTransformation ",
			"    Local>>LM:target",
			"    (setq m (Local>>LM:m+m ",
			"              (list ",
			"                (list (cos ang) 0. 0.)",
			"                (list 0. (cos ang) 0.)",
			"                (list 0. 0. (cos ang))",
			"              )",
			"              (Local>>LM:m+m ",
			"                (Local>>LM:mxs ",
			"                  (list ",
			"                    (list 0. (- uz) uy)",
			"                    (list uz 0. (- ux))",
			"                    (list (- uy) ux 0.)",
			"                  )",
			"                  (sin ang)",
			"                )",
			"                (Local>>LM:mxs (mapcar '(lambda (e) (Local>>LM:vxs u e)) u) (- 1. (cos ang)))",
			"              )",
			"            )",
			"    )",
			"    (mapcar '- p1 (Local>>LM:mxv m p1))",
			"  )",
			")"
		],
		"description": "Rotates a VLA-Object or Point List about a 3D axis using\na Transformation matrix.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to Rotate\np1,p2  - Two 3D points defining the axis of rotation\nang    - Rotation Angle\nRequires: Local>>LM:ApplyMatrixTransformation, Local>>LM:m+m, Local>>LM:mxs, Local>>LM:mxv, Local>>LM:unit, Local>>LM:vxs"
	},
	"3D Reflect by Matrix": {
		"prefix": "Local>>LM:Reflect3D",
		"body": [
			";;----------------=={ 3D Reflect by Matrix }==----------------;;",
			";;                                                            ;;",
			";;  Reflects a VLA-Object or Point List in a plane using a    ;;",
			";;  Transformation matrix.                                    ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target   - VLA-Object or Point List to Reflect            ;;",
			";;  p1,p2,p3 - Three 3D points defining the reflection plane  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:Reflect3D (Local>>LM:target p1 p2 p3 / m u ux uy uz) ",
			"",
			"  (mapcar 'set '(ux uy uz) (setq u (Local>>LM:unit (Local>>LM:v^v (mapcar '- p2 p1) (mapcar '- p3 p1)))))",
			"",
			"  (Local>>LM:ApplyMatrixTransformation ",
			"    Local>>LM:target",
			"    (setq m (list ",
			"              (list (- 1. (* 2. ux ux)) (* -2. uy ux) (* -2. ux uz))",
			"              (list (* -2. ux uy) (- 1. (* 2. uy uy)) (* -2. uy uz))",
			"              (list (* -2. ux uz) (* -2. uy uz) (- 1. (* 2. uz uz)))",
			"            )",
			"    )",
			"    (mapcar '- p1 (Local>>LM:mxv m p1))",
			"  )",
			")"
		],
		"description": "Reflects a VLA-Object or Point List in a plane using a\nTransformation matrix.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ntarget   - VLA-Object or Point List to Reflect\np1,p2,p3 - Three 3D points defining the reflection plane\nRequires: Local>>LM:ApplyMatrixTransformation, Local>>LM:mxv, Local>>LM:unit"
	},
	"Apply Matrix Transformation": {
		"prefix": "Local>>LM:ApplyMatrixTransformation",
		"body": [
			";;-----------=={ Apply Matrix Transformation }==--------------;;",
			";;                                                            ;;",
			";;  Transforms a VLA-Object or Point List using a             ;;",
			";;  Transformation Matrix                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  target - VLA-Object or Point List to Transform            ;;",
			";;  matrix - 3x3 Matrix by which to Transform object          ;;",
			";;  vector - 3D translation vector                            ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ApplyMatrixTransformation (Local>>LM:target matrix vector) ",
			"  (vl-load-com)",
			"  (cond ",
			"    ((eq 'VLA-OBJECT (type target))",
			"",
			"     (vla-TransformBy Local>>LM:target ",
			"                      (vlax-tMatrix ",
			"                        (append (mapcar '(lambda (x v) (append x (list v))) matrix vector) ",
			"                                '((0. 0. 0. 1.))",
			"                        )",
			"                      )",
			"     )",
			"    )",
			"    ((listp Local>>LM:target)",
			"",
			"     (mapcar ",
			"       (function ",
			"         (lambda (point) (mapcar '+ (Local>>LM:mxv matrix point) vector))",
			"       )",
			"       Local>>LM:target",
			"     )",
			"    )",
			"  )",
			")"
		],
		"description": "Transforms a VLA-Object or Point List using a\nTransformation Matrix\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\ntarget - VLA-Object or Point List to Transform\nmatrix - 3x3 Matrix by which to Transform object\nvector - 3D translation vector\nRequires: Local>>LM:mxv"
	},
	// region Release Object
	"Release Object": {
		"prefix": "Local>>LM:ReleaseObject",
		"body": [
			";;------------------=={ Release Object }==--------------------;;",
			";;                                                            ;;",
			";;  Releases a VLA Object from memory via plentiful error     ;;",
			";;  trapping                                                  ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2010 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  obj - VLA Object to be released from memory               ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  T if Object Released, else nil                  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ReleaseObject (obj) ",
			"  (and obj ",
			"       (eq 'VLA-OBJECT (type obj))",
			"       (not (vlax-object-released-p obj))",
			"       (not ",
			"         (vl-catch-all-error-p ",
			"           (vl-catch-all-apply 'vlax-release-object (list obj))",
			"         )",
			"       )",
			"  )",
			")"
		],
		"description": "Releases a VLA Object from memory via plentiful error\ntrapping\nAuthor: Lee Mac, Copyright © 2010 - www.lee-mac.com\nArguments:\nobj - VLA Object to be released from memory\nReturns:  T if Object Released, else nil"
	},
	// region Remove Items
	"Remove Items (2)": {
		"prefix": "Local>>LM:RemoveItems-r",
		"body": [
			";;--------------------=={ Remove Items }==--------------------;;",
			";;                                                            ;;",
			";;  Removes the items at specified indexes from a list        ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  items - list of zero-based indexes to remove              ;;",
			";;  lst   - list from which items are to be removed           ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List with items removed                         ;;",
			";;------------------------------------------------------------;;",
			";;  Recursive",
			"",
			"(defun Local>>LM:RemoveItems-r (items lst) ",
			"  (if (and lst items) ",
			"    (if (zerop (car items)) ",
			"      (Local>>LM:RemoveItems (mapcar '1- (cdr items)) (cdr lst))",
			"      (cons (car lst) (Local>>LM:RemoveItems (mapcar '1- items) (cdr lst)))",
			"    )",
			"    lst",
			"  )",
			")"
		],
		"description": "Removes the items at specified indexes from a list\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nitems - list of zero-based indexes to remove\nlst   - list from which items are to be removed\nReturns:  List with items removed\nRecursive\nRequires: Local>>LM:RemoveItems"
	},
	"Remove Items (3)": {
		"prefix": "Local>>LM:RemoveItems",
		"body": [
			";;--------------------=={ Remove Items }==--------------------;;",
			";;                                                            ;;",
			";;  Removes the items at specified indexes from a list        ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  items - list of zero-based indexes to remove              ;;",
			";;  lst   - list from which items are to be removed           ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List with items removed                         ;;",
			";;------------------------------------------------------------;;",
			";;  Iterative",
			"",
			"(defun Local>>LM:RemoveItems (items lst / i) ",
			"  (setq i -1)",
			"  (vl-remove-if '(lambda (x) (member (setq i (1+ i)) items)) lst)",
			")"
		],
		"description": "Removes the items at specified indexes from a list\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nitems - list of zero-based indexes to remove\nlst   - list from which items are to be removed\nReturns:  List with items removed\nIterative"
	},
	// region Remove Nth
	"Remove Nth": {
		"prefix": "Local>>LM:RemoveNth",
		"body": [
			";;----------------------=={ Remove Nth }==--------------------;;",
			";;                                                            ;;",
			";;  Removes the item at the nth index in a supplied list      ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  n - index of item to remove (zero based)                  ;;",
			";;  l - list from which item is to be removed                 ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List with item at index n removed               ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:RemoveNth (n l / i) ",
			"  (setq i -1)",
			"  (vl-remove-if '(lambda (x) (= (setq i (1+ i)) n)) l)",
			")"
		],
		"description": "Removes the item at the nth index in a supplied list\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nn - index of item to remove (zero based)\nl - list from which item is to be removed\nReturns:  List with item at index n removed"
	},
	// region Rounding Functions
	"Round": {
		"prefix": "Local>>LM:round",
		"body": [
			";; Round  -  Lee Mac",
			";; Rounds 'n' to the nearest integer",
			"",
			"(defun Local>>LM:round (n) ",
			"  (fix (+ n (if (minusp n) -0.5 0.5)))",
			")"
		],
		"description": "Rounds 'n' to the nearest integer"
	},
	"Round Multiple": {
		"prefix": "Local>>LM:roundm",
		"body": [
			";; Round Multiple  -  Lee Mac",
			";; Rounds 'n' to the nearest multiple of 'm'",
			"",
			"(defun Local>>LM:roundm (n m) ",
			"  (* m (fix ((if (minusp n) - +) (/ n (float m)) 0.5)))",
			")"
		],
		"description": "Rounds 'n' to the nearest multiple of 'm'"
	},
	"Round To": {
		"prefix": "Local>>LM:roundto",
		"body": [
			";; Round To  -  Lee Mac",
			";; Rounds 'n' to 'p' decimal places",
			"",
			"(defun Local>>LM:roundto (n p) ",
			"  (Local>>LM:roundm n (expt 10.0 (- p)))",
			")"
		],
		"description": "Rounds 'n' to 'p' decimal places\nRequires: Local>>LM:roundm"
	},
	"Round Up": {
		"prefix": "Local>>LM:roundup",
		"body": [
			";; Round Up  -  Lee Mac",
			";; Rounds 'n' up to the nearest 'm'",
			"",
			"(defun Local>>LM:roundup (n m) ",
			"  ((lambda (r) (cond ((equal 0.0 r 1e-8) n) ((< n 0) (- n r)) ((+ n (- m r))))) (rem n m))",
			")"
		],
		"description": "Rounds 'n' up to the nearest 'm'"
	},
	"Round Down": {
		"prefix": "Local>>LM:rounddown",
		"body": [
			";; Round Down  -  Lee Mac",
			";; Rounds 'n' down to the nearest 'm'",
			"",
			"(defun Local>>LM:rounddown (n m) ",
			"  ((lambda (r) (cond ((equal 0.0 r 1e-8) n) ((< n 0) (- n r m)) ((- n r)))) (rem n m))",
			")"
		],
		"description": "Rounds 'n' down to the nearest 'm'"
	},
	// region Select If
	"Select if": {
		"prefix": "Local>>LM:SelectIf",
		"body": [
			";;---------------------=={ Select if }==----------------------;;",
			";;                                                            ;;",
			";;  Provides continuous selection prompts until either a      ;;",
			";;  predicate function is validated or a keyword is supplied. ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  msg  - prompt string                                      ;;",
			";;  pred - optional predicate function [selection list arg]   ;;",
			";;  func - selection function to invoke                       ;;",
			";;  keyw - optional initget argument list                     ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Entity selection list, keyword, or nil          ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:SelectIf (msg pred func keyw / sel) ",
			"  (setq pred (eval pred))",
			"  (while ",
			"    (progn (setvar 'ERRNO 0) ",
			"           (if keyw (apply 'initget keyw))",
			"           (setq sel (func msg))",
			"           (cond ",
			"             ((= 7 (getvar 'ERRNO))",
			"              (princ \"\\nMissed, Try again.\")",
			"             )",
			"             ((eq 'STR (type sel))",
			"              nil",
			"             )",
			"             ((vl-consp sel)",
			"              (if (and pred (not (pred sel))) ",
			"                (princ \"\\nInvalid Object Selected.\")",
			"              )",
			"             )",
			"           )",
			"    )",
			"  )",
			"  sel",
			")"
		],
		"description": "Provides continuous selection prompts until either a\npredicate function is validated or a keyword is supplied.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nmsg  - prompt string\npred - optional predicate function [selection list arg]\nfunc - selection function to invoke\nkeyw - optional initget argument list\nReturns:  Entity selection list, keyword, or nil"
	},
	// region Selection Set Bounding Box
	"Selection Set Bounding Box": {
		"prefix": "Local>>LM:ssboundingbox",
		"body": [
			";; Selection Set Bounding Box  -  Lee Mac",
			";; Returns a list of the lower-left and upper-right WCS coordinates of a",
			";; rectangular frame bounding all objects in a supplied selection set.",
			";; sel - [sel] Selection set for which to return bounding box",
			"",
			"(defun Local>>LM:ssboundingbox (sel / idx llp ls1 ls2 obj urp) ",
			"  (repeat (setq idx (sslength sel)) ",
			"    (setq obj (vlax-ename->vla-object (ssname sel (setq idx (1- idx)))))",
			"    (if ",
			"      (and (vlax-method-applicable-p obj 'getboundingbox) ",
			"           (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list obj 'llp 'urp))))",
			"      )",
			"      (setq ls1 (cons (vlax-safearray->list llp) ls1)",
			"            ls2 (cons (vlax-safearray->list urp) ls2)",
			"      )",
			"    )",
			"  )",
			"  (if (and ls1 ls2) ",
			"    (mapcar '(lambda (a b) (apply 'mapcar (cons a b))) '(min max) (list ls1 ls2))",
			"  )",
			")"
		],
		"description": "Returns a list of the lower-left and upper-right WCS coordinates of a\nrectangular frame bounding all objects in a supplied selection set.\nsel - [sel] Selection set for which to return bounding box"
	},
	"Selection Set Bounding Box (2)": {
		"prefix": "Local>>LM:ssboundingbox~",
		"body": [
			";; Selection Set Bounding Box  -  Lee Mac",
			";; Returns a list of the lower-left and upper-right WCS coordinates of a",
			";; rectangular frame bounding all objects in a supplied selection set.",
			";; sel - [sel] Selection set for which to return bounding box",
			";;  Alternative to the above function",
			"",
			"(defun Local>>LM:ssboundingbox~ (sel / idx llp ls1 ls2 obj urp) ",
			"  (repeat (setq idx (sslength sel)) ",
			"    (setq obj (vlax-ename->vla-object (ssname sel (setq idx (1- idx)))))",
			"    (if ",
			"      (and (vlax-method-applicable-p obj 'getboundingbox) ",
			"           (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list obj 'llp 'urp))))",
			"      )",
			"      (setq ls1 (mapcar 'min (vlax-safearray->list llp) (cond (ls1) ((vlax-safearray->list llp))))",
			"            ls2 (mapcar 'max (vlax-safearray->list urp) (cond (ls2) ((vlax-safearray->list urp))))",
			"      )",
			"    )",
			"  )",
			"  (if (and ls1 ls2) (list ls1 ls2))",
			")"
		],
		"description": "Returns a list of the lower-left and upper-right WCS coordinates of a\nrectangular frame bounding all objects in a supplied selection set.\nsel - [sel] Selection set for which to return bounding box\nAlternative to the above function"
	},
	// region Selection Set to List
	"SelectionSet -> Entities": {
		"prefix": "Local>>LM:ss->ent",
		"body": [
			";;--------------=={ SelectionSet -> Entities }==--------------;;",
			";;                                                            ;;",
			";;  Converts a SelectionSet to a list of Entities             ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  ss - Valid SelectionSet (Pickset)                         ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of Entity names, else nil                  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ss->ent (ss / i l) ",
			"  (if ss ",
			"    (repeat (setq i (sslength ss)) ",
			"      (setq l (cons (ssname ss (setq i (1- i))) l))",
			"    )",
			"  )",
			")"
		],
		"description": "Converts a SelectionSet to a list of Entities\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nss - Valid SelectionSet (Pickset)\nReturns:  List of Entity names, else nil"
	},
	"SelectionSet -> VLA Objects": {
		"prefix": "Local>>LM:ss->vla",
		"body": [
			";;------------=={ SelectionSet -> VLA Objects }==-------------;;",
			";;                                                            ;;",
			";;  Converts a SelectionSet to a list of VLA Objects          ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  ss - Valid SelectionSet (Pickset)                         ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of VLA Objects, else nil                   ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:ss->vla (ss / i l) ",
			"  (if ss ",
			"    (repeat (setq i (sslength ss)) ",
			"      (setq l (cons (vlax-ename->vla-object (ssname ss (setq i (1- i)))) l))",
			"    )",
			"  )",
			")"
		],
		"description": "Converts a SelectionSet to a list of VLA Objects\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nss - Valid SelectionSet (Pickset)\nReturns:  List of VLA Objects, else nil"
	},
	// region String Subst
	"String Subst": {
		"prefix": "Local>>LM:StringSubst",
		"body": [
			";;--------------------=={ String Subst }==--------------------;;",
			";;                                                            ;;",
			";;  Substitutes a string for all occurrences of another       ;;",
			";;  string within a string.                                   ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  new - string to be substituted for 'old'                  ;;",
			";;  old - string to be replaced                               ;;",
			";;  str - the string to be searched                           ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  String with 'old' replaced with 'new'           ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:StringSubst (new old str / inc len) ",
			"  (setq len (strlen new)",
			"        inc 0",
			"  )",
			"  (while (setq inc (vl-string-search old str inc)) ",
			"    (setq str (vl-string-subst new old str inc)",
			"          inc (+ inc len)",
			"    )",
			"  )",
			"  str",
			")"
		],
		"description": "Substitutes a string for all occurrences of another\nstring within a string.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nnew - string to be substituted for 'old'\nold - string to be replaced\nstr - the string to be searched\nReturns:  String with 'old' replaced with 'new'"
	},
	// region String to List
	"String to List": {
		"prefix": "Local>>LM:str->lst-r",
		"body": [
			";; String to List  -  Lee Mac",
			";; Separates a string using a given delimiter",
			";; str - [str] String to process",
			";; del - [str] Delimiter by which to separate the string",
			";; Returns: [lst] List of strings",
			";;  Recursive",
			"",
			"(defun Local>>LM:str->lst-r (str del / pos) ",
			"  (if (setq pos (vl-string-search del str)) ",
			"    (cons (substr str 1 pos) (Local>>LM:str->lst-r (substr str (+ pos 1 (strlen del))) del))",
			"    (list str)",
			"  )",
			")"
		],
		"description": "Separates a string using a given delimiter\nstr - [str] String to process\ndel - [str] Delimiter by which to separate the string\nReturns: [lst] List of strings\nRecursive"
	},
	"String to List (2)": {
		"prefix": "Local>>LM:str->lst",
		"body": [
			";; String to List  -  Lee Mac",
			";; Separates a string using a given delimiter",
			";; str - [str] String to process",
			";; del - [str] Delimiter by which to separate the string",
			";; Returns: [lst] List of strings",
			";;  Iterative",
			"",
			"(defun Local>>LM:str->lst (str del / len lst pos) ",
			"  (setq len (1+ (strlen del)))",
			"  (while (setq pos (vl-string-search del str)) ",
			"    (setq lst (cons (substr str 1 pos) lst)",
			"          str (substr str (+ pos len))",
			"    )",
			"  )",
			"  (reverse (cons str lst))",
			")"
		],
		"description": "Separates a string using a given delimiter\nstr - [str] String to process\ndel - [str] Delimiter by which to separate the string\nReturns: [lst] List of strings\nIterative"
	},
	// region String Wrap
	"String Wrap": {
		"prefix": "Local>>LM:StringWrap",
		"body": [
			";;---------------------=={ String Wrap }==--------------------;;",
			";;                                                            ;;",
			";;  Breaks a string at spaces (if possible) into a list of    ;;",
			";;  substrings of a specified length or less.                 ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  str - String to wrap to a specific length                 ;;",
			";;  len - Maximum length of each substring                    ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  List of substrings of specified length or less  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:StringWrap (str len / pos) ",
			"  (if (< len (strlen str)) ",
			"    (cons ",
			"      (substr str ",
			"              1",
			"              (cond ",
			"                ((setq pos (vl-string-position 32 (substr str 1 len) nil t)))",
			"                ((setq pos (1- len)) len)",
			"              )",
			"      )",
			"      (Local>>LM:StringWrap (substr str (+ 2 pos)) len)",
			"    )",
			"    (list str)",
			"  )",
			")"
		],
		"description": "Breaks a string at spaces (if possible) into a list of\nsubstrings of a specified length or less.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nstr - String to wrap to a specific length\nlen - Maximum length of each substring\nReturns:  List of substrings of specified length or less"
	},
	// region Sublist
	"Sublst": {
		"prefix": "Local>>LM:sublst-r",
		"body": [
			";; Sublst  -  Lee Mac",
			";; The list analog of the substr function",
			";; lst - [lst] List from which sublist is to be returned",
			";; idx - [int] Zero-based index at which to start the sublist",
			";; len - [int] Length of the sublist or nil to return all items following idx",
			";;  Recursive",
			"",
			"(defun Local>>LM:sublst-r (lst idx len) ",
			"  (cond ",
			"    ((null lst) nil)",
			"    ((< 0 idx) (Local>>LM:sublst-r (cdr lst) (1- idx) len))",
			"    ((null len) lst)",
			"    ((< 0 len) (cons (car lst) (Local>>LM:sublst-r (cdr lst) idx (1- len))))",
			"  )",
			")"
		],
		"description": "The list analog of the substr function\nlst - [lst] List from which sublist is to be returned\nidx - [int] Zero-based index at which to start the sublist\nlen - [int] Length of the sublist or nil to return all items following idx\nRecursive"
	},
	"Sublst (2)": {
		"prefix": "Local>>LM:sublst",
		"body": [
			";; Sublst  -  Lee Mac",
			";; The list analog of the substr function",
			";; lst - [lst] List from which sublist is to be returned",
			";; idx - [int] Zero-based index at which to start the sublist",
			";; len - [int] Length of the sublist or nil to return all items following idx",
			";;  Iterative",
			"",
			"(defun Local>>LM:sublst (lst idx len / rtn) ",
			"  (setq len (if len (min len (- (length lst) idx)) (- (length lst) idx))",
			"        idx (+ idx len)",
			"  )",
			"  (repeat len (setq rtn (cons (nth (setq idx (1- idx)) lst) rtn)))",
			")"
		],
		"description": "The list analog of the substr function\nlst - [lst] List from which sublist is to be returned\nidx - [int] Zero-based index at which to start the sublist\nlen - [int] Length of the sublist or nil to return all items following idx\nIterative"
	},
	// region Subst Once
	"Subst Once": {
		"prefix": "Local>>LM:SubstOnce-r",
		"body": [
			";;---------------------=={ Subst Once }==---------------------;;",
			";;                                                            ;;",
			";;  Substitutes the first occurrence of item 'b' for item 'a' ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  a - item to be substituted                                ;;",
			";;  b - item to be replaced                                   ;;",
			";;  l - list in which to make the substitution                ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Resultant list following the substitution       ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:SubstOnce-r (a b l) ",
			"  (if l ",
			"    (if (equal b (car l)) ",
			"      (cons a (cdr l))",
			"      (cons (car l) (Local>>LM:SubstOnce-r a b (cdr l)))",
			"    )",
			"  )",
			")"
		],
		"description": "Substitutes the first occurrence of item 'b' for item 'a'\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\na - item to be substituted\nb - item to be replaced\nl - list in which to make the substitution\nReturns:  Resultant list following the substitution"
	},
	"Subst Once (2)": {
		"prefix": "Local>>LM:SubstOnce",
		"body": [
			";;---------------------=={ Subst Once }==---------------------;;",
			";;                                                            ;;",
			";;  Substitutes the first occurrence of item 'b' for item 'a' ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  a - item to be substituted                                ;;",
			";;  b - item to be replaced                                   ;;",
			";;  l - list in which to make the substitution                ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Resultant list following the substitution       ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:SubstOnce (a b l) ",
			"  (mapcar ",
			"    '(lambda (x) ",
			"       (if (equal b x) ",
			"         (setq x a",
			"               a nil",
			"               b nil",
			"         )",
			"       )",
			"       x",
			"     )",
			"    l",
			"  )",
			")"
		],
		"description": "Substitutes the first occurrence of item 'b' for item 'a'\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\na - item to be substituted\nb - item to be replaced\nl - list in which to make the substitution\nReturns:  Resultant list following the substitution"
	},
	// region Subst Nth
	"Subst Nth": {
		"prefix": "Local>>LM:SubstNth-r",
		"body": [
			";;---------------------=={ Subst Nth }==----------------------;;",
			";;                                                            ;;",
			";;  Substitutes an item at the nth position in a list.        ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  a - item to substitute                                    ;;",
			";;  n - position in list to make the substitution             ;;",
			";;  l - list in which to make the substitution                ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Resultant list following the substitution       ;;",
			";;------------------------------------------------------------;;",
			";;  Recursive",
			"",
			"(defun Local>>LM:SubstNth-r (a n l) ",
			"  (if l ",
			"    (if (zerop n) ",
			"      (cons a (cdr l))",
			"      (cons (car l) (Local>>LM:SubstNth-r a (1- n) (cdr l)))",
			"    )",
			"  )",
			")"
		],
		"description": "Substitutes an item at the nth position in a list.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\na - item to substitute\nn - position in list to make the substitution\nl - list in which to make the substitution\nReturns:  Resultant list following the substitution\nRecursive"
	},
	"Subst Nth (2)": {
		"prefix": "Local>>LM:SubstNth",
		"body": [
			";;---------------------=={ Subst Nth }==----------------------;;",
			";;                                                            ;;",
			";;  Substitutes an item at the nth position in a list.        ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  a - item to substitute                                    ;;",
			";;  n - position in list to make the substitution             ;;",
			";;  l - list in which to make the substitution                ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Resultant list following the substitution       ;;",
			";;------------------------------------------------------------;;",
			";;  Iterative",
			"",
			"(defun Local>>LM:SubstNth (a n l / i) ",
			"  (setq i -1)",
			"  (mapcar '(lambda (x) (if (= (setq i (1+ i)) n) a x)) l)",
			")"
		],
		"description": "Substitutes an item at the nth position in a list.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\na - item to substitute\nn - position in list to make the substitution\nl - list in which to make the substitution\nReturns:  Resultant list following the substitution\nIterative"
	},
	// region Text Case Functions
	"Sentence Case": {
		"prefix": "Local>>LM:SentenceCase",
		"body": [
			";; Sentence Case - Lee Mac",
			";; Returns the supplied string converted to Sentence Case",
			"",
			"(defun Local>>LM:SentenceCase (s / f) ",
			"  (vl-list->string ",
			"    (mapcar ",
			"      (function ",
			"        (lambda (a b c) ",
			"          (if (or f (= 46 a)) (progn (setq f (= 32 b)) b) c)",
			"        )",
			"      )",
			"      (cons 46 (vl-string->list s))",
			"      (vl-string->list (strcase s))",
			"      (vl-string->list (strcase s t))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the supplied string converted to Sentence Case"
	},
	"Title Case": {
		"prefix": "Local>>LM:TitleCase",
		"body": [
			";; Title Case - Lee Mac",
			";; Returns the supplied string converted to Title Case",
			"",
			"(defun Local>>LM:TitleCase (s) ",
			"  (vl-list->string ",
			"    (mapcar ",
			"      (function ",
			"        (lambda (a b c) (if (= 32 a) b c))",
			"      )",
			"      (cons 32 (vl-string->list s))",
			"      (vl-string->list (strcase s))",
			"      (vl-string->list (strcase s t))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the supplied string converted to Title Case"
	},
	"Toggle Case": {
		"prefix": "Local>>LM:ToggleCase",
		"body": [
			";; Toggle Case - Lee Mac",
			";; Returns the supplied string with the text case of each character switched",
			"",
			"(defun Local>>LM:ToggleCase (s) ",
			"  (vl-list->string ",
			"    (mapcar ",
			"      (function ",
			"        (lambda (a b c) (if (< 96 a 123) b c))",
			"      )",
			"      (vl-string->list s)",
			"      (vl-string->list (strcase s))",
			"      (vl-string->list (strcase s t))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns the supplied string with the text case of each character switched"
	},
	// region UnFormat String
	"UnFormat String": {
		"prefix": "Local>>LM:UnFormat",
		"body": [
			";;-------------------=={ UnFormat String }==------------------;;",
			";;                                                            ;;",
			";;  Returns a string with all MText formatting codes removed. ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  str - String to Process                                   ;;",
			";;  mtx - MText Flag (T if string is for use in MText)        ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  String with formatting codes removed            ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:UnFormat (str mtx / _replace rx) ",
			"",
			"  (defun _replace (new old str) ",
			"    (vlax-put-property rx 'pattern old)",
			"    (vlax-invoke rx 'replace str new)",
			"  )",
			"  (if (setq rx (vlax-get-or-create-object \"VBScript.RegExp\")) ",
			"    (progn ",
			"      (setq str (vl-catch-all-apply ",
			"                  (function ",
			"                    (lambda () ",
			"                      (vlax-put-property rx 'global actrue)",
			"                      (vlax-put-property rx 'multiline actrue)",
			"                      (vlax-put-property rx 'ignorecase acfalse)",
			"                      (foreach pair ",
			"                        '((\"\\032\" . \"\\\\\\\\\\\\\\\\\")",
			"                          (\" \" . \"\\\\\\\\P|\\\\n|\\\\t\")",
			"                          (\"\\$1\" . \"\\\\\\\\(\\\\\\\\[ACcFfHLlOopQTW])|\\\\\\\\[ACcFfHLlOopQTW][^\\\\\\\\;]*;|\\\\\\\\[ACcFfHLlOopQTW]\")",
			"                          (\"\\$1\\$2/\\$3\" . \"([^\\\\\\\\])\\\\\\\\S([^;]*)[/#\\\\^]([^;]*);\")",
			"                          (\"\\$1\\$2\" . \"\\\\\\\\(\\\\\\\\S)|[\\\\\\\\](})|}\")",
			"                          (\"\\$1\" . \"[\\\\\\\\]({)|{\")",
			"                         )",
			"                        (setq str (_replace (car pair) (cdr pair) str))",
			"                      )",
			"                      (if mtx ",
			"                        (_replace \"\\\\\\\\\" \"\\032\" (_replace \"\\\\\\$1\\$2\\$3\" \"(\\\\\\\\[ACcFfHLlOoPpQSTW])|({)|(})\" str))",
			"                        (_replace \"\\\\\" \"\\032\" str)",
			"                      )",
			"                    )",
			"                  )",
			"                )",
			"      )",
			"      (vlax-release-object rx)",
			"      (if (null (vl-catch-all-error-p str)) ",
			"        str",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a string with all MText formatting codes removed.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\nstr - String to Process\nmtx - MText Flag (T if string is for use in MText)\nReturns:  String with formatting codes removed"
	},
	// region Unique & Duplicate List Functions
	"Unique": {
		"prefix": "Local>>LM:Unique-r",
		"body": [
			";; Unique  -  Lee Mac",
			";; Returns a list with duplicate elements removed.",
			";;  Recursive",
			"",
			"(defun Local>>LM:Unique-r (l) ",
			"  (if l (cons (car l) (Local>>LM:Unique-r (vl-remove (car l) (cdr l)))))",
			")"
		],
		"description": "Returns a list with duplicate elements removed.\nRecursive"
	},
	"Unique (2)": {
		"prefix": "Local>>LM:Unique",
		"body": [
			";; Unique  -  Lee Mac",
			";; Returns a list with duplicate elements removed.",
			";;  Iterative",
			"",
			"(defun Local>>LM:Unique (l / x r) ",
			"  (while l ",
			"    (setq x (car l)",
			"          l (vl-remove x (cdr l))",
			"          r (cons x r)",
			"    )",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Returns a list with duplicate elements removed.\nIterative"
	},
	"Unique-p": {
		"prefix": "Local>>LM:Unique-p-r",
		"body": [
			";; Unique-p  -  Lee Mac",
			";; Returns T if the supplied list contains distinct items.",
			";;  Recursive",
			"",
			"(defun Local>>LM:Unique-p-r (l) ",
			"  (or (null l) ",
			"      (and (not (member (car l) (cdr l))) ",
			"           (Local>>LM:Unique-p (cdr l))",
			"      )",
			"  )",
			")"
		],
		"description": "Returns T if the supplied list contains distinct items.\nRecursive\nRequires: Local>>LM:Unique-p"
	},
	"Unique-p (2)": {
		"prefix": "Local>>LM:Unique-p",
		"body": [
			";; Unique-p  -  Lee Mac",
			";; Returns T if the supplied list contains distinct items.",
			";;  Iterative",
			"",
			"(defun Local>>LM:Unique-p (l) ",
			"  (vl-every (function (lambda (x) (not (member x (setq l (cdr l)))))) l)",
			")"
		],
		"description": "Returns T if the supplied list contains distinct items.\nIterative"
	},
	"Unique with Fuzz": {
		"prefix": "Local>>LM:UniqueFuzz-r",
		"body": [
			";; Unique with Fuzz  -  Lee Mac",
			";; Returns a list with all elements considered duplicate to",
			";; a given tolerance removed.",
			";;  Recursive",
			"",
			"(defun Local>>LM:UniqueFuzz-r (l f) ",
			"  (if l ",
			"    (cons (car l) ",
			"          (Local>>LM:UniqueFuzz-r ",
			"            (vl-remove-if ",
			"              (function (lambda (x) (equal x (car l) f)))",
			"              (cdr l)",
			"            )",
			"            f",
			"          )",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list with all elements considered duplicate to\na given tolerance removed.\nRecursive"
	},
	"Unique-p with Fuzz": {
		"prefix": "Local>>LM:UniqueFuzz-p-r",
		"body": [
			";; Unique-p with Fuzz  -  Lee Mac",
			";; Returns T if a list contains items considered distinct to",
			";; a given tolerance",
			";;  Recursive",
			"",
			"(defun Local>>LM:UniqueFuzz-p-r (l f) ",
			"  (or (null l) ",
			"      (and (not (vl-some (function (lambda (x) (equal x (car l) f))) (cdr l))) ",
			"           (Local>>LM:UniqueFuzz-p-r (cdr l) f)",
			"      )",
			"  )",
			")"
		],
		"description": "Returns T if a list contains items considered distinct to\na given tolerance\nRecursive"
	},
	"Unique-p with Fuzz (2)": {
		"prefix": "Local>>LM:UniqueFuzz-p",
		"body": [
			";; Unique-p with Fuzz  -  Lee Mac",
			";; Returns T if a list contains items considered distinct to",
			";; a given tolerance",
			";;  Iterative",
			"",
			"(defun Local>>LM:UniqueFuzz-p (l f) ",
			"  (vl-every ",
			"    (function ",
			"      (lambda (x) ",
			"        (not ",
			"          (vl-some ",
			"            (function ",
			"              (lambda (y) (equal x y f))",
			"            )",
			"            (setq l (cdr l))",
			"          )",
			"        )",
			"      )",
			"    )",
			"    l",
			"  )",
			")"
		],
		"description": "Returns T if a list contains items considered distinct to\na given tolerance\nIterative"
	},
	"Unique with Fuzz (2)": {
		"prefix": "Local>>LM:UniqueFuzz",
		"body": [
			";; Unique with Fuzz  -  Lee Mac",
			";; Returns a list with all elements considered duplicate to",
			";; a given tolerance removed.",
			";;  Iterative",
			"",
			"(defun Local>>LM:UniqueFuzz (l f / x r) ",
			"  (while l ",
			"    (setq x (car l)",
			"          l (vl-remove-if (function (lambda (y) (equal x y f))) (cdr l))",
			"          r (cons x r)",
			"    )",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Returns a list with all elements considered duplicate to\na given tolerance removed.\nIterative"
	},
	"List Duplicates": {
		"prefix": "Local>>LM:ListDupes-r",
		"body": [
			";; List Duplicates  -  Lee Mac",
			";; Returns a list of items appearing more than once in a supplied list",
			";;  Recursive",
			"",
			"(defun Local>>LM:ListDupes-r (l) ",
			"  (if l ",
			"    (if (member (car l) (cdr l)) ",
			"      (cons (car l) (Local>>LM:ListDupes-r (vl-remove (car l) (cdr l))))",
			"      (Local>>LM:ListDupes-r (vl-remove (car l) (cdr l)))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list of items appearing more than once in a supplied list\nRecursive"
	},
	"List Duplicates (2)": {
		"prefix": "Local>>LM:ListDupes",
		"body": [
			";; List Duplicates  -  Lee Mac",
			";; Returns a list of items appearing more than once in a supplied list",
			";;  Iterative",
			"",
			"(defun Local>>LM:ListDupes (l / x r) ",
			"  (while l ",
			"    (if (member (setq x (car l)) (cdr l)) ",
			"      (setq r (cons x r))",
			"    )",
			"    (setq l (vl-remove x (cdr l)))",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Returns a list of items appearing more than once in a supplied list\nIterative"
	},
	"Count Items": {
		"prefix": "Local>>LM:CountItems-r",
		"body": [
			";; Count Items  -  Lee Mac",
			";; Returns a list of dotted pairs detailing the number of",
			";; occurrences of each item in a supplied list.",
			";;  Recursive",
			"",
			"(defun Local>>LM:CountItems-r (l / c x) ",
			"  (if (setq x (car l)) ",
			"    (progn ",
			"      (setq c (length l)",
			"            l (vl-remove x (cdr l))",
			"      )",
			"      (cons (cons x (- c (length l))) (Local>>LM:CountItems-r l))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list of dotted pairs detailing the number of\noccurrences of each item in a supplied list.\nRecursive"
	},
	"Count Items (2)": {
		"prefix": "Local>>LM:CountItems",
		"body": [
			";; Count Items  -  Lee Mac",
			";; Returns a list of dotted pairs detailing the number of",
			";; occurrences of each item in a supplied list.",
			";;  Iterative",
			"",
			"(defun Local>>LM:CountItems (l / c l r x) ",
			"  (while l ",
			"    (setq x (car l)",
			"          c (length l)",
			"          l (vl-remove x (cdr l))",
			"          r (cons (cons x (- c (length l))) r)",
			"    )",
			"  )",
			"  (reverse r)",
			")"
		],
		"description": "Returns a list of dotted pairs detailing the number of\noccurrences of each item in a supplied list.\nIterative"
	},
	// region Write CSV
	"Write CSV": {
		"prefix": "Local>>LM:writecsv",
		"body": [
			";; Write CSV  -  Lee Mac",
			";; Writes a matrix list of cell values to a CSV file.",
			";; lst - [lst] list of lists, sublist is row of cell values",
			";; csv - [str] filename of CSV file to write",
			";; Returns T if successful, else nil",
			"",
			"(defun Local>>LM:writecsv (lst csv / des sep) ",
			"  (if (setq des (open csv \"w\")) ",
			"    (progn ",
			"      (setq sep (cond ((vl-registry-read \"HKEY_CURRENT_USER\\\\Control Panel\\\\International\" \"sList\")) (\",\")))",
			"      (foreach row lst (write-line (Local>>LM:lst->csv row sep) des))",
			"      (close des)",
			"      t",
			"    )",
			"  )",
			")"
		],
		"description": "Writes a matrix list of cell values to a CSV file.\nlst - [lst] list of lists, sublist is row of cell values\ncsv - [str] filename of CSV file to write\nReturns T if successful, else nil\nRequires: Local>>LM:lst->csv"
	},
	"List -> CSV": {
		"prefix": "Local>>LM:lst->csv",
		"body": [
			";; List -> CSV  -  Lee Mac",
			";; Concatenates a row of cell values to be written to a CSV file.",
			";; lst - [lst] list containing row of CSV cell values",
			";; sep - [str] CSV separator token",
			"",
			"(defun Local>>LM:lst->csv (lst sep) ",
			"  (if (cdr lst) ",
			"    (strcat (Local>>LM:csv-addquotes (car lst) sep) sep (Local>>LM:lst->csv (cdr lst) sep))",
			"    (Local>>LM:csv-addquotes (car lst) sep)",
			"  )",
			")"
		],
		"description": "Concatenates a row of cell values to be written to a CSV file.\nlst - [lst] list containing row of CSV cell values\nsep - [str] CSV separator token\nRequires: Local>>LM:csv-addquotes"
	},
	"csv-addquotes": {
		"prefix": "Local>>LM:csv-addquotes",
		"body": [
			"",
			"(defun Local>>LM:csv-addquotes (str sep / pos) ",
			"  (cond ",
			"    ((wcmatch str (strcat \"*[`\" sep \"\\\"]*\"))",
			"     (setq pos 0)",
			"     (while (setq pos (vl-string-position 34 str pos)) ",
			"       (setq str (vl-string-subst \"\\\"\\\"\" \"\\\"\" str pos)",
			"             pos (+ pos 2)",
			"       )",
			"     )",
			"     (strcat \"\\\"\" str \"\\\"\")",
			"    )",
			"    (str)",
			"  )",
			")"
		],
		"description": ""
	},
	// region XRef Path Conversion
	"Relative Path to Full Path": {
		"prefix": "Local>>LM:XRef:Relative->Full",
		"body": [
			";;-------------=={ Relative Path to Full Path }==-------------;;",
			";;                                                            ;;",
			";;  Converts a Relative XRef path to a Full Path.             ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  dir  - Directory of the Drawing in which the Xref resides ;;",
			";;  path - Relative Xref Path                                 ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Full XRef Path                                  ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:XRef:Relative->Full (dir path) ",
			"  (setq dir (vl-string-right-trim \"\\\\\" dir))",
			"  (cond ",
			"    ((eq \"..\" (substr path 1 2))",
			"     (Local>>LM:XRef:Relative->Full ",
			"       (substr dir 1 (vl-string-position 92 dir nil t))",
			"       (substr path 4)",
			"     )",
			"    )",
			"    ((eq \".\" (substr path 1 1))",
			"     (strcat dir (substr path 2))",
			"    )",
			"    ((strcat dir \"\\\\\" path))",
			"  )",
			")"
		],
		"description": "Converts a Relative XRef path to a Full Path.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ndir  - Directory of the Drawing in which the Xref resides\npath - Relative Xref Path\nReturns:  Full XRef Path"
	},
	"Full Path to Relative Path": {
		"prefix": "Local>>LM:XRef:Full->Relative",
		"body": [
			";;-------------=={ Full Path to Relative Path }==-------------;;",
			";;                                                            ;;",
			";;  Converts a Full XRef path to a Relative Path.             ;;",
			";;------------------------------------------------------------;;",
			";;  Author: Lee Mac, Copyright © 2011 - www.lee-mac.com       ;;",
			";;------------------------------------------------------------;;",
			";;  Arguments:                                                ;;",
			";;  dir  - Directory of the Drawing in which the Xref resides ;;",
			";;  path - Full Xref Path                                     ;;",
			";;------------------------------------------------------------;;",
			";;  Returns:  Relative XRef Path                              ;;",
			";;------------------------------------------------------------;;",
			"",
			"(defun Local>>LM:XRef:Full->Relative (dir path / p q) ",
			"  (setq dir (vl-string-right-trim \"\\\\\" dir))",
			"  (cond ",
			"    ((and ",
			"       (setq p (vl-string-position 58 dir))",
			"       (setq q (vl-string-position 58 path))",
			"       (not (eq (strcase (substr dir 1 p)) (strcase (substr path 1 q))))",
			"     )",
			"     path",
			"    )",
			"    ((and ",
			"       (setq p (vl-string-position 92 dir))",
			"       (setq q (vl-string-position 92 path))",
			"       (eq (strcase (substr dir 1 p)) (strcase (substr path 1 q)))",
			"     )",
			"     (Local>>LM:Xref:Full->Relative (substr dir (+ 2 p)) (substr path (+ 2 q)))",
			"    )",
			"    ((and ",
			"       (setq q (vl-string-position 92 path))",
			"       (eq (strcase dir) (strcase (substr path 1 q)))",
			"     )",
			"     (strcat \".\\\\\" (substr path (+ 2 q)))",
			"    )",
			"    ((eq \"\" dir)",
			"     path",
			"    )",
			"    ((setq p (vl-string-position 92 dir))",
			"     (Local>>LM:Xref:Full->Relative (substr dir (+ 2 p)) (strcat \"..\\\\\" path))",
			"    )",
			"    ((Local>>LM:Xref:Full->Relative \"\" (strcat \"..\\\\\" path)))",
			"  )",
			")"
		],
		"description": "Converts a Full XRef path to a Relative Path.\nAuthor: Lee Mac, Copyright © 2011 - www.lee-mac.com\nArguments:\ndir  - Directory of the Drawing in which the Xref resides\npath - Full Xref Path\nReturns:  Relative XRef Path"
	},
