	// region Entity to Point List
	"Entity to Point List": {
		"prefix": "Local>>LM:ent->pts",
		"body": [
			";; Entity to Point List  -  Lee Mac",
			";; Returns a list of WCS points describing or approximating the supplied entity, else nil if the entity is not supported.",
			";; ent - [ent] Entity name to be described by point list (POINT/LINE/ARC/CIRCLE/LWPOLYLINE/POLYLINE/ELLIPSE/SPLINE)",
			";; acc - [num] Positive number determining the point density for non-linear objects",
			"",
			"(defun Local>>LM:ent->pts (ent acc / ang bul cen cls di1 di2 enx inc itm lst num ocs rad tot typ vt1 vt2 vtl) ",
			"  (setq enx (entget ent)",
			"        typ (cdr (assoc 0 enx))",
			"  )",
			"  (cond ",
			"    ((= \"POINT\" typ)",
			"     (list (cdr (assoc 10 enx)))",
			"    )",
			"    ((= \"LINE\" typ)",
			"     (mapcar '(lambda (x) (cdr (assoc x enx))) '(10 11))",
			"    )",
			"    ((or (= \"ARC\" typ) (= \"CIRCLE\" typ))",
			"     (if (= \"ARC\" typ) ",
			"       (setq ang (cdr (assoc 50 enx))",
			"             tot (rem (+ pi pi (- (cdr (assoc 51 enx)) ang)) (+ pi pi))",
			"             num (fix (+ 1.0 1e-8 (* acc (/ tot (+ pi pi)))))",
			"             inc (/ tot (float num))",
			"             num (1+ num)",
			"       )",
			"       (setq ang 0.0",
			"             tot (+ pi pi)",
			"             num (fix (+ 1e-8 acc))",
			"             inc (/ tot (float num))",
			"       )",
			"     )",
			"     (setq cen (cdr (assoc 010 enx))",
			"           rad (cdr (assoc 040 enx))",
			"           ocs (cdr (assoc 210 enx))",
			"     )",
			"     (repeat num ",
			"       (setq lst (cons (trans (polar cen ang rad) ocs 0) lst)",
			"             ang (+ ang inc)",
			"       )",
			"     )",
			"     (reverse lst)",
			"    )",
			"    ((or (= \"LWPOLYLINE\" typ) ",
			"         (and (= \"POLYLINE\" typ) (zerop (logand (logior 16 64) (cdr (assoc 70 enx)))))",
			"     )",
			"     (if (= \"LWPOLYLINE\" typ) ",
			"       (setq vtl (Local>>LM:ent->pts:lwpolyvertices enx))",
			"       (setq vtl (Local>>LM:ent->pts:polyvertices ent))",
			"     )",
			"     (if ",
			"       (setq ocs (cdr (assoc 210 enx))",
			"             cls (= 1 (logand 1 (cdr (assoc 70 enx))))",
			"       )",
			"       (setq vtl (append vtl (list (cons (caar vtl) 0.0))))",
			"     )",
			"     (while (setq itm (car vtl)) ",
			"       (setq vtl (cdr vtl)",
			"             vt1 (car itm)",
			"             bul (cdr itm)",
			"             lst (cons (trans vt1 ocs 0) lst)",
			"       )",
			"       (if (and (not (equal 0.0 bul 1e-8)) (setq vt2 (caar vtl))) ",
			"         (progn ",
			"           (setq rad (/ (* (distance vt1 vt2) (1+ (* bul bul))) 4.0 bul)",
			"                 cen (polar vt1 ",
			"                            (+ (angle vt1 vt2) (- (/ pi 2.0) (* 2.0 (atan bul))))",
			"                            rad",
			"                     )",
			"                 rad (abs rad)",
			"                 tot (* 4.0 (atan bul))",
			"                 num (fix (+ 1.0 1e-8 (* acc (/ (abs tot) (+ pi pi)))))",
			"                 inc (/ tot (float num))",
			"                 ang (+ (angle cen vt1) inc)",
			"           )",
			"           (repeat (1- num) ",
			"             (setq lst (cons (trans (polar cen ang rad) ocs 0) lst)",
			"                   ang (+ ang inc)",
			"             )",
			"           )",
			"         )",
			"       )",
			"     )",
			"     (reverse (if cls (cdr lst) lst))",
			"    )",
			"    ((= \"ELLIPSE\" typ)",
			"     (setq di1 (vlax-curve-getdistatparam ent (vlax-curve-getstartparam ent))",
			"           di2 (vlax-curve-getdistatparam ent (vlax-curve-getendparam ent))",
			"           di2 (- di2 1e-8)",
			"     )",
			"     (while (< di1 di2) ",
			"       (setq lst (cons (vlax-curve-getpointatdist ent di1) lst)",
			"             rad (distance '(0.0 0.0) ",
			"                           (vlax-curve-getfirstderiv ent ",
			"                                                     (vlax-curve-getparamatdist ent di1)",
			"                           )",
			"                 )",
			"             di1 (+ di1 (/ di2 (1+ (fix (* acc (/ di2 rad (+ pi pi)))))))",
			"       )",
			"     )",
			"     (reverse (if (vlax-curve-isclosed ent) lst (cons (vlax-curve-getendpoint ent) lst)))",
			"    )",
			"    ((= \"SPLINE\" typ)",
			"     (setq di1 (vlax-curve-getdistatparam ent (vlax-curve-getstartparam ent))",
			"           di2 (vlax-curve-getdistatparam ent (vlax-curve-getendparam ent))",
			"           lst (list (vlax-curve-getstartpoint ent))",
			"           inc (/ (- di2 di1) (float acc))",
			"           di1 (+ di1 inc)",
			"     )",
			"     (repeat (1- (fix (+ 1e-8 acc))) ",
			"       (setq lst (cons (vlax-curve-getpointatdist ent di1) lst)",
			"             di1 (+ di1 inc)",
			"       )",
			"     )",
			"     (reverse (if (vlax-curve-isclosed ent) lst (cons (vlax-curve-getendpoint ent) lst)))",
			"    )",
			"  )",
			")"
		],
		"description": "Returns a list of WCS points describing or approximating the supplied entity, else nil if the entity is not supported.\nent - [ent] Entity name to be described by point list (POINT/LINE/ARC/CIRCLE/LWPOLYLINE/POLYLINE/ELLIPSE/SPLINE)\nacc - [num] Positive number determining the point density for non-linear objects\nRequires: Local>>LM:ent->pts:lwpolyvertices, Local>>LM:ent->pts:polyvertices"
	},
	"ent->pts:lwpolyvertices": {
		"prefix": "Local>>LM:ent->pts:lwpolyvertices",
		"body": [
			"",
			"(defun Local>>LM:ent->pts:lwpolyvertices (enx / elv lst vtx) ",
			"  (setq elv (list (cdr (assoc 38 enx))))",
			"  (while (setq vtx (assoc 10 enx)) ",
			"    (setq enx (cdr (member vtx enx))",
			"          lst (cons (cons (append (cdr vtx) elv) (cdr (assoc 42 enx))) lst)",
			"    )",
			"  )",
			"  (reverse lst)",
			")"
		],
		"description": ""
	},
	"ent->pts:polyvertices": {
		"prefix": "Local>>LM:ent->pts:polyvertices",
		"body": [
			"",
			"(defun Local>>LM:ent->pts:polyvertices (ent / lst vte vtx) ",
			"  (setq vte (entnext ent)",
			"        vtx (entget vte)",
			"  )",
			"  (while (= \"VERTEX\" (cdr (assoc 0 vtx))) ",
			"    (setq lst (cons (cons (cdr (assoc 10 vtx)) (cdr (assoc 42 vtx))) lst)",
			"          vte (entnext vte)",
			"          vtx (entget vte)",
			"    )",
			"  )",
			"  (reverse lst)",
			")"
		],
		"description": ""
	},
	// region Escape Wildcards
	"Escape Wildcards (Iterative)": {
		"prefix": "Local>>LM:escapewildcards",
		"body": [
			";; Escape Wildcards (Iterative)  -  Lee Mac",
			";; Escapes wildcard special characters in a supplied string",
			"",
			"(defun Local>>LM:escapewildcards (str) ",
			"  (vl-list->string ",
			"    (apply 'append ",
			"           (mapcar ",
			"             '(lambda (c) ",
			"                (if (member c '(35 64 46 42 63 126 91 93 45 44)) ",
			"                  (list 96 c)",
			"                  (list c)",
			"                )",
			"              )",
			"             (vl-string->list str)",
			"           )",
			"    )",
			"  )",
			")"
		],
		"description": "Escapes wildcard special characters in a supplied string"
	},
	"Escape Wildcards (Recursive)": {
		"prefix": "Local>>LM:escapewildcards-r",
		"body": [
			";; Escape Wildcards (Recursive)  -  Lee Mac",
			";; Escapes wildcard special characters in a supplied string",
			"",
			"(defun Local>>LM:escapewildcards-r (str) ",
			"  (if (wcmatch str \"*[-#@.*?~`[`,]*,*`]*\") ",
			"    (if (wcmatch str \"[-#@.*?~`[`,]*,`]*\") ",
			"      (strcat \"`\" (substr str 1 1) (Local>>LM:escapewildcards (substr str 2)))",
			"      (strcat (substr str 1 1) (Local>>LM:escapewildcards (substr str 2)))",
			"    )",
			"    str",
			"  )",
			")"
		],
		"description": "Escapes wildcard special characters in a supplied string\nRequires: Local>>LM:escapewildcards"
	},
	// region Evaluate Once on Startup
	"Evaluate Once on Startup": {
		"prefix": "Local>>LM:evalonceonstartup",
		"body": [
			";; Evaluate Once on Startup  -  Lee Mac",
			";; Writes expressions to an existing or temporary acaddoc.lsp to be evaluated on drawing startup,",
			";; with the acaddoc.lsp restored to its original state or deleted following evaluation.",
			";;",
			";; Call with quoted expressions to be evaluated, e.g.:",
			";; (Local>>LM:evalonceonstartup '((lambda ( / foo ) (setq foo 10.0) (print foo) (princ))))",
			";;",
			";; Function returns T if expressions are written successfully.",
			"",
			"(defun Local>>LM:evalonceonstartup (expr / *error* cnt des lsp tmp) ",
			"",
			"  (defun *error* (msg) ",
			"    (if (= 'file (type des)) (close des))",
			"    (if (not (wcmatch (strcase msg t) \"*break,*cancel*,*exit*\")) ",
			"      (princ (strcat \"\\nError: \" msg))",
			"    )",
			"    (princ)",
			"  )",
			"",
			"  ;; If acaddoc.lsp already exists, check how many lines it has",
			"  (if ",
			"    (and (setq lsp (findfile \"acaddoc.lsp\")) ",
			"         (setq des (open lsp \"r\"))",
			"    )",
			"    (progn ",
			"      (setq cnt 0)",
			"      (while (read-line des) (setq cnt (1+ cnt)))",
			"      (setq des (close des))",
			"    )",
			"  )",
			"",
			"  ;; Write expressions to new/existing acaddoc.lsp",
			"  (if ",
			"    (or (and lsp (setq des (open lsp \"a\"))) ",
			"        (setq des (open ",
			"                    (setq tmp (strcat ",
			"                                (vl-string-right-trim \"\\\\\" ",
			"                                                      (vl-string-translate \"/\" ",
			"                                                                           \"\\\\\"",
			"                                                                           (getvar 'roamablerootprefix)",
			"                                                      )",
			"                                )",
			"                                \"\\\\Support\\\\acaddoc.lsp\"",
			"                              )",
			"                    )",
			"                    \"w\"",
			"                  )",
			"        )",
			"    )",
			"    (progn ",
			"      ;; Write blank line in case we are appending",
			"      (write-line \"\" des)",
			"",
			"      ;; Write expressions to be evaluated on startup",
			"      (write-line ",
			"        (strcat ",
			"          \"(defun Local>>LM:evalonceonstartup:eval nil \"",
			"          (vl-prin1-to-string expr)",
			"          \")\"",
			"        )",
			"        des",
			"      )",
			"",
			"      ;; If acaddoc.lsp already existed, construct expressions to restore it",
			"      (if (= 'str (type lsp)) ",
			"        (write-line ",
			"          (strcat ",
			"            \"(defun Local>>LM:evalonceonstartup:clean ( / des lsp lst )\"",
			"            \"    (if\"",
			"            \"        (and\"",
			"            \"            (setq lsp (findfile \"",
			"            (vl-prin1-to-string lsp)",
			"            \"))\"",
			"            \"            (setq des (open lsp \\\"r\\\"))\"",
			"            \"        )\"",
			"            \"        (progn\"",
			"            \"            (repeat \"",
			"            (itoa cnt)",
			"            \"                (setq lst (cons (read-line des) lst))\"",
			"            \"            )\"",
			"            \"            (close des)\"",
			"            \"            (if (setq des (open lsp \\\"w\\\"))\"",
			"            \"                (progn\"",
			"            \"                    (foreach x (reverse lst) (write-line x des))\"",
			"            \"                    (close des)\"",
			"            \"                )\"",
			"            \"            )\"",
			"            \"        )\"",
			"            \"    )\"",
			"            \")\"",
			"          )",
			"          des",
			"        )",
			"        ;; Else delete it",
			"        (write-line ",
			"          (strcat ",
			"            \"(defun Local>>LM:evalonceonstartup:clean ( / lsp )\"",
			"            \"    (if (setq lsp (findfile \"",
			"            (vl-prin1-to-string tmp)",
			"            \"))\"",
			"            \"        (vl-file-delete lsp)\"",
			"            \"    )\"",
			"            \")\"",
			"          )",
			"          des",
			"        )",
			"      )",
			"",
			"      ;; Construct s::startup function",
			"      (write-line ",
			"        (vl-prin1-to-string ",
			"          (quote ",
			"            (if (= 'list (type s::startup)) ",
			"              (setq s::startup (append s::startup ",
			"                                       '((Local>>LM:evalonceonstartup:eval)",
			"                                         (Local>>LM:evalonceonstartup:clean)",
			"                                        )",
			"                               )",
			"              )",
			"              (defun-q s::startup nil ",
			"                (Local>>LM:evalonceonstartup:eval)",
			"                (Local>>LM:evalonceonstartup:clean)",
			"              )",
			"            )",
			"          )",
			"        )",
			"        des",
			"      )",
			"",
			"      (setq des (close des))",
			"      t",
			"    )",
			"  )",
			")"
		],
		"description": "Writes expressions to an existing or temporary acaddoc.lsp to be evaluated on drawing startup,\nwith the acaddoc.lsp restored to its original state or deleted following evaluation.\nCall with quoted expressions to be evaluated, e.g.:\n(Local>>LM:evalonceonstartup '((lambda ( / foo ) (setq foo 10.0) (print foo) (princ))))\nFunction returns T if expressions are written successfully."
	},
	// region Explore
	"Explore": {
		"prefix": "Local>>LM:explore",
		"body": [
			";; Explore  -  Lee Mac",
			";; Opens a specified folder in a Windows Explorer window.",
			";; target - [int/str] Directory or ShellSpecialFolderConstants enum",
			"",
			"(defun Local>>LM:explore (Local>>LM:target / rtn shl) ",
			"  (if ",
			"    (and (or (= 'int (type target)) (vl-file-directory-p target)) ",
			"         (setq shl (vla-getinterfaceobject (vlax-get-acad-object) \"shell.application\"))",
			"    )",
			"    (progn ",
			"      (setq rtn (vl-catch-all-apply 'vlax-invoke (list shl 'explore target)))",
			"      (vlax-release-object shl)",
			"      (if (vl-catch-all-error-p rtn) ",
			"        (prompt (vl-catch-all-error-message rtn))",
			"        t",
			"      )",
			"    )",
			"  )",
			")"
		],
		"description": "Opens a specified folder in a Windows Explorer window.\ntarget - [int/str] Directory or ShellSpecialFolderConstants enum"
	},
	// region Field Code
	"Field Code": {
		"prefix": "Local>>LM:fieldcode",
		"body": [
			";; Field Code  -  Lee Mac",
			";; Returns the field expression associated with an entity",
			"",
			"(defun Local>>LM:fieldcode (ent / replacefield replaceobject fieldstring enx) ",
			"",
			"  (defun replacefield (str enx / ent fld pos) ",
			"    (if (setq pos (vl-string-search \"\\\\_FldIdx\" (setq str (replaceobject str enx)))) ",
			"      (progn ",
			"        (setq ent (assoc 360 enx)",
			"              fld (entget (cdr ent))",
			"        )",
			"        (strcat ",
			"          (substr str 1 pos)",
			"          (replacefield (fieldstring fld) fld)",
			"          (replacefield ",
			"            (substr str (1+ (vl-string-search \">%\" str pos)))",
			"            (cdr (member ent enx))",
			"          )",
			"        )",
			"      )",
			"      str",
			"    )",
			"  )",
			"",
			"  (defun replaceobject (str enx / ent pos) ",
			"    (if (setq pos (vl-string-search \"ObjIdx\" str)) ",
			"      (strcat ",
			"        (substr str 1 (+ pos 5))",
			"        \" \"",
			"        (Local>>LM:ObjectID (vlax-ename->vla-object (cdr (setq ent (assoc 331 enx)))))",
			"        (replaceobject ",
			"          (substr str (1+ (vl-string-search \">%\" str pos)))",
			"          (cdr (member ent enx))",
			"        )",
			"      )",
			"      str",
			"    )",
			"  )",
			"",
			"  (defun fieldstring (enx / itm) ",
			"    (if (setq itm (assoc 3 enx)) ",
			"      (strcat (cdr itm) (fieldstring (cdr (member itm enx))))",
			"      (cond ((cdr (assoc 2 enx))) (\"\"))",
			"    )",
			"  )",
			"",
			"  (if ",
			"    (and ",
			"      (wcmatch (cdr (assoc 0 (setq enx (entget ent)))) ",
			"               \"TEXT,MTEXT,ATTRIB,MULTILEADER,*DIMENSION\"",
			"      )",
			"      (setq enx (cdr (assoc 360 enx)))",
			"      (setq enx (dictsearch enx \"ACAD_FIELD\"))",
			"      (setq enx (dictsearch (cdr (assoc -1 enx)) \"TEXT\"))",
			"    )",
			"    (replacefield (fieldstring enx) enx)",
			"  )",
			")"
		],
		"description": "Returns the field expression associated with an entity\nRequires: Local>>LM:ObjectID"
	},
	// region Field Objects
	"Field Objects": {
		"prefix": "Local>>LM:fieldobjects",
		"body": [
			";; Field Objects  -  Lee Mac",
			";; Returns a list of entities referenced by a supplied field",
			";; ent - [ent] Entity containing field (Text / MText / Attribute)",
			";; Returns: [lst] List of entities referenced by Field, else nil",
			"",
			"(defun Local>>LM:fieldobjects (ent / _getfieldobjects) ",
			"",
			"  (defun _getfieldobjects (a) ",
			"    (apply 'append ",
			"           (mapcar ",
			"             '(lambda (a) ",
			"                (if (= 360 (car a)) ",
			"                  (_getfieldobjects (cdr a))",
			"                  (if (= 331 (car a)) (list (cdr a)))",
			"                )",
			"              )",
			"             (entget a)",
			"           )",
			"    )",
			"  )",
			"",
			"  (if ",
			"    (and (wcmatch (cdr (assoc 0 (setq ent (entget ent)))) \"TEXT,MTEXT,ATTRIB\") ",
			"         (setq ent (cdr (assoc 360 ent)))",
			"         (setq ent (dictsearch ent \"acad_field\"))",
			"         (setq ent (dictsearch (cdr (assoc -1 ent)) \"text\"))",
			"    )",
			"    (_getfieldobjects (cdr (assoc -1 ent)))",
			"  )",
			")"
		],
		"description": "Returns a list of entities referenced by a supplied field\nent - [ent] Entity containing field (Text / MText / Attribute)\nReturns: [lst] List of entities referenced by Field, else nil"
	},
	// region Find File
	"Findfile": {
		"prefix": "Local>>LM:findfile",
		"body": [
			";; Findfile  -  Lee Mac",
			";; Searches the supplied directory and all subdirectories of the supplied directory for the specified file.",
			";; fnm - [str] File to search, e.g. \"MyFile.txt\"",
			";; dir - [str] Root directory",
			";; Returns: [str] Full filename of file if found, else nil.",
			"",
			"(defun Local>>LM:findfile (fnm dir) ",
			"  (setq dir (vl-string-right-trim \"\\\\\" (vl-string-translate \"/\" \"\\\\\" dir)))",
			"  (cond ",
			"    ((findfile (strcat dir \"\\\\\" fnm)))",
			"    ((vl-some '(lambda (x) (Local>>LM:findfile fnm (strcat dir \"\\\\\" x))) ",
			"              (vl-remove \".\" (vl-remove \"..\" (vl-directory-files dir nil -1)))",
			"     )",
			"    )",
			"  )",
			")"
		],
		"description": "Searches the supplied directory and all subdirectories of the supplied directory for the specified file.\nfnm - [str] File to search, e.g. \"MyFile.txt\"\ndir - [str] Root directory\nReturns: [str] Full filename of file if found, else nil."
	},
	// region Flatten List
	"Flatten List": {
		"prefix": "Local>>LM:flatten",
		"body": [
			";; Flatten List  -  Lee Mac",
			";; Transforms a nested list into a non-nested list",
			"",
			"(defun Local>>LM:flatten (l) ",
			"  (if (atom l) ",
			"    (list l)",
			"    (append (Local>>LM:flatten (car l)) (if (cdr l) (Local>>LM:flatten (cdr l))))",
			"  )",
			")"
		],
		"description": "Transforms a nested list into a non-nested list"
	},
	"Flatten List (2)": {
		"prefix": "Local>>LM:flatten-nils",
		"body": [
			";; Flatten List  -  Lee Mac",
			";; Transforms a nested list into a non-nested list with null values removed",
			"",
			"(defun Local>>LM:flatten-nils (l) ",
			"  (if l ",
			"    (if (atom l) ",
			"      (list l)",
			"      (append (Local>>LM:flatten-nils (car l)) (Local>>LM:flatten-nils (cdr l)))",
			"    )",
			"  )",
			")"
		],
		"description": "Transforms a nested list into a non-nested list with null values removed"
	},
	// region Get Anonymous References
	"Get Anonymous References": {
		"prefix": "Local>>LM:getanonymousreferences",
		"body": [
			";; Get Anonymous References  -  Lee Mac",
			";; Returns the names of all anonymous references of a block.",
			";; blk - [str] Block name/wildcard pattern for which to return anon. references",
			"",
			"(defun Local>>LM:getanonymousreferences (blk / ano def lst rec ref) ",
			"  (setq blk (strcase blk))",
			"  (while (setq def (tblnext \"block\" (null def))) ",
			"    (if ",
			"      (and (= 1 (logand 1 (cdr (assoc 70 def)))) ",
			"           (setq rec (entget ",
			"                       (cdr ",
			"                         (assoc 330 ",
			"                                (entget ",
			"                                  (tblobjname \"block\" ",
			"                                              (setq ano (cdr (assoc 2 def)))",
			"                                  )",
			"                                )",
			"                         )",
			"                       )",
			"                     )",
			"           )",
			"      )",
			"      (while ",
			"        (and ",
			"          (not (member ano lst))",
			"          (setq ref (assoc 331 rec))",
			"        )",
			"        (if ",
			"          (and ",
			"            (entget (cdr ref))",
			"            (wcmatch (strcase (Local>>LM:al-effectivename (cdr ref))) blk)",
			"          )",
			"          (setq lst (cons ano lst))",
			"        )",
			"        (setq rec (cdr (member (assoc 331 rec) rec)))",
			"      )",
			"    )",
			"  )",
			"  (reverse lst)",
			")"
		],
		"description": "Returns the names of all anonymous references of a block.\nblk - [str] Block name/wildcard pattern for which to return anon. references\nRequires: Local>>LM:al-effectivename"
	},
	"Effective Block Name (2)": {
		"prefix": "Local>>LM:al-effectivename",
		"body": [
			";; Effective Block Name  -  Lee Mac",
			";; ent - [ent] Block Reference entity",
			"",
			"(defun Local>>LM:al-effectivename (ent / blk rep) ",
			"  (if (wcmatch (setq blk (cdr (assoc 2 (entget ent)))) \"`**\") ",
			"    (if ",
			"      (and ",
			"        (setq rep (cdadr ",
			"                    (assoc -3 ",
			"                           (entget ",
			"                             (cdr ",
			"                               (assoc 330 ",
			"                                      (entget ",
			"                                        (tblobjname \"block\" blk)",
			"                                      )",
			"                               )",
			"                             )",
			"                             '(\"acdbblockrepbtag\")",
			"                           )",
			"                    )",
			"                  )",
			"        )",
			"        (setq rep (handent (cdr (assoc 1005 rep))))",
			"      )",
			"      (setq blk (cdr (assoc 2 (entget rep))))",
			"    )",
			"  )",
			"  blk",
			")"
		],
		"description": "ent - [ent] Block Reference entity"
	},
	// region Get Files Dialog
	"GetFiles": {
		"prefix": "Local>>LM:getfiles",
		"body": [
			";;  GetFiles  -  Lee Mac",
			";;  An analog of the 'getfiled' function for multiple file selection.",
			";;  msg - [str/nil] Dialog box label; 'Select Files' if nil or \"\".",
			";;  def - [str/nil] Default directory; dwgprefix if nil or \"\".",
			";;  ext - [str/nil] File extension filter (e.g. \"dwg;lsp\"); \"*\" if nil",
			";;  Returns: List of selected files, else nil",
			";;  Author:  Lee Mac, Copyright © 2012  -  www.lee-mac.com              ;;",
			"",
			"(defun Local>>LM:getfiles (msg def ext / *error* dch dcl des dir dirdata lst rtn) ",
			"",
			"  (defun *error* (msg) ",
			"    (if (= 'file (type des)) ",
			"      (close des)",
			"    )",
			"    (if (and (= 'int (type dch)) (< 0 dch)) ",
			"      (unload_dialog dch)",
			"    )",
			"    (if (and (= 'str (type dcl)) (findfile dcl)) ",
			"      (vl-file-delete dcl)",
			"    )",
			"    (if (and msg (not (wcmatch (strcase msg t) \"*break,*cancel*,*exit*\"))) ",
			"      (princ (strcat \"\\nError: \" msg))",
			"    )",
			"    (princ)",
			"  )",
			"",
			"  (if ",
			"    (and ",
			"      (setq dcl (vl-filename-mktemp nil nil \".dcl\"))",
			"      (setq des (open dcl \"w\"))",
			"      (progn ",
			"        (foreach x ",
			"          '(\"lst : list_box\" \"{\" \"    width = 40.0;\" \"    height = 20.0;\" \"    fixed_width = true;\" ",
			"            \"    fixed_height = true;\" \"    alignment = centered;\" \"    multiple_select = true;\" \"}\" \"but : button\" \"{\" ",
			"            \"    width = 20.0;\" \"    height = 1.8;\" \"    fixed_width = true;\" \"    fixed_height = true;\" ",
			"            \"    alignment = centered;\" \"}\" \"getfiles : dialog\" \"{\" \"    key = \\\"title\\\"; spacer;\" \"    : row\" \"    {\" ",
			"            \"        alignment = centered;\" \"        : edit_box { key = \\\"dir\\\"; label = \\\"Folder:\\\"; }\" ",
			"            \"        : button\" \"        {\" \"            key = \\\"brw\\\";\" \"            label = \\\"Browse\\\";\" ",
			"            \"            fixed_width = true;\" \"        }\" \"    }\" \"    spacer;\" \"    : row\" \"    {\" \"        : column\" ",
			"            \"        {\" \"            : lst { key = \\\"box1\\\"; }\" ",
			"            \"            : but { key = \\\"add\\\" ; label = \\\"Add Files\\\"; }\" \"        }\" \"        : column {\" ",
			"            \"            : lst { key = \\\"box2\\\"; }\" \"            : but { key = \\\"del\\\" ; label = \\\"Remove Files\\\"; }\" ",
			"            \"        }\" \"    }\" \"    spacer; ok_cancel;\" \"}\"",
			"           )",
			"          (write-line x des)",
			"        )",
			"        (setq des (close des))",
			"        (< 0 (setq dch (load_dialog dcl)))",
			"      )",
			"      (new_dialog \"getfiles\" dch)",
			"    )",
			"    (progn ",
			"      (setq ext (if (= 'str (type ext)) (Local>>LM:getfiles:str->lst (strcase ext) \";\") '(\"*\")))",
			"      (set_tile \"title\" (if (member msg '(nil \"\")) \"Select Files\" msg))",
			"      (set_tile \"dir\" ",
			"                (setq dir (Local>>LM:getfiles:fixdir ",
			"                            (if ",
			"                              (or (member def '(nil \"\")) ",
			"                                  (not (vl-file-directory-p (Local>>LM:getfiles:fixdir def)))",
			"                              )",
			"                              (getvar 'dwgprefix)",
			"                              def",
			"                            )",
			"                          )",
			"                )",
			"      )",
			"      (setq lst (Local>>LM:getfiles:updatefilelist dir ext nil))",
			"      (mode_tile \"add\" 1)",
			"      (mode_tile \"del\" 1)",
			"",
			"      (action_tile \"brw\" ",
			"                   (vl-prin1-to-string ",
			"                     '(if (setq tmp (Local>>LM:getfiles:browseforfolder \"\" nil 512)) ",
			"                        (setq lst (Local>>LM:getfiles:updatefilelist ",
			"                                    (set_tile \"dir\" (setq dir tmp))",
			"                                    ext",
			"                                    rtn",
			"                                  )",
			"                              rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                        )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (action_tile \"dir\" ",
			"                   (vl-prin1-to-string ",
			"                     '(if (= 1 \\$reason) ",
			"                        (setq lst (Local>>LM:getfiles:updatefilelist ",
			"                                    (set_tile \"dir\" ",
			"                                              (setq dir (Local>>LM:getfiles:fixdir \\$value))",
			"                                    )",
			"                                    ext",
			"                                    rtn",
			"                                  )",
			"                              rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                        )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (action_tile \"box1\" ",
			"                   (vl-prin1-to-string ",
			"                     '((lambda (/ itm tmp) ",
			"                         (if ",
			"                           (setq itm (mapcar '(lambda (n) (nth n lst)) ",
			"                                             (read (strcat \"(\" \\$value \")\"))",
			"                                     )",
			"                           )",
			"                           (if (= 4 \\$reason) ",
			"                             (cond ",
			"                               ((equal '(\"..\") itm)",
			"                                (setq lst (Local>>LM:getfiles:updatefilelist ",
			"                                            (set_tile \"dir\" ",
			"                                                      (setq dir (Local>>LM:getfiles:updir ",
			"                                                                  dir",
			"                                                                )",
			"                                                      )",
			"                                            )",
			"                                            ext",
			"                                            rtn",
			"                                          )",
			"                                      rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                                )",
			"                               )",
			"                               ((vl-file-directory-p ",
			"                                  (setq tmp (Local>>LM:getfiles:checkredirect ",
			"                                              (strcat dir \"\\\\\" (car itm))",
			"                                            )",
			"                                  )",
			"                                )",
			"                                (setq lst (Local>>LM:getfiles:updatefilelist ",
			"                                            (set_tile \"dir\" (setq dir tmp))",
			"                                            ext",
			"                                            rtn",
			"                                          )",
			"                                      rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                                )",
			"                               )",
			"                               ((setq rtn (Local>>LM:getfiles:sort ",
			"                                            (append rtn ",
			"                                                    (mapcar ",
			"                                                      '(lambda (x) ",
			"                                                         (strcat dir \"\\\\\" x)",
			"                                                       )",
			"                                                      itm",
			"                                                    )",
			"                                            )",
			"                                          )",
			"                                      rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                                      lst (Local>>LM:getfiles:updatefilelist ",
			"                                            dir",
			"                                            ext",
			"                                            rtn",
			"                                          )",
			"                                )",
			"                               )",
			"                             )",
			"                             (if ",
			"                               (vl-every ",
			"                                 '(lambda (x) ",
			"                                    (vl-file-directory-p (strcat dir \"\\\\\" x))",
			"                                  )",
			"                                 itm",
			"                               )",
			"                               (mode_tile \"add\" 1)",
			"                               (mode_tile \"add\" 0)",
			"                             )",
			"                           )",
			"                         )",
			"                       )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (action_tile \"box2\" ",
			"                   (vl-prin1-to-string ",
			"                     '((lambda (/ itm) ",
			"                         (if ",
			"                           (setq itm (mapcar '(lambda (n) (nth n rtn)) ",
			"                                             (read (strcat \"(\" \\$value \")\"))",
			"                                     )",
			"                           )",
			"                           (if (= 4 \\$reason) ",
			"                             (setq rtn (Local>>LM:getfiles:updateselected ",
			"                                         dir",
			"                                         (vl-remove (car itm) rtn)",
			"                                       )",
			"                                   lst (Local>>LM:getfiles:updatefilelist dir ext rtn)",
			"                             )",
			"                             (mode_tile \"del\" 0)",
			"                           )",
			"                         )",
			"                       )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (action_tile \"add\" ",
			"                   (vl-prin1-to-string ",
			"                     '((lambda (/ itm) ",
			"                         (if ",
			"                           (setq itm (vl-remove-if 'vl-file-directory-p ",
			"                                                   (mapcar '(lambda (n) (nth n lst)) ",
			"                                                           (read ",
			"                                                             (strcat \"(\" ",
			"                                                                     (get_tile \"box1\")",
			"                                                                     \")\"",
			"                                                             )",
			"                                                           )",
			"                                                   )",
			"                                     )",
			"                           )",
			"                           (setq rtn (Local>>LM:getfiles:sort ",
			"                                       (append rtn ",
			"                                               (mapcar ",
			"                                                 '(lambda (x) (strcat dir \"\\\\\" x))",
			"                                                 itm",
			"                                               )",
			"                                       )",
			"                                     )",
			"                                 rtn (Local>>LM:getfiles:updateselected dir rtn)",
			"                                 lst (Local>>LM:getfiles:updatefilelist dir ext rtn)",
			"                           )",
			"                         )",
			"                         (mode_tile \"add\" 1)",
			"                         (mode_tile \"del\" 1)",
			"                       )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (action_tile \"del\" ",
			"                   (vl-prin1-to-string ",
			"                     '((lambda (/ itm) ",
			"                         (if (setq itm (read (strcat \"(\" (get_tile \"box2\") \")\"))) ",
			"                           (setq rtn (Local>>LM:getfiles:updateselected ",
			"                                       dir",
			"                                       (Local>>LM:getfiles:removeitems itm rtn)",
			"                                     )",
			"                                 lst (Local>>LM:getfiles:updatefilelist dir ext rtn)",
			"                           )",
			"                         )",
			"                         (mode_tile \"add\" 1)",
			"                         (mode_tile \"del\" 1)",
			"                       )",
			"                      )",
			"                   )",
			"      )",
			"",
			"      (if (zerop (start_dialog)) ",
			"        (setq rtn nil)",
			"      )",
			"    )",
			"  )",
			"  (*error* nil)",
			"  rtn",
			")"
		],
		"description": "An analog of the 'getfiled' function for multiple file selection.\nmsg - [str/nil] Dialog box label; 'Select Files' if nil or \"\".\ndef - [str/nil] Default directory; dwgprefix if nil or \"\".\next - [str/nil] File extension filter (e.g. \"dwg;lsp\"); \"*\" if nil\nReturns: List of selected files, else nil\nAuthor:  Lee Mac, Copyright © 2012  -  www.lee-mac.com\nRequires: Local>>LM:getfiles:browseforfolder, Local>>LM:getfiles:checkredirect, Local>>LM:getfiles:fixdir, Local>>LM:getfiles:removeitems, Local>>LM:getfiles:sort, Local>>LM:getfiles:str->lst, Local>>LM:getfiles:updatefilelist, Local>>LM:getfiles:updateselected, Local>>LM:getfiles:updir"
	},
	"getfiles:listbox": {
		"prefix": "Local>>LM:getfiles:listbox",
		"body": [
			"",
			"(defun Local>>LM:getfiles:listbox (key lst) ",
			"  (start_list key)",
			"  (foreach x lst (add_list x))",
			"  (end_list)",
			"  lst",
			")"
		],
		"description": ""
	},
	"getfiles:listfiles": {
		"prefix": "Local>>LM:getfiles:listfiles",
		"body": [
			"",
			"(defun Local>>LM:getfiles:listfiles (dir ext lst) ",
			"  (vl-remove-if '(lambda (x) (member (strcat dir \"\\\\\" x) lst)) ",
			"                (cond ",
			"                  ((cdr (assoc dir dirdata)))",
			"                  ((cdar ",
			"                     (setq dirdata (cons ",
			"                                     (cons dir ",
			"                                           (append ",
			"                                             (Local>>LM:getfiles:sortlist ",
			"                                               (vl-remove \".\" ",
			"                                                          (vl-directory-files dir ",
			"                                                                              nil",
			"                                                                              -1",
			"                                                          )",
			"                                               )",
			"                                             )",
			"                                             (Local>>LM:getfiles:sort ",
			"                                               (if (member ext '((\"\") (\"*\"))) ",
			"                                                 (vl-directory-files dir nil 1)",
			"                                                 (vl-remove-if-not ",
			"                                                   (function ",
			"                                                     (lambda (x / e) ",
			"                                                       (and ",
			"                                                         (setq e (vl-filename-extension ",
			"                                                                   x",
			"                                                                 )",
			"                                                         )",
			"                                                         (setq e (strcase ",
			"                                                                   (substr e ",
			"                                                                           2",
			"                                                                   )",
			"                                                                 )",
			"                                                         )",
			"                                                         (vl-some ",
			"                                                           '(lambda (w) ",
			"                                                              (wcmatch e ",
			"                                                                       w",
			"                                                              )",
			"                                                            )",
			"                                                           ext",
			"                                                         )",
			"                                                       )",
			"                                                     )",
			"                                                   )",
			"                                                   (vl-directory-files dir nil 1)",
			"                                                 )",
			"                                               )",
			"                                             )",
			"                                           )",
			"                                     )",
			"                                     dirdata",
			"                                   )",
			"                     )",
			"                   )",
			"                  )",
			"                )",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:getfiles:sort, Local>>LM:getfiles:sortlist"
	},
	"getfiles:checkredirect": {
		"prefix": "Local>>LM:getfiles:checkredirect",
		"body": [
			"",
			"(defun Local>>LM:getfiles:checkredirect (dir / itm pos) ",
			"  (cond ",
			"    ((vl-directory-files dir) dir)",
			"    ((and ",
			"       (= (strcase (getenv \"UserProfile\")) ",
			"          (strcase (substr dir 1 (setq pos (vl-string-position 92 dir nil t))))",
			"       )",
			"       (setq itm (cdr ",
			"                   (assoc (substr (strcase dir t) (+ pos 2)) ",
			"                          '((\"my documents\" . \"Documents\")",
			"                            (\"my pictures\" . \"Pictures\")",
			"                            (\"my videos\" . \"Videos\")",
			"                            (\"my music\" . \"Music\")",
			"                           )",
			"                   )",
			"                 )",
			"       )",
			"       (vl-file-directory-p (setq itm (strcat (substr dir 1 pos) \"\\\\\" itm)))",
			"     )",
			"     itm",
			"    )",
			"    (dir)",
			"  )",
			")"
		],
		"description": ""
	},
	"getfiles:sort": {
		"prefix": "Local>>LM:getfiles:sort",
		"body": [
			"",
			"(defun Local>>LM:getfiles:sort (lst) ",
			"  (apply 'append ",
			"         (mapcar 'Local>>LM:getfiles:sortlist ",
			"                 (vl-sort ",
			"                   (Local>>LM:getfiles:groupbyfunction ",
			"                     lst",
			"                     (lambda (a b / x y) ",
			"                       (and ",
			"                         (setq x (vl-filename-extension a))",
			"                         (setq y (vl-filename-extension b))",
			"                         (= (strcase x) (strcase y))",
			"                       )",
			"                     )",
			"                   )",
			"                   (function ",
			"                     (lambda (a b / x y) ",
			"                       (and ",
			"                         (setq x (vl-filename-extension (car a)))",
			"                         (setq y (vl-filename-extension (car b)))",
			"                         (< (strcase x) (strcase y))",
			"                       )",
			"                     )",
			"                   )",
			"                 )",
			"         )",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:getfiles:groupbyfunction, Local>>LM:getfiles:sortlist"
	},
	"getfiles:sortlist": {
		"prefix": "Local>>LM:getfiles:sortlist",
		"body": [
			"",
			"(defun Local>>LM:getfiles:sortlist (lst) ",
			"  (mapcar (function (lambda (n) (nth n lst))) ",
			"          (vl-sort-i (mapcar 'Local>>LM:getfiles:splitstring lst) ",
			"                     (function ",
			"                       (lambda (a b / x y) ",
			"                         (while ",
			"                           (and ",
			"                             (setq x (car a))",
			"                             (setq y (car b))",
			"                             (= x y)",
			"                           )",
			"                           (setq a (cdr a)",
			"                                 b (cdr b)",
			"                           )",
			"                         )",
			"                         (cond ",
			"                           ((null x) b)",
			"                           ((null y) nil)",
			"                           ((and (numberp x) (numberp y)) (< x y))",
			"                           ((numberp x))",
			"                           ((numberp y) nil)",
			"                           ((< x y))",
			"                         )",
			"                       )",
			"                     )",
			"          )",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:getfiles:splitstring"
	},
	"getfiles:groupbyfunction": {
		"prefix": "Local>>LM:getfiles:groupbyfunction",
		"body": [
			"",
			"(defun Local>>LM:getfiles:groupbyfunction (lst fun / tmp1 tmp2 x1) ",
			"  (if (setq x1 (car lst)) ",
			"    (progn ",
			"      (foreach x2 (cdr lst) ",
			"        (if (fun x1 x2) ",
			"          (setq tmp1 (cons x2 tmp1))",
			"          (setq tmp2 (cons x2 tmp2))",
			"        )",
			"      )",
			"      (cons (cons x1 (reverse tmp1)) (Local>>LM:getfiles:groupbyfunction (reverse tmp2) fun))",
			"    )",
			"  )",
			")"
		],
		"description": ""
	},
	"getfiles:splitstring": {
		"prefix": "Local>>LM:getfiles:splitstring",
		"body": [
			"",
			"(defun Local>>LM:getfiles:splitstring (str) ",
			"  ((lambda (l) ",
			"     (read ",
			"       (strcat \"(\" ",
			"               (vl-list->string ",
			"                 (apply 'append ",
			"                        (mapcar ",
			"                          (function ",
			"                            (lambda (a b c) ",
			"                              (cond ",
			"                                ((member b '(45 46 92))",
			"                                 (list 32)",
			"                                )",
			"                                ((< 47 b 58)",
			"                                 (list b)",
			"                                )",
			"                                ((list 32 34 b 34 32))",
			"                              )",
			"                            )",
			"                          )",
			"                          (cons nil l)",
			"                          l",
			"                          (append (cdr l) '(()))",
			"                        )",
			"                 )",
			"               )",
			"               \")\"",
			"       )",
			"     )",
			"   ) ",
			"    (vl-string->list (strcase str))",
			"  )",
			")"
		],
		"description": ""
	},
	"getfiles:browseforfolder": {
		"prefix": "Local>>LM:getfiles:browseforfolder",
		"body": [
			"",
			"(defun Local>>LM:getfiles:browseforfolder (msg dir flg / err fld pth shl slf) ",
			"  (setq err (vl-catch-all-apply ",
			"              (function ",
			"                (lambda (/ app hwd) ",
			"                  (if ",
			"                    (setq app (vlax-get-acad-object)",
			"                          shl (vla-getinterfaceobject app \"shell.application\")",
			"                          hwd (vl-catch-all-apply 'vla-get-hwnd (list app))",
			"                          fld (vlax-invoke-method shl ",
			"                                                  'browseforfolder",
			"                                                  (if (vl-catch-all-error-p hwd) 0 hwd)",
			"                                                  msg",
			"                                                  flg",
			"                                                  dir",
			"                              )",
			"                    )",
			"                    (setq slf (vlax-get-property fld 'self)",
			"                          pth (Local>>LM:getfiles:fixdir (vlax-get-property slf 'path))",
			"                    )",
			"                  )",
			"                )",
			"              )",
			"            )",
			"  )",
			"  (if slf (vlax-release-object slf))",
			"  (if fld (vlax-release-object fld))",
			"  (if shl (vlax-release-object shl))",
			"  (if (vl-catch-all-error-p err) ",
			"    (prompt (vl-catch-all-error-message err))",
			"    pth",
			"  )",
			")"
		],
		"description": "\nRequires: Local>>LM:getfiles:fixdir"
	},
	"getfiles:full->relative": {
		"prefix": "Local>>LM:getfiles:full->relative",
		"body": [
			"",
			"(defun Local>>LM:getfiles:full->relative (dir path / p q) ",
			"  (setq dir (vl-string-right-trim \"\\\\\" dir))",
			"  (cond ",
			"    ((and ",
			"       (setq p (vl-string-position 58 dir))",
			"       (setq q (vl-string-position 58 path))",
			"       (/= (strcase (substr dir 1 p)) (strcase (substr path 1 q)))",
			"     )",
			"     path",
			"    )",
			"    ((and ",
			"       (setq p (vl-string-position 92 dir))",
			"       (setq q (vl-string-position 92 path))",
			"       (= (strcase (substr dir 1 p)) (strcase (substr path 1 q)))",
			"     )",
			"     (Local>>LM:getfiles:full->relative (substr dir (+ 2 p)) (substr path (+ 2 q)))",
			"    )",
			"    ((and ",
			"       (setq q (vl-string-position 92 path))",
			"       (= (strcase dir) (strcase (substr path 1 q)))",
			"     )",
			"     (strcat \".\\\\\" (substr path (+ 2 q)))",
			"    )",
			"    ((= \"\" dir)",
			"     path",
			"    )",
			"    ((setq p (vl-string-position 92 dir))",
			"     (Local>>LM:getfiles:full->relative (substr dir (+ 2 p)) (strcat \"..\\\\\" path))",
			"    )",
			"    ((Local>>LM:getfiles:full->relative \"\" (strcat \"..\\\\\" path)))",
			"  )",
			")"
		],
		"description": ""
	},
	"getfiles:str->lst": {
		"prefix": "Local>>LM:getfiles:str->lst",
		"body": [
			"",
			"(defun Local>>LM:getfiles:str->lst (str del / pos) ",
			"  (if (setq pos (vl-string-search del str)) ",
			"    (cons (substr str 1 pos) (Local>>LM:getfiles:str->lst (substr str (+ pos 1 (strlen del))) del))",
			"    (list str)",
			"  )",
			")"
		],
		"description": ""
	},
	"getfiles:updatefilelist": {
