			"(defun Local>>LM:grsnap:snapmode (str) ",
			"  (vl-some ",
			"    (function ",
			"      (lambda (x) ",
			"        (if (wcmatch (car x) (strcat (strcase str t) \"*\")) ",
			"          (progn ",
			"            (princ (cadr x))",
			"            (caddr x)",
			"          )",
			"        )",
			"      )",
			"    )",
